0E655                           DrawFloateyNumber_Coin:
0E655 A5 09                               lda FrameCounter          ;get frame counter
0E657 4A                                  lsr                       ;divide by 2
0E658 B0 02                               bcs NotRsNum              ;branch if d0 not set to raise number every other frame
0E65A D6 DB                               dec Misc_Y_Position,x     ;otherwise, decrement vertical coordinate
0E65C B5 DB                     NotRsNum: lda Misc_Y_Position,x     ;get vertical coordinate
0E65E 20 C1 E5                            jsr DumpTwoSpr            ;dump into both sprites
0E661 AD B3 03                            lda Misc_Rel_XPos         ;get relative horizontal coordinate
0E664 99 03 02                            sta Sprite_X_Position,y   ;store as X coordinate for first sprite
0E667 18                                  clc
0E668 69 08                               adc #$08                  ;add eight pixels
0E66A 99 07 02                            sta Sprite_X_Position+4,y ;store as X coordinate for second sprite
0E66D A9 02                               lda #$02
0E66F 99 02 02                            sta Sprite_Attributes,y   ;store attribute byte in both sprites
0E672 99 06 02                            sta Sprite_Attributes+4,y
0E675 A9 F7                               lda #$f7
0E677 99 01 02                            sta Sprite_Tilenumber,y   ;put tile numbers into both sprites
0E67A A9 FB                               lda #$fb                  ;that resemble "200"
0E67C 99 05 02                            sta Sprite_Tilenumber+4,y
0E67F 4C BD E6                            jmp ExJCGfx               ;then jump to leave (why not an rts here instead?)
