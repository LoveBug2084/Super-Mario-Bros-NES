0BAE6 A9 00                               lda #$00                   ;set A to impose gravity on hammer
0BAE8 20 D7 BF                            jsr ImposeGravity          ;do sub to impose gravity on hammer and move vertically
0BAEB 20 0F BF                            jsr MoveObjectHorizontally ;do sub to move it horizontally
0BAEE A6 08                               ldx ObjectOffset           ;get original misc object offset
0BAF0 4C 28 BB                            jmp RunAllH                ;branch to essential subroutines
0BAF3 A9 FE                     SetHSpd:  lda #$fe
