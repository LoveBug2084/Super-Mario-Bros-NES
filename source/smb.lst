093C5 47 47 47 47 00 00            .db $47, $47, $47, $47, $00, $00
093CB                           
093CB 00 00 00 00 00 00 00         .db $00, $00, $00, $00, $00, $00, $00   ;over water
093D2 00 00 00 00 86 87            .db $00, $00, $00, $00, $86, $87
093D8                           
093D8                           TerrainMetatiles:
093D8 69 54 52 62                     .db $69, $54, $52, $62
093DC                           
093DC                           TerrainRenderBits:
093DC 00 00                           .db %00000000, %00000000 ;no ceiling or floor
093DE 00 18                           .db %00000000, %00011000 ;no ceiling, floor 2
093E0 01 18                           .db %00000001, %00011000 ;ceiling 1, floor 2
093E2 07 18                           .db %00000111, %00011000 ;ceiling 3, floor 2
093E4 0F 18                           .db %00001111, %00011000 ;ceiling 4, floor 2
093E6 FF 18                           .db %11111111, %00011000 ;ceiling 8, floor 2
093E8 01 1F                           .db %00000001, %00011111 ;ceiling 1, floor 5
093EA 07 1F                           .db %00000111, %00011111 ;ceiling 3, floor 5
093EC 0F 1F                           .db %00001111, %00011111 ;ceiling 4, floor 5
093EE 81 1F                           .db %10000001, %00011111 ;ceiling 1, floor 6
093F0 01 00                           .db %00000001, %00000000 ;ceiling 1, no floor
093F2 8F 1F                           .db %10001111, %00011111 ;ceiling 4, floor 6
093F4 F1 1F                           .db %11110001, %00011111 ;ceiling 1, floor 9
093F6 F9 18                           .db %11111001, %00011000 ;ceiling 1, middle 5, floor 2
093F8 F1 18                           .db %11110001, %00011000 ;ceiling 1, middle 4, floor 2
093FA FF 1F                           .db %11111111, %00011111 ;completely solid top to bottom
093FC                           
093FC                           AreaParserCore:
093FC AD 28 07                        lda BackloadingFlag       ;check to see if we are starting right of start
093FF F0 03                           beq RenderSceneryTerrain  ;if not, go ahead and render background, foreground and terrain
09401 20 08 95                        jsr ProcessAreaData       ;otherwise skip ahead and load level data
09404                           
09404                           RenderSceneryTerrain:
09404 A2 0C                               ldx #$0c
09406 A9 00                               lda #$00
09408 9D A1 06                  ClrMTBuf: sta MetatileBuffer,x       ;clear out metatile buffer
0940B CA                                  dex
0940C 10 FA                               bpl ClrMTBuf
0940E AC 42 07                            ldy BackgroundScenery      ;do we need to render the background scenery?
09411 F0 42                               beq RendFore               ;if not, skip to check the foreground
09413 AD 25 07                            lda CurrentPageLoc         ;otherwise check for every third page
09416 C9 03                     ThirdP:   cmp #$03
09418 30 05                               bmi RendBack               ;if less than three we're there
0941A 38                                  sec
0941B E9 03                               sbc #$03                   ;if 3 or more, subtract 3 and 
0941D 10 F7                               bpl ThirdP                 ;do an unconditional branch
0941F 0A                        RendBack: asl                        ;move results to higher nybble
09420 0A                                  asl
09421 0A                                  asl
09422 0A                                  asl
09423 79 F6 92                            adc BSceneDataOffsets-1,y  ;add to it offset loaded from here
09426 6D 26 07                            adc CurrentColumnPos       ;add to the result our current column position
09429 AA                                  tax
0942A BD FA 92                            lda BackSceneryData,x      ;load data from sum of offsets
0942D F0 26                               beq RendFore               ;if zero, no scenery for that part
0942F 48                                  pha
09430 29 0F                               and #$0f                   ;save to stack and clear high nybble
09432 38                                  sec
09433 E9 01                               sbc #$01                   ;subtract one (because low nybble is $01-$0c)
09435 85 00                               sta $00                    ;save low nybble
09437 0A                                  asl                        ;multiply by three (shift to left and add result to old one)
09438 65 00                               adc $00                    ;note that since d7 was nulled, the carry flag is always clear
0943A AA                                  tax                        ;save as offset for background scenery metatile data
0943B 68                                  pla                        ;get high nybble from stack, move low
0943C 4A                                  lsr
0943D 4A                                  lsr
0943E 4A                                  lsr
0943F 4A                                  lsr
09440 A8                                  tay                        ;use as second offset (used to determine height)
09441 A9 03                               lda #$03                   ;use previously saved memory location for counter
09443 85 00                               sta $00
09445 BD 8A 93                  SceLoop1: lda BackSceneryMetatiles,x ;load metatile data from offset of (lsb - 1) * 3
09448 99 A1 06                            sta MetatileBuffer,y       ;store into buffer from offset of (msb / 16)
0944B E8                                  inx
0944C C8                                  iny
0944D C0 0B                               cpy #$0b                   ;if at this location, leave loop
0944F F0 04                               beq RendFore
09451 C6 00                               dec $00                    ;decrement until counter expires, barring exception
09453 D0 F0                               bne SceLoop1
09455 AE 41 07                  RendFore: ldx ForegroundScenery      ;check for foreground data needed or not
09458 F0 13                               beq RendTerr               ;if not, skip this part
0945A BC AD 93                            ldy FSceneDataOffsets-1,x  ;load offset from location offset by header value, then
0945D A2 00                               ldx #$00                   ;reinit X
0945F B9 B1 93                  SceLoop2: lda ForeSceneryData,y      ;load data until counter expires
09462 F0 03                               beq NoFore                 ;do not store if zero found
09464 9D A1 06                            sta MetatileBuffer,x
09467 C8                        NoFore:   iny
09468 E8                                  inx
09469 E0 0D                               cpx #$0d                   ;store up to end of metatile buffer
0946B D0 F2                               bne SceLoop2
0946D AC 4E 07                  RendTerr: ldy AreaType               ;check world type for water level
09470 D0 0C                               bne TerMTile               ;if not water level, skip this part
09472 AD 5F 07                            lda WorldNumber            ;check world number, if not world number eight
09475 C9 07                               cmp #World8                ;then skip this part
09477 D0 05                               bne TerMTile
09479 A9 62                               lda #$62                   ;if set as water level and world number eight,
0947B 4C 88 94                            jmp StoreMT                ;use castle wall metatile as terrain type
0947E B9 D8 93                  TerMTile: lda TerrainMetatiles,y     ;otherwise get appropriate metatile for area type
09481 AC 43 07                            ldy CloudTypeOverride      ;check for cloud type override
09484 F0 02                               beq StoreMT                ;if not set, keep value otherwise
09486 A9 88                               lda #$88                   ;use cloud block terrain
09488 85 07                     StoreMT:  sta $07                    ;store value here
0948A A2 00                               ldx #$00                   ;initialize X, use as metatile buffer offset
0948C AD 27 07                            lda TerrainControl         ;use yet another value from the header
0948F 0A                                  asl                        ;multiply by 2 and use as yet another offset
09490 A8                                  tay
09491 B9 DC 93                  TerrLoop: lda TerrainRenderBits,y    ;get one of the terrain rendering bit data
09494 85 00                               sta $00
09496 C8                                  iny                        ;increment Y and use as offset next time around
09497 84 01                               sty $01
09499 AD 43 07                            lda CloudTypeOverride      ;skip if value here is zero
0949C F0 0A                               beq NoCloud2
0949E E0 00                               cpx #$00                   ;otherwise, check if we're doing the ceiling byte
094A0 F0 06                               beq NoCloud2
094A2 A5 00                               lda $00                    ;if not, mask out all but d3
094A4 29 08                               and #%00001000
094A6 85 00                               sta $00
094A8 A0 00                     NoCloud2: ldy #$00                   ;start at beginning of bitmasks
094AA B9 8A C6                  TerrBChk: lda Bitmasks,y             ;load bitmask, then perform AND on contents of first byte
094AD 24 00                               bit $00
094AF F0 05                               beq NextTBit               ;if not set, skip this part (do not write terrain to buffer)
094B1 A5 07                               lda $07
094B3 9D A1 06                            sta MetatileBuffer,x       ;load terrain type metatile number and store into buffer here
094B6 E8                        NextTBit: inx                        ;continue until end of buffer
094B7 E0 0D                               cpx #$0d
094B9 F0 18                               beq RendBBuf               ;if we're at the end, break out of this loop
094BB AD 4E 07                            lda AreaType               ;check world type for underground area
094BE C9 02                               cmp #$02
094C0 D0 08                               bne EndUChk                ;if not underground, skip this part
094C2 E0 0B                               cpx #$0b
094C4 D0 04                               bne EndUChk                ;if we're at the bottom of the screen, override
094C6 A9 54                               lda #$54                   ;old terrain type with ground level terrain type
094C8 85 07                               sta $07
094CA C8                        EndUChk:  iny                        ;increment bitmasks offset in Y
094CB C0 08                               cpy #$08
094CD D0 DB                               bne TerrBChk               ;if not all bits checked, loop back    
094CF A4 01                               ldy $01
094D1 D0 BE                               bne TerrLoop               ;unconditional branch, use Y to load next byte
094D3 20 08 95                  RendBBuf: jsr ProcessAreaData        ;do the area data loading routine now
094D6 AD A0 06                            lda BlockBufferColumnPos
094D9 20 E1 9B                            jsr GetBlockBufferAddr     ;get block buffer address from where we're at
094DC A2 00                               ldx #$00
094DE A0 00                               ldy #$00                   ;init index regs and start at beginning of smaller buffer
094E0 84 00                     ChkMTLow: sty $00
094E2 BD A1 06                            lda MetatileBuffer,x       ;load stored metatile number
094E5 29 C0                               and #%11000000             ;mask out all but 2 MSB
094E7 0A                                  asl
094E8 2A                                  rol                        ;make %xx000000 into %000000xx
094E9 2A                                  rol
094EA A8                                  tay                        ;use as offset in Y
094EB BD A1 06                            lda MetatileBuffer,x       ;reload original unmasked value here
094EE D9 04 95                            cmp BlockBuffLowBounds,y   ;check for certain values depending on bits set
094F1 B0 02                               bcs StrBlock               ;if equal or greater, branch
094F3 A9 00                               lda #$00                   ;if less, init value before storing
094F5 A4 00                     StrBlock: ldy $00                    ;get offset for block buffer
094F7 91 06                               sta ($06),y                ;store value into block buffer
094F9 98                                  tya
094FA 18                                  clc                        ;add 16 (move down one row) to offset
094FB 69 10                               adc #$10
094FD A8                                  tay
094FE E8                                  inx                        ;increment column value
094FF E0 0D                               cpx #$0d
09501 90 DD                               bcc ChkMTLow               ;continue until we pass last row, then leave
09503 60                                  rts
09504                           
09504                           ;numbers lower than these with the same attribute bits
09504                           ;will not be stored in the block buffer
09504                           BlockBuffLowBounds:
09504 10 51 88 C0                     .db $10, $51, $88, $c0
09508                           
09508                           ;-------------------------------------------------------------------------------------
09508                           ;$00 - used to store area object identifier
09508                           ;$07 - used as adder to find proper area object code
09508                           
09508                           ProcessAreaData:
09508 A2 02                                 ldx #$02                 ;start at the end of area object buffer
0950A 86 08                     ProcADLoop: stx ObjectOffset
0950C A9 00                                 lda #$00                 ;reset flag
0950E 8D 29 07                              sta BehindAreaParserFlag
09511 AC 2C 07                              ldy AreaDataOffset       ;get offset of area data pointer
09514 B1 E7                                 lda (AreaData),y         ;get first byte of area object
09516 C9 FD                                 cmp #$fd                 ;if end-of-area, skip all this crap
09518 F0 4B                                 beq RdyDecode
0951A BD 30 07                              lda AreaObjectLength,x   ;check area object buffer flag
0951D 10 46                                 bpl RdyDecode            ;if buffer not negative, branch, otherwise
0951F C8                                    iny
09520 B1 E7                                 lda (AreaData),y         ;get second byte of area object
09522 0A                                    asl                      ;check for page select bit (d7), branch if not set
09523 90 0B                                 bcc Chk1Row13
09525 AD 2B 07                              lda AreaObjectPageSel    ;check page select
09528 D0 06                                 bne Chk1Row13
0952A EE 2B 07                              inc AreaObjectPageSel    ;if not already set, set it now
0952D EE 2A 07                              inc AreaObjectPageLoc    ;and increment page location
09530 88                        Chk1Row13:  dey
09531 B1 E7                                 lda (AreaData),y         ;reread first byte of level object
09533 29 0F                                 and #$0f                 ;mask out high nybble
09535 C9 0D                                 cmp #$0d                 ;row 13?
09537 D0 1B                                 bne Chk1Row14
09539 C8                                    iny                      ;if so, reread second byte of level object
0953A B1 E7                                 lda (AreaData),y
0953C 88                                    dey                      ;decrement to get ready to read first byte
0953D 29 40                                 and #%01000000           ;check for d6 set (if not, object is page control)
0953F D0 1C                                 bne CheckRear
09541 AD 2B 07                              lda AreaObjectPageSel    ;if page select is set, do not reread
09544 D0 17                                 bne CheckRear
09546 C8                                    iny                      ;if d6 not set, reread second byte
09547 B1 E7                                 lda (AreaData),y
09549 29 1F                                 and #%00011111           ;mask out all but 5 LSB and store in page control
0954B 8D 2A 07                              sta AreaObjectPageLoc
0954E EE 2B 07                              inc AreaObjectPageSel    ;increment page select
09551 4C 6E 95                              jmp NextAObj
09554 C9 0E                     Chk1Row14:  cmp #$0e                 ;row 14?
09556 D0 05                                 bne CheckRear
09558 AD 28 07                              lda BackloadingFlag      ;check flag for saved page number and branch if set
0955B D0 08                                 bne RdyDecode            ;to render the object (otherwise bg might not look right)
0955D AD 2A 07                  CheckRear:  lda AreaObjectPageLoc    ;check to see if current page of level object is
09560 CD 25 07                              cmp CurrentPageLoc       ;behind current page of renderer
09563 90 06                                 bcc SetBehind            ;if so branch
09565 20 95 95                  RdyDecode:  jsr DecodeAreaData       ;do sub and do not turn on flag
09568 4C 71 95                              jmp ChkLength
0956B EE 29 07                  SetBehind:  inc BehindAreaParserFlag ;turn on flag if object is behind renderer
0956E 20 89 95                  NextAObj:   jsr IncAreaObjOffset     ;increment buffer offset and move on
09571 A6 08                     ChkLength:  ldx ObjectOffset         ;get buffer offset
09573 BD 30 07                              lda AreaObjectLength,x   ;check object length for anything stored here
09576 30 03                                 bmi ProcLoopb            ;if not, branch to handle loopback
09578 DE 30 07                              dec AreaObjectLength,x   ;otherwise decrement length or get rid of it
0957B CA                        ProcLoopb:  dex                      ;decrement buffer offset
0957C 10 8C                                 bpl ProcADLoop           ;and loopback unless exceeded buffer
0957E AD 29 07                              lda BehindAreaParserFlag ;check for flag set if objects were behind renderer
09581 D0 85                                 bne ProcessAreaData      ;branch if true to load more level data, otherwise
09583 AD 28 07                              lda BackloadingFlag      ;check for flag set if starting right of page $00
09586 D0 80                                 bne ProcessAreaData      ;branch if true to load more level data, otherwise leave
09588 60                        EndAParse:  rts
09589                           
09589                           IncAreaObjOffset:
09589 EE 2C 07                        inc AreaDataOffset    ;increment offset of level pointer
0958C EE 2C 07                        inc AreaDataOffset
0958F A9 00                           lda #$00              ;reset page select
09591 8D 2B 07                        sta AreaObjectPageSel
09594 60                              rts
09595                           
09595                           DecodeAreaData:
09595 BD 30 07                            lda AreaObjectLength,x     ;check current buffer flag
09598 30 03                               bmi Chk1stB
0959A BC 2D 07                            ldy AreaObjOffsetBuffer,x  ;if not, get offset from buffer
0959D A2 10                     Chk1stB:  ldx #$10                   ;load offset of 16 for special row 15
0959F B1 E7                               lda (AreaData),y           ;get first byte of level object again
095A1 C9 FD                               cmp #$fd
095A3 F0 E3                               beq EndAParse              ;if end of level, leave this routine
095A5 29 0F                               and #$0f                   ;otherwise, mask out low nybble
095A7 C9 0F                               cmp #$0f                   ;row 15?
095A9 F0 08                               beq ChkRow14               ;if so, keep the offset of 16
095AB A2 08                               ldx #$08                   ;otherwise load offset of 8 for special row 12
095AD C9 0C                               cmp #$0c                   ;row 12?
095AF F0 02                               beq ChkRow14               ;if so, keep the offset value of 8
095B1 A2 00                               ldx #$00                   ;otherwise nullify value by default
095B3 86 07                     ChkRow14: stx $07                    ;store whatever value we just loaded here
095B5 A6 08                               ldx ObjectOffset           ;get object offset again
095B7 C9 0E                               cmp #$0e                   ;row 14?
095B9 D0 08                               bne ChkRow13
095BB A9 00                               lda #$00                   ;if so, load offset with $00
095BD 85 07                               sta $07
095BF A9 2E                               lda #$2e                   ;and load A with another value
095C1 D0 53                               bne NormObj                ;unconditional branch
095C3 C9 0D                     ChkRow13: cmp #$0d                   ;row 13?
095C5 D0 1B                               bne ChkSRows
095C7 A9 22                               lda #$22                   ;if so, load offset with 34
095C9 85 07                               sta $07
095CB C8                                  iny                        ;get next byte
095CC B1 E7                               lda (AreaData),y
095CE 29 40                               and #%01000000             ;mask out all but d6 (page control obj bit)
095D0 F0 63                               beq LeavePar               ;if d6 clear, branch to leave (we handled this earlier)
095D2 B1 E7                               lda (AreaData),y           ;otherwise, get byte again
095D4 29 7F                               and #%01111111             ;mask out d7
095D6 C9 4B                               cmp #$4b                   ;check for loop command in low nybble
095D8 D0 03                               bne Mask2MSB               ;(plus d6 set for object other than page control)
095DA EE 45 07                            inc LoopCommand            ;if loop command, set loop command flag
095DD 29 3F                     Mask2MSB: and #%00111111             ;mask out d7 and d6
095DF 4C 16 96                            jmp NormObj                ;and jump
095E2 C9 0C                     ChkSRows: cmp #$0c                   ;row 12-15?
095E4 B0 27                               bcs SpecObj
095E6 C8                                  iny                        ;if not, get second byte of level object
095E7 B1 E7                               lda (AreaData),y
095E9 29 70                               and #%01110000             ;mask out all but d6-d4
095EB D0 0B                               bne LrgObj                 ;if any bits set, branch to handle large object
095ED A9 16                               lda #$16
095EF 85 07                               sta $07                    ;otherwise set offset of 24 for small object
095F1 B1 E7                               lda (AreaData),y           ;reload second byte of level object
095F3 29 0F                               and #%00001111             ;mask out higher nybble and jump
095F5 4C 16 96                            jmp NormObj
095F8 85 00                     LrgObj:   sta $00                    ;store value here (branch for large objects)
095FA C9 70                               cmp #$70                   ;check for vertical pipe object
095FC D0 0A                               bne NotWPipe
095FE B1 E7                               lda (AreaData),y           ;if not, reload second byte
09600 29 08                               and #%00001000             ;mask out all but d3 (usage control bit)
09602 F0 04                               beq NotWPipe               ;if d3 clear, branch to get original value
09604 A9 00                               lda #$00                   ;otherwise, nullify value for warp pipe
09606 85 00                               sta $00
09608 A5 00                     NotWPipe: lda $00                    ;get value and jump ahead
0960A 4C 12 96                            jmp MoveAOId
0960D C8                        SpecObj:  iny                        ;branch here for rows 12-15
0960E B1 E7                               lda (AreaData),y
09610 29 70                               and #%01110000             ;get next byte and mask out all but d6-d4
09612 4A                        MoveAOId: lsr                        ;move d6-d4 to lower nybble
09613 4A                                  lsr
09614 4A                                  lsr
09615 4A                                  lsr
09616 85 00                     NormObj:  sta $00                    ;store value here (branch for small objects and rows 13 and 14)
09618 BD 30 07                            lda AreaObjectLength,x     ;is there something stored here already?
0961B 10 42                               bpl RunAObj                ;if so, branch to do its particular sub
0961D AD 2A 07                            lda AreaObjectPageLoc      ;otherwise check to see if the object we've loaded is on the
09620 CD 25 07                            cmp CurrentPageLoc         ;same page as the renderer, and if so, branch
09623 F0 11                               beq InitRear
09625 AC 2C 07                            ldy AreaDataOffset         ;if not, get old offset of level pointer
09628 B1 E7                               lda (AreaData),y           ;and reload first byte
0962A 29 0F                               and #%00001111
0962C C9 0E                               cmp #$0e                   ;row 14?
0962E D0 05                               bne LeavePar
09630 AD 28 07                            lda BackloadingFlag        ;if so, check backloading flag
09633 D0 21                               bne StrAObj                ;if set, branch to render object, else leave
09635 60                        LeavePar: rts
09636 AD 28 07                  InitRear: lda BackloadingFlag        ;check backloading flag to see if it's been initialized
09639 F0 0B                               beq BackColC               ;branch to column-wise check
0963B A9 00                               lda #$00                   ;if not, initialize both backloading and 
0963D 8D 28 07                            sta BackloadingFlag        ;behind-renderer flags and leave
09640 8D 29 07                            sta BehindAreaParserFlag
09643 85 08                               sta ObjectOffset
09645 60                        LoopCmdE: rts
09646 AC 2C 07                  BackColC: ldy AreaDataOffset         ;get first byte again
09649 B1 E7                               lda (AreaData),y
0964B 29 F0                               and #%11110000             ;mask out low nybble and move high to low
0964D 4A                                  lsr
0964E 4A                                  lsr
0964F 4A                                  lsr
09650 4A                                  lsr
09651 CD 26 07                            cmp CurrentColumnPos       ;is this where we're at?
09654 D0 DF                               bne LeavePar               ;if not, branch to leave
09656 AD 2C 07                  StrAObj:  lda AreaDataOffset         ;if so, load area obj offset and store in buffer
09659 9D 2D 07                            sta AreaObjOffsetBuffer,x
0965C 20 89 95                            jsr IncAreaObjOffset       ;do sub to increment to next object data
0965F A5 00                     RunAObj:  lda $00                    ;get stored value and add offset to it
09661 18                                  clc                        ;then use the jump engine with current contents of A
09662 65 07                               adc $07
09664 20 04 8E                            jsr JumpEngine
