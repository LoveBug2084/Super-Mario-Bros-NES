0C4C3 C8                                 iny                        ;otherwise, increment Y to allow as many as four onscreen
0C4C4 84 00                     MaxCC:   sty $00                    ;store whatever pseudorandom bits are in Y
0C4C6 E4 00                              cpx $00                    ;compare enemy object buffer offset with Y
0C4C8 B0 84                              bcs ChpChpEx               ;if X => Y, branch to leave
0C4CA BD A7 07                           lda PseudoRandomBitReg,x
0C4CD 29 03                              and #%00000011             ;get last two bits of LSFR, first part
0C4CF 85 00                              sta $00                    ;and store in two places
0C4D1 85 01                              sta $01
