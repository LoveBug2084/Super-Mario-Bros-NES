0E5EE 99 10 02                        sta Sprite_Y_Position+16,y  ;store vertical coordinate or offscreen
0E5F1 99 14 02                        sta Sprite_Y_Position+20,y  ;coordinate into last two sprites as Y coordinate
0E5F4 A9 5B                           lda #$5b                    ;load default tile for platform (girder)
0E5F6 AE 43 07                        ldx CloudTypeOverride
0E5F9 F0 02                           beq SetPlatformTilenum      ;if cloud level override flag not set, use
0E5FB A9 75                           lda #$75                    ;otherwise load other tile for platform (puff)
0E5FD                           
0E5FD                           SetPlatformTilenum:
0E5FD A6 08                             ldx ObjectOffset            ;get enemy object buffer offset
0E5FF C8                                iny                         ;increment Y for tile offset
0E600 20 B5 E5                          jsr DumpSixSpr              ;dump tile number into all six sprites
0E603 A9 02                             lda #$02                    ;set palette controls
0E605 C8                                iny                         ;increment Y for sprite attributes
0E606 20 B5 E5                          jsr DumpSixSpr              ;dump attributes into all six sprites
0E609 E8                                inx                         ;increment X for enemy objects
0E60A 20 F6 F1                          jsr GetXOffscreenBits       ;get offscreen bits again
0E60D CA                                dex
0E60E BC E5 06                          ldy Enemy_SprDataOffset,x   ;get OAM data offset
0E611 0A                                asl                         ;rotate d7 into carry, save remaining
0E612 48                                pha                         ;bits to the stack
0E613 90 05                             bcc SChk2
