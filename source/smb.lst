08752                           
08752                           GameText:
08752                           TopStatusBarLine:
08752 20 43 05 16 0A 1B 12 18     .db $20, $43, $05, $16, $0a, $1b, $12, $18 ; "MARIO"
0875A 20 52 0B 20 18 1B 15 0D     .db $20, $52, $0b, $20, $18, $1b, $15, $0d ; "WORLD  TIME"
08762 24 24 1D 12 16 0E           .db $24, $24, $1d, $12, $16, $0e
08768 20 68 05 00 24 24 2E 29     .db $20, $68, $05, $00, $24, $24, $2e, $29 ; score trailing digit and coin display
08770 23 C0 7F AA                 .db $23, $c0, $7f, $aa ; attribute table data, clears name table 0 to palette 2
08774 23 C2 01 EA                 .db $23, $c2, $01, $ea ; attribute table data, used for coin icon in status bar
08778 FF                          .db $ff ; end of data block
08779                           
08779                           WorldLivesDisplay:
08779 21 CD 07 24 24              .db $21, $cd, $07, $24, $24 ; cross with spaces used on
0877E 29 24 24 24 24              .db $29, $24, $24, $24, $24 ; lives display
08783 21 4B 09 20 18              .db $21, $4b, $09, $20, $18 ; "WORLD  - " used on lives display
08788 1B 15 0D 24 24 28 24        .db $1b, $15, $0d, $24, $24, $28, $24
0878F 22 0C 47 24                 .db $22, $0c, $47, $24 ; possibly used to clear time up
08793 23 DC 01 BA                 .db $23, $dc, $01, $ba ; attribute table data for crown if more than 9 lives
08797 FF                          .db $ff
08798                           
08798                           TwoPlayerTimeUp:
08798 21 CD 05 16 0A 1B 12 18     .db $21, $cd, $05, $16, $0a, $1b, $12, $18 ; "MARIO"
087A0                           OnePlayerTimeUp:
087A0 22 0C 07 1D 12 16 0E 24..   .db $22, $0c, $07, $1d, $12, $16, $0e, $24, $1e, $19 ; "TIME UP"
087AA FF                          .db $ff
087AB                           
087AB                           TwoPlayerGameOver:
087AB 21 CD 05 16 0A 1B 12 18     .db $21, $cd, $05, $16, $0a, $1b, $12, $18 ; "MARIO"
087B3                           OnePlayerGameOver:
087B3 22 0B 09 10 0A 16 0E 24     .db $22, $0b, $09, $10, $0a, $16, $0e, $24 ; "GAME OVER"
087BB 18 1F 0E 1B                 .db $18, $1f, $0e, $1b
087BF FF                          .db $ff
087C0                           
087C0                           WarpZoneWelcome:
087C0 25 84 15 20 0E 15 0C 18..   .db $25, $84, $15, $20, $0e, $15, $0c, $18, $16 ; "WELCOME TO WARP ZONE!"
087C9 0E 24 1D 18 24 20 0A 1B..   .db $0e, $24, $1d, $18, $24, $20, $0a, $1b, $19
087D2 24 23 18 17 0E 2B           .db $24, $23, $18, $17, $0e, $2b
087D8 26 25 01 24                 .db $26, $25, $01, $24         ; placeholder for left pipe
087DC 26 2D 01 24                 .db $26, $2d, $01, $24         ; placeholder for middle pipe
087E0 26 35 01 24                 .db $26, $35, $01, $24         ; placeholder for right pipe
087E4 27 D9 46 AA                 .db $27, $d9, $46, $aa         ; attribute data
087E8 27 E1 45 AA                 .db $27, $e1, $45, $aa
087EC FF                          .db $ff
087ED                           
087ED                           LuigiName:
087ED 15 1E 12 10 12              .db $15, $1e, $12, $10, $12    ; "LUIGI", no address or length
087F2                           
087F2                           WarpZoneNumbers:
087F2 04 03 02 00                 .db $04, $03, $02, $00         ; warp zone numbers, note spaces on middle
087F6 24 05 24 00                 .db $24, $05, $24, $00         ; zone, partly responsible for
087FA 08 07 06 00                 .db $08, $07, $06, $00         ; the minus world
087FE                           
087FE                           GameTextOffsets:
087FE 00 00                       .db TopStatusBarLine-GameText, TopStatusBarLine-GameText
08800 27 27                       .db WorldLivesDisplay-GameText, WorldLivesDisplay-GameText
08802 46 4E                       .db TwoPlayerTimeUp-GameText, OnePlayerTimeUp-GameText
08804 59 61                       .db TwoPlayerGameOver-GameText, OnePlayerGameOver-GameText
08806 6E 6E                       .db WarpZoneWelcome-GameText, WarpZoneWelcome-GameText
08808                           
08808                           WriteGameText:
08808 48                                       pha                      ;save text number to stack
08809 0A                                       asl
0880A A8                                       tay                      ;multiply by 2 and use as offset
0880B C0 04                                    cpy #$04                 ;if set to do top status bar or world/lives display,
0880D 90 0C                                    bcc LdGameText           ;branch to use current offset as-is
0880F C0 08                                    cpy #$08                 ;if set to do time-up or game over,
08811 90 02                                    bcc Chk2Players          ;branch to check players
08813 A0 08                                    ldy #$08                 ;otherwise warp zone, therefore set offset
08815 AD 7A 07                  Chk2Players:   lda NumberOfPlayers      ;check for number of players
08818 D0 01                                    bne LdGameText           ;if there are two, use current offset to also print name
0881A C8                                       iny                      ;otherwise increment offset by one to not print name
0881B BE FE 87                  LdGameText:    ldx GameTextOffsets,y    ;get offset to message we want to print
0881E A0 00                                    ldy #$00
08820 BD 52 87                  GameTextLoop:  lda GameText,x           ;load message data
08823 C9 FF                                    cmp #$ff                 ;check for terminator
08825 F0 07                                    beq EndGameText          ;branch to end text if found
08827 99 01 03                                 sta VRAM_Buffer1,y       ;otherwise write data to buffer
0882A E8                                       inx                      ;and increment increment
0882B C8                                       iny
0882C D0 F2                                    bne GameTextLoop         ;do this for 256 bytes if no terminator found
0882E A9 00                     EndGameText:   lda #$00                 ;put null terminator at end
08830 99 01 03                                 sta VRAM_Buffer1,y
08833 68                                       pla                      ;pull original text number from stack
08834 AA                                       tax
08835 C9 04                                    cmp #$04                 ;are we printing warp zone?
08837 B0 49                                    bcs PrintWarpZoneNumbers
08839 CA                                       dex                      ;are we printing the world/lives display?
0883A D0 23                                    bne CheckPlayerName      ;if not, branch to check player's name
0883C AD 5A 07                                 lda NumberofLives        ;otherwise, check number of lives
0883F 18                                       clc                      ;and increment by one for display
08840 69 01                                    adc #$01
08842 C9 0A                                    cmp #10                  ;more than 9 lives?
08844 90 07                                    bcc PutLives
08846 E9 0A                                    sbc #10                  ;if so, subtract 10 and put a crown tile
08848 A0 9F                                    ldy #$9f                 ;next to the difference...strange things happen if
0884A 8C 08 03                                 sty VRAM_Buffer1+7       ;the number of lives exceeds 19
0884D 8D 09 03                  PutLives:      sta VRAM_Buffer1+8
08850 AC 5F 07                                 ldy WorldNumber          ;write world and level numbers (incremented for display)
08853 C8                                       iny                      ;to the buffer in the spaces surrounding the dash
08854 8C 14 03                                 sty VRAM_Buffer1+19
08857 AC 5C 07                                 ldy LevelNumber
0885A C8                                       iny
0885B 8C 16 03                                 sty VRAM_Buffer1+21      ;we're done here
0885E 60                                       rts
0885F                           
0885F                           CheckPlayerName:
0885F AD 7A 07                               lda NumberOfPlayers    ;check number of players
08862 F0 1D                                  beq ExitChkName        ;if only 1 player, leave
08864 AD 53 07                               lda CurrentPlayer      ;load current player
08867 CA                                     dex                    ;check to see if current message number is for time up
08868 D0 09                                  bne ChkLuigi
0886A AC 70 07                               ldy OperMode           ;check for game over mode
0886D C0 03                                  cpy #GameOverModeValue
0886F F0 02                                  beq ChkLuigi
08871 49 01                                  eor #%00000001         ;if not, must be time up, invert d0 to do other player
08873 4A                        ChkLuigi:    lsr
08874 90 0B                                  bcc ExitChkName        ;if mario is current player, do not change the name
08876 A0 04                                  ldy #$04
08878 B9 ED 87                  NameLoop:    lda LuigiName,y        ;otherwise, replace "MARIO" with "LUIGI"
0887B 99 04 03                               sta VRAM_Buffer1+3,y
0887E 88                                     dey
0887F 10 F7                                  bpl NameLoop           ;do this until each letter is replaced
08881 60                        ExitChkName: rts
08882                           
08882                           PrintWarpZoneNumbers:
08882 E9 04                                  sbc #$04               ;subtract 4 and then shift to the left
08884 0A                                     asl                    ;twice to get proper warp zone number
08885 0A                                     asl                    ;offset
08886 AA                                     tax
08887 A0 00                                  ldy #$00
08889 BD F2 87                  WarpNumLoop: lda WarpZoneNumbers,x  ;print warp zone numbers into the
0888C 99 1C 03                               sta VRAM_Buffer1+27,y  ;placeholders from earlier
0888F E8                                     inx
08890 C8                                     iny                    ;put a number in every fourth space
08891 C8                                     iny
08892 C8                                     iny
08893 C8                                     iny
08894 C0 0C                                  cpy #$0c
08896 90 F1                                  bcc WarpNumLoop
08898 A9 2C                                  lda #$2c               ;load new buffer pointer at end of message
0889A 4C 3F 86                               jmp SetVRAMOffset
0889D                           
0889D                           ;-------------------------------------------------------------------------------------
0889D                           
0889D                           ResetSpritesAndScreenTimer:
0889D AD A0 07                           lda ScreenTimer             ;check if screen timer has expired
088A0 D0 0B                              bne NoReset                 ;if not, branch to leave
088A2 20 20 82                           jsr MoveAllSpritesOffscreen ;otherwise reset sprites now
088A5                           
088A5                           ResetScreenTimer:
088A5 A9 07                              lda #$07                    ;reset timer again
088A7 8D A0 07                           sta ScreenTimer
088AA EE 3C 07                           inc ScreenRoutineTask       ;move onto next task
088AD 60                        NoReset: rts
088AE                           
088AE                           ;-------------------------------------------------------------------------------------
088AE                           ;$00 - temp vram buffer offset
088AE                           ;$01 - temp metatile buffer offset
088AE                           ;$02 - temp metatile graphics table offset
088AE                           ;$03 - used to store attribute bits
088AE                           ;$04 - used to determine attribute table row
088AE                           ;$05 - used to determine attribute table column
088AE                           ;$06 - metatile graphics table address low
088AE                           ;$07 - metatile graphics table address high
088AE                           
088AE                           RenderAreaGraphics:
088AE AD 26 07                              lda CurrentColumnPos         ;store LSB of where we're at
088B1 29 01                                 and #$01
088B3 85 05                                 sta $05
088B5 AC 40 03                              ldy VRAM_Buffer2_Offset      ;store vram buffer offset
088B8 84 00                                 sty $00
088BA AD 21 07                              lda CurrentNTAddr_Low        ;get current name table address we're supposed to render
088BD 99 42 03                              sta VRAM_Buffer2+1,y
088C0 AD 20 07                              lda CurrentNTAddr_High
088C3 99 41 03                              sta VRAM_Buffer2,y
088C6 A9 9A                                 lda #$9a                     ;store length byte of 26 here with d7 set
088C8 99 43 03                              sta VRAM_Buffer2+2,y         ;to increment by 32 (in columns)
088CB A9 00                                 lda #$00                     ;init attribute row
088CD 85 04                                 sta $04
088CF AA                                    tax
088D0 86 01                     DrawMTLoop: stx $01                      ;store init value of 0 or incremented offset for buffer
088D2 BD A1 06                              lda MetatileBuffer,x         ;get first metatile number, and mask out all but 2 MSB
088D5 29 C0                                 and #%11000000
088D7 85 03                                 sta $03                      ;store attribute table bits here
088D9 0A                                    asl                          ;note that metatile format is:
088DA 2A                                    rol                          ;%xx000000 - attribute table bits, 
088DB 2A                                    rol                          ;%00xxxxxx - metatile number
088DC A8                                    tay                          ;rotate bits to d1-d0 and use as offset here
088DD B9 08 8B                              lda MetatileGraphics_Low,y   ;get address to graphics table from here
088E0 85 06                                 sta $06
088E2 B9 0C 8B                              lda MetatileGraphics_High,y
088E5 85 07                                 sta $07
088E7 BD A1 06                              lda MetatileBuffer,x         ;get metatile number again
088EA 0A                                    asl                          ;multiply by 4 and use as tile offset
088EB 0A                                    asl
088EC 85 02                                 sta $02
088EE AD 1F 07                              lda AreaParserTaskNum        ;get current task number for level processing and
088F1 29 01                                 and #%00000001               ;mask out all but LSB, then invert LSB, multiply by 2
088F3 49 01                                 eor #%00000001               ;to get the correct column position in the metatile,
088F5 0A                                    asl                          ;then add to the tile offset so we can draw either side
088F6 65 02                                 adc $02                      ;of the metatiles
088F8 A8                                    tay
088F9 A6 00                                 ldx $00                      ;use vram buffer offset from before as X
088FB B1 06                                 lda ($06),y
088FD 9D 44 03                              sta VRAM_Buffer2+3,x         ;get first tile number (top left or top right) and store
08900 C8                                    iny
08901 B1 06                                 lda ($06),y                  ;now get the second (bottom left or bottom right) and store
08903 9D 45 03                              sta VRAM_Buffer2+4,x
08906 A4 04                                 ldy $04                      ;get current attribute row
08908 A5 05                                 lda $05                      ;get LSB of current column where we're at, and
0890A D0 0E                                 bne RightCheck               ;branch if set (clear = left attrib, set = right)
0890C A5 01                                 lda $01                      ;get current row we're rendering
0890E 4A                                    lsr                          ;branch if LSB set (clear = top left, set = bottom left)
0890F B0 19                                 bcs LLeft
08911 26 03                                 rol $03                      ;rotate attribute bits 3 to the left
08913 26 03                                 rol $03                      ;thus in d1-d0, for upper left square
08915 26 03                                 rol $03
08917 4C 30 89                              jmp SetAttrib
0891A A5 01                     RightCheck: lda $01                      ;get LSB of current row we're rendering
0891C 4A                                    lsr                          ;branch if set (clear = top right, set = bottom right)
0891D B0 0F                                 bcs NextMTRow
0891F 46 03                                 lsr $03                      ;shift attribute bits 4 to the right
08921 46 03                                 lsr $03                      ;thus in d3-d2, for upper right square
08923 46 03                                 lsr $03
08925 46 03                                 lsr $03
08927 4C 30 89                              jmp SetAttrib
0892A 46 03                     LLeft:      lsr $03                      ;shift attribute bits 2 to the right
0892C 46 03                                 lsr $03                      ;thus in d5-d4 for lower left square
0892E E6 04                     NextMTRow:  inc $04                      ;move onto next attribute row  
08930 B9 F9 03                  SetAttrib:  lda AttributeBuffer,y        ;get previously saved bits from before
08933 05 03                                 ora $03                      ;if any, and put new bits, if any, onto
08935 99 F9 03                              sta AttributeBuffer,y        ;the old, and store
08938 E6 00                                 inc $00                      ;increment vram buffer offset by 2
0893A E6 00                                 inc $00
0893C A6 01                                 ldx $01                      ;get current gfx buffer row, and check for
0893E E8                                    inx                          ;the bottom of the screen
0893F E0 0D                                 cpx #$0d
08941 90 8D                                 bcc DrawMTLoop               ;if not there yet, loop back
08943 A4 00                                 ldy $00                      ;get current vram buffer offset, increment by 3
08945 C8                                    iny                          ;(for name table address and length bytes)
08946 C8                                    iny
08947 C8                                    iny
08948 A9 00                                 lda #$00
0894A 99 41 03                              sta VRAM_Buffer2,y           ;put null terminator at end of data for name table
0894D 8C 40 03                              sty VRAM_Buffer2_Offset      ;store new buffer offset
08950 EE 21 07                              inc CurrentNTAddr_Low        ;increment name table address low
08953 AD 21 07                              lda CurrentNTAddr_Low        ;check current low byte
08956 29 1F                                 and #%00011111               ;if no wraparound, just skip this part
08958 D0 0D                                 bne ExitDrawM
0895A A9 80                                 lda #$80                     ;if wraparound occurs, make sure low byte stays
0895C 8D 21 07                              sta CurrentNTAddr_Low        ;just under the status bar
0895F AD 20 07                              lda CurrentNTAddr_High       ;and then invert d2 of the name table address high
08962 49 04                                 eor #%00000100               ;to move onto the next appropriate name table
08964 8D 20 07                              sta CurrentNTAddr_High
08967 4C BD 89                  ExitDrawM:  jmp SetVRAMCtrl              ;jump to set buffer to $0341 and leave
0896A                           
0896A                           ;-------------------------------------------------------------------------------------
0896A                           ;$00 - temp attribute table address high (big endian order this time!)
0896A                           ;$01 - temp attribute table address low
0896A                           
0896A                           RenderAttributeTables:
0896A AD 21 07                               lda CurrentNTAddr_Low    ;get low byte of next name table address
0896D 29 1F                                  and #%00011111           ;to be written to, mask out all but 5 LSB,
0896F 38                                     sec                      ;subtract four 
08970 E9 04                                  sbc #$04
08972 29 1F                                  and #%00011111           ;mask out bits again and store
08974 85 01                                  sta $01
08976 AD 20 07                               lda CurrentNTAddr_High   ;get high byte and branch if borrow not set
08979 B0 02                                  bcs SetATHigh
0897B 49 04                                  eor #%00000100           ;otherwise invert d2
0897D 29 04                     SetATHigh:   and #%00000100           ;mask out all other bits
0897F 09 23                                  ora #$23                 ;add $2300 to the high byte and store
08981 85 00                                  sta $00
08983 A5 01                                  lda $01                  ;get low byte - 4, divide by 4, add offset for
08985 4A                                     lsr                      ;attribute table and store
08986 4A                                     lsr
08987 69 C0                                  adc #$c0                 ;we should now have the appropriate block of
08989 85 01                                  sta $01                  ;attribute table in our temp address
0898B A2 00                                  ldx #$00
0898D AC 40 03                               ldy VRAM_Buffer2_Offset  ;get buffer offset
08990 A5 00                     AttribLoop:  lda $00
08992 99 41 03                               sta VRAM_Buffer2,y       ;store high byte of attribute table address
08995 A5 01                                  lda $01
08997 18                                     clc                      ;get low byte, add 8 because we want to start
08998 69 08                                  adc #$08                 ;below the status bar, and store
0899A 99 42 03                               sta VRAM_Buffer2+1,y
0899D 85 01                                  sta $01                  ;also store in temp again
0899F BD F9 03                               lda AttributeBuffer,x    ;fetch current attribute table byte and store
089A2 99 44 03                               sta VRAM_Buffer2+3,y     ;in the buffer
089A5 A9 01                                  lda #$01
089A7 99 43 03                               sta VRAM_Buffer2+2,y     ;store length of 1 in buffer
089AA 4A                                     lsr
089AB 9D F9 03                               sta AttributeBuffer,x    ;clear current byte in attribute buffer
089AE C8                                     iny                      ;increment buffer offset by 4 bytes
089AF C8                                     iny
089B0 C8                                     iny
089B1 C8                                     iny
089B2 E8                                     inx                      ;increment attribute offset and check to see
089B3 E0 07                                  cpx #$07                 ;if we're at the end yet
089B5 90 D9                                  bcc AttribLoop
089B7 99 41 03                               sta VRAM_Buffer2,y       ;put null terminator at the end
089BA 8C 40 03                               sty VRAM_Buffer2_Offset  ;store offset in case we want to do any more
089BD A9 06                     SetVRAMCtrl: lda #$06
089BF 8D 73 07                               sta VRAM_Buffer_AddrCtrl ;set buffer to $0341 and leave
089C2 60                                     rts
089C3                           
089C3                           ;-------------------------------------------------------------------------------------
089C3                           
089C3                           ;$00 - used as temporary counter in ColorRotation
089C3                           
089C3                           ColorRotatePalette:
089C3 27 27 27 17 07 17                .db $27, $27, $27, $17, $07, $17
089C9                           
089C9                           BlankPalette:
089C9 3F 0C 04 FF FF FF FF 00          .db $3f, $0c, $04, $ff, $ff, $ff, $ff, $00
089D1                           
089D1                           ;used based on area type
089D1                           Palette3Data:
089D1 0F 07 12 0F                      .db $0f, $07, $12, $0f 
089D5 0F 07 17 0F                      .db $0f, $07, $17, $0f
089D9 0F 07 17 1C                      .db $0f, $07, $17, $1c
089DD 0F 07 17 00                      .db $0f, $07, $17, $00
089E1                           
089E1                           ColorRotation:
089E1 A5 09                                   lda FrameCounter         ;get frame counter
089E3 29 07                                   and #$07                 ;mask out all but three LSB
089E5 D0 51                                   bne ExitColorRot         ;branch if not set to zero to do this every eighth frame
089E7 AE 00 03                                ldx VRAM_Buffer1_Offset  ;check vram buffer offset
089EA E0 31                                   cpx #$31
089EC B0 4A                                   bcs ExitColorRot         ;if offset over 48 bytes, branch to leave
089EE A8                                      tay                      ;otherwise use frame counter's 3 LSB as offset here
089EF B9 C9 89                  GetBlankPal:  lda BlankPalette,y       ;get blank palette for palette 3
089F2 9D 01 03                                sta VRAM_Buffer1,x       ;store it in the vram buffer
089F5 E8                                      inx                      ;increment offsets
089F6 C8                                      iny
089F7 C0 08                                   cpy #$08
089F9 90 F4                                   bcc GetBlankPal          ;do this until all bytes are copied
089FB AE 00 03                                ldx VRAM_Buffer1_Offset  ;get current vram buffer offset
089FE A9 03                                   lda #$03
08A00 85 00                                   sta $00                  ;set counter here
08A02 AD 4E 07                                lda AreaType             ;get area type
08A05 0A                                      asl                      ;multiply by 4 to get proper offset
08A06 0A                                      asl
08A07 A8                                      tay                      ;save as offset here
08A08 B9 D1 89                  GetAreaPal:   lda Palette3Data,y       ;fetch palette to be written based on area type
08A0B 9D 04 03                                sta VRAM_Buffer1+3,x     ;store it to overwrite blank palette in vram buffer
08A0E C8                                      iny
08A0F E8                                      inx
08A10 C6 00                                   dec $00                  ;decrement counter
08A12 10 F4                                   bpl GetAreaPal           ;do this until the palette is all copied
08A14 AE 00 03                                ldx VRAM_Buffer1_Offset  ;get current vram buffer offset
08A17 AC D4 06                                ldy ColorRotateOffset    ;get color cycling offset
08A1A B9 C3 89                                lda ColorRotatePalette,y
08A1D 9D 05 03                                sta VRAM_Buffer1+4,x     ;get and store current color in second slot of palette
08A20 AD 00 03                                lda VRAM_Buffer1_Offset
08A23 18                                      clc                      ;add seven bytes to vram buffer offset
08A24 69 07                                   adc #$07
08A26 8D 00 03                                sta VRAM_Buffer1_Offset
08A29 EE D4 06                                inc ColorRotateOffset    ;increment color cycling offset
08A2C AD D4 06                                lda ColorRotateOffset
08A2F C9 06                                   cmp #$06                 ;check to see if it's still in range
08A31 90 05                                   bcc ExitColorRot         ;if so, branch to leave
08A33 A9 00                                   lda #$00
08A35 8D D4 06                                sta ColorRotateOffset    ;otherwise, init to keep it in range
08A38 60                        ExitColorRot: rts                      ;leave
08A39                           
08A39                           ;-------------------------------------------------------------------------------------
08A39                           ;$00 - temp store for offset control bit
08A39                           ;$01 - temp vram buffer offset
08A39                           ;$02 - temp store for vertical high nybble in block buffer routine
08A39                           ;$03 - temp adder for high byte of name table address
08A39                           ;$04, $05 - name table address low/high
08A39                           ;$06, $07 - block buffer address low/high
08A39                           
08A39                           BlockGfxData:
08A39 45 45 47 47                      .db $45, $45, $47, $47
08A3D 47 47 47 47                      .db $47, $47, $47, $47
08A41 57 58 59 5A                      .db $57, $58, $59, $5a
08A45 24 24 24 24                      .db $24, $24, $24, $24
08A49 26 26 26 26                      .db $26, $26, $26, $26
08A4D                           
08A4D                           RemoveCoin_Axe:
08A4D A0 41                                   ldy #$41                 ;set low byte so offset points to $0341
08A4F A9 03                                   lda #$03                 ;load offset for default blank metatile
08A51 AE 4E 07                                ldx AreaType             ;check area type
08A54 D0 02                                   bne WriteBlankMT         ;if not water type, use offset
08A56 A9 04                                   lda #$04                 ;otherwise load offset for blank metatile used in water
08A58 20 97 8A                  WriteBlankMT: jsr PutBlockMetatile     ;do a sub to write blank metatile to vram buffer
08A5B A9 06                                   lda #$06
08A5D 8D 73 07                                sta VRAM_Buffer_AddrCtrl ;set vram address controller to $0341 and leave
08A60 60                                      rts
08A61                           
08A61                           ReplaceBlockMetatile:
08A61 20 6D 8A                         jsr WriteBlockMetatile    ;write metatile to vram buffer to replace block object
08A64 EE F0 03                         inc Block_ResidualCounter ;increment unused counter (residual code)
08A67 DE EC 03                         dec Block_RepFlag,x       ;decrement flag (residual code)
08A6A 60                               rts                       ;leave
08A6B                           
08A6B                           DestroyBlockMetatile:
08A6B A9 00                            lda #$00       ;force blank metatile if branched/jumped to this point
08A6D                           
08A6D                           WriteBlockMetatile:
08A6D A0 03                                  ldy #$03                ;load offset for blank metatile
08A6F C9 00                                  cmp #$00                ;check contents of A for blank metatile
08A71 F0 14                                  beq UseBOffset          ;branch if found (unconditional if branched from 8a6b)
08A73 A0 00                                  ldy #$00                ;load offset for brick metatile w/ line
08A75 C9 58                                  cmp #$58
08A77 F0 0E                                  beq UseBOffset          ;use offset if metatile is brick with coins (w/ line)
08A79 C9 51                                  cmp #$51
08A7B F0 0A                                  beq UseBOffset          ;use offset if metatile is breakable brick w/ line
08A7D C8                                     iny                     ;increment offset for brick metatile w/o line
08A7E C9 5D                                  cmp #$5d
08A80 F0 05                                  beq UseBOffset          ;use offset if metatile is brick with coins (w/o line)
08A82 C9 52                                  cmp #$52
08A84 F0 01                                  beq UseBOffset          ;use offset if metatile is breakable brick w/o line
08A86 C8                                     iny                     ;if any other metatile, increment offset for empty block
08A87 98                        UseBOffset:  tya                     ;put Y in A
08A88 AC 00 03                               ldy VRAM_Buffer1_Offset ;get vram buffer offset
08A8B C8                                     iny                     ;move onto next byte
08A8C 20 97 8A                               jsr PutBlockMetatile    ;get appropriate block data and write to vram buffer
08A8F 88                        MoveVOffset: dey                     ;decrement vram buffer offset
08A90 98                                     tya                     ;add 10 bytes to it
08A91 18                                     clc
08A92 69 0A                                  adc #10
08A94 4C 3F 86                               jmp SetVRAMOffset       ;branch to store as new vram buffer offset
08A97                           
08A97                           PutBlockMetatile:
08A97 86 00                                 stx $00               ;store control bit from SprDataOffset_Ctrl
08A99 84 01                                 sty $01               ;store vram buffer offset for next byte
08A9B 0A                                    asl
08A9C 0A                                    asl                   ;multiply A by four and use as X
08A9D AA                                    tax
08A9E A0 20                                 ldy #$20              ;load high byte for name table 0
08AA0 A5 06                                 lda $06               ;get low byte of block buffer pointer
08AA2 C9 D0                                 cmp #$d0              ;check to see if we're on odd-page block buffer
08AA4 90 02                                 bcc SaveHAdder        ;if not, use current high byte
08AA6 A0 24                                 ldy #$24              ;otherwise load high byte for name table 1
08AA8 84 03                     SaveHAdder: sty $03               ;save high byte here
08AAA 29 0F                                 and #$0f              ;mask out high nybble of block buffer pointer
08AAC 0A                                    asl                   ;multiply by 2 to get appropriate name table low byte
08AAD 85 04                                 sta $04               ;and then store it here
08AAF A9 00                                 lda #$00
08AB1 85 05                                 sta $05               ;initialize temp high byte
08AB3 A5 02                                 lda $02               ;get vertical high nybble offset used in block buffer routine
08AB5 18                                    clc
08AB6 69 20                                 adc #$20              ;add 32 pixels for the status bar
08AB8 0A                                    asl
08AB9 26 05                                 rol $05               ;shift and rotate d7 onto d0 and d6 into carry
08ABB 0A                                    asl
08ABC 26 05                                 rol $05               ;shift and rotate d6 onto d0 and d5 into carry
08ABE 65 04                                 adc $04               ;add low byte of name table and carry to vertical high nybble
08AC0 85 04                                 sta $04               ;and store here
08AC2 A5 05                                 lda $05               ;get whatever was in d7 and d6 of vertical high nybble
08AC4 69 00                                 adc #$00              ;add carry
08AC6 18                                    clc
08AC7 65 03                                 adc $03               ;then add high byte of name table
08AC9 85 05                                 sta $05               ;store here
08ACB A4 01                                 ldy $01               ;get vram buffer offset to be used
08ACD BD 39 8A                  RemBridge:  lda BlockGfxData,x    ;write top left and top right
08AD0 99 03 03                              sta VRAM_Buffer1+2,y  ;tile numbers into first spot
08AD3 BD 3A 8A                              lda BlockGfxData+1,x
08AD6 99 04 03                              sta VRAM_Buffer1+3,y
08AD9 BD 3B 8A                              lda BlockGfxData+2,x  ;write bottom left and bottom
08ADC 99 08 03                              sta VRAM_Buffer1+7,y  ;right tiles numbers into
08ADF BD 3C 8A                              lda BlockGfxData+3,x  ;second spot
08AE2 99 09 03                              sta VRAM_Buffer1+8,y
08AE5 A5 04                                 lda $04
08AE7 99 01 03                              sta VRAM_Buffer1,y    ;write low byte of name table
08AEA 18                                    clc                   ;into first slot as read
08AEB 69 20                                 adc #$20              ;add 32 bytes to value
08AED 99 06 03                              sta VRAM_Buffer1+5,y  ;write low byte of name table
08AF0 A5 05                                 lda $05               ;plus 32 bytes into second slot
08AF2 99 00 03                              sta VRAM_Buffer1-1,y  ;write high byte of name
08AF5 99 05 03                              sta VRAM_Buffer1+4,y  ;table address to both slots
08AF8 A9 02                                 lda #$02
08AFA 99 02 03                              sta VRAM_Buffer1+1,y  ;put length of 2 in
08AFD 99 07 03                              sta VRAM_Buffer1+6,y  ;both slots
08B00 A9 00                                 lda #$00
08B02 99 0A 03                              sta VRAM_Buffer1+9,y  ;put null terminator at end
08B05 A6 00                                 ldx $00               ;get offset control bit here
08B07 60                                    rts                   ;and leave
