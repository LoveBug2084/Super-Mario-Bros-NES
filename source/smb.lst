0B5ED 85 57                                sta Player_X_Speed        ;set as new horizontal speed
0B5EF CD 56 04                             cmp MaximumRightSpeed     ;compare against maximum value for right movement
0B5F2 30 23                                bmi XSpdSign              ;if horizontal speed greater negatively, branch
0B5F4 AD 56 04                             lda MaximumRightSpeed     ;otherwise set preset value as horizontal speed
0B5F7 85 57                                sta Player_X_Speed        ;thus slowing the player's left movement down
0B5F9 4C 20 B6                             jmp SetAbsSpd             ;skip to the end
0B5FC AD 05 07                  RghtFrict: lda Player_X_MoveForce    ;load value set here
0B5FF 38                                   sec
0B600 ED 02 07                             sbc FrictionAdderLow      ;subtract from it another value set here
0B603 8D 05 07                             sta Player_X_MoveForce    ;store here
0B606 A5 57                                lda Player_X_Speed
0B608 ED 01 07                             sbc FrictionAdderHigh     ;subtract value plus borrow from horizontal speed
0B60B 85 57                                sta Player_X_Speed        ;set as new horizontal speed
0B60D CD 50 04                             cmp MaximumLeftSpeed      ;compare against maximum value for left movement
0B610 10 05                                bpl XSpdSign              ;if horizontal speed greater positively, branch
0B612 AD 50 04                             lda MaximumLeftSpeed      ;otherwise set preset value as horizontal speed
0B615 85 57                                sta Player_X_Speed        ;thus slowing the player's right movement down
0B617 C9 00                     XSpdSign:  cmp #$00                  ;if player not moving or moving to the right,
0B619 10 05                                bpl SetAbsSpd             ;branch and leave horizontal speed value unmodified
0B61B 49 FF                                eor #$ff
0B61D 18                                   clc                       ;otherwise get two's compliment to get absolute
0B61E 69 01                                adc #$01                  ;unsigned walking/running speed
0B620 8D 00 07                  SetAbsSpd: sta Player_XSpeedAbsolute ;store walking/running speed here and leave
