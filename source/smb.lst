096C5                           ;-------------------------------------------------------------------------------------
096C5                           ;(these apply to all area object subroutines in this section unless otherwise stated)
096C5                           ;$00 - used to store offset used to find object code
096C5                           ;$07 - starts with adder from area parser, used to store row offset
096C5                           
096C5                           AlterAreaAttributes:
096C5 BC 2D 07                           ldy AreaObjOffsetBuffer,x ;load offset for level object data saved in buffer
096C8 C8                                 iny                       ;load second byte
096C9 B1 E7                              lda (AreaData),y
096CB 48                                 pha                       ;save in stack for now
096CC 29 40                              and #%01000000
096CE D0 12                              bne Alter2                ;branch if d6 is set
096D0 68                                 pla
096D1 48                                 pha                       ;pull and push offset to copy to A
096D2 29 0F                              and #%00001111            ;mask out high nybble and store as
096D4 8D 27 07                           sta TerrainControl        ;new terrain height type bits
096D7 68                                 pla
096D8 29 30                              and #%00110000            ;pull and mask out all but d5 and d4
096DA 4A                                 lsr                       ;move bits to lower nybble and store
096DB 4A                                 lsr                       ;as new background scenery bits
096DC 4A                                 lsr
096DD 4A                                 lsr
096DE 8D 42 07                           sta BackgroundScenery     ;then leave
096E1 60                                 rts
096E2 68                        Alter2:  pla
096E3 29 07                              and #%00000111            ;mask out all but 3 LSB
096E5 C9 04                              cmp #$04                  ;if four or greater, set color control bits
096E7 90 05                              bcc SetFore               ;and nullify foreground scenery bits
096E9 8D 44 07                           sta BackgroundColorCtrl
096EC A9 00                              lda #$00
096EE 8D 41 07                  SetFore: sta ForegroundScenery     ;otherwise set new foreground scenery bits
096F1 60                                 rts
096F2                           
096F2                           ;--------------------------------
096F2                           
096F2                           ScrollLockObject_Warp:
096F2 A2 04                              ldx #$04            ;load value of 4 for game text routine as default
096F4 AD 5F 07                           lda WorldNumber     ;warp zone (4-3-2), then check world number
096F7 F0 08                              beq WarpNum
096F9 E8                                 inx                 ;if world number > 1, increment for next warp zone (5)
096FA AC 4E 07                           ldy AreaType        ;check area type
096FD 88                                 dey
096FE D0 01                              bne WarpNum         ;if ground area type, increment for last warp zone
09700 E8                                 inx                 ;(8-7-6) and move on
09701 8A                        WarpNum: txa
09702 8D D6 06                           sta WarpZoneControl ;store number here to be used by warp zone routine
09705 20 08 88                           jsr WriteGameText   ;print text and warp zone numbers
09708 A9 0D                              lda #PiranhaPlant
0970A 20 16 97                           jsr KillEnemies     ;load identifier for piranha plants and do sub
0970D                           
0970D                           ScrollLockObject:
0970D AD 23 07                        lda ScrollLock      ;invert scroll lock to turn it on
09710 49 01                           eor #%00000001
09712 8D 23 07                        sta ScrollLock
09715 60                              rts
09716                           
09716                           ;--------------------------------
09716                           ;$00 - used to store enemy identifier in KillEnemies
09716                           
09716                           KillEnemies:
09716 85 00                                sta $00           ;store identifier here
09718 A9 00                                lda #$00
0971A A2 04                                ldx #$04          ;check for identifier in enemy object buffer
0971C B4 16                     KillELoop: ldy Enemy_ID,x
0971E C4 00                                cpy $00           ;if not found, branch
09720 D0 02                                bne NoKillE
09722 95 0F                                sta Enemy_Flag,x  ;if found, deactivate enemy object flag
09724 CA                        NoKillE:   dex               ;do this until all slots are checked
09725 10 F5                                bpl KillELoop
09727 60                                   rts
09728                           
09728                           ;--------------------------------
09728                           
09728                           FrenzyIDData:
09728 14 17 18                        .db FlyCheepCheepFrenzy, BBill_CCheep_Frenzy, Stop_Frenzy
0972B                           
0972B A6 00                     AreaFrenzy:  ldx $00               ;use area object identifier bit as offset
0972D BD 20 97                               lda FrenzyIDData-8,x  ;note that it starts at 8, thus weird address here
09730 A0 05                                  ldy #$05
09732 88                        FreCompLoop: dey                   ;check regular slots of enemy object buffer
09733 30 07                                  bmi ExitAFrenzy       ;if all slots checked and enemy object not found, branch to store
09735 D9 16 00                               cmp Enemy_ID,y    ;check for enemy object in buffer versus frenzy object
09738 D0 F8                                  bne FreCompLoop
0973A A9 00                                  lda #$00              ;if enemy object already present, nullify queue and leave
0973C 8D CD 06                  ExitAFrenzy: sta EnemyFrenzyQueue  ;store enemy into frenzy queue
0973F 60                                     rts
09740                           
09740                           ;--------------------------------
09740                           ;$06 - used by MushroomLedge to store length
09740                           
09740                           AreaStyleObject:
09740 AD 33 07                        lda AreaStyle        ;load level object style and jump to the right sub
09743 20 04 8E                        jsr JumpEngine 
09746 4C 97                           .dw TreeLedge        ;also used for cloud type levels
09748 78 97                           .dw MushroomLedge
0974A 69 9A                           .dw BulletBillCannon
0974C                           
0974C                           TreeLedge:
0974C 20 BB 9B                            jsr GetLrgObjAttrib     ;get row and length of green ledge
0974F BD 30 07                            lda AreaObjectLength,x  ;check length counter for expiration
09752 F0 1F                               beq EndTreeL   
09754 10 11                               bpl MidTreeL
09756 98                                  tya
09757 9D 30 07                            sta AreaObjectLength,x  ;store lower nybble into buffer flag as length of ledge
0975A AD 25 07                            lda CurrentPageLoc
0975D 0D 26 07                            ora CurrentColumnPos    ;are we at the start of the level?
09760 F0 05                               beq MidTreeL
09762 A9 16                               lda #$16                ;render start of tree ledge
09764 4C B0 97                            jmp NoUnder
09767 A6 07                     MidTreeL: ldx $07
09769 A9 17                               lda #$17                ;render middle of tree ledge
0976B 9D A1 06                            sta MetatileBuffer,x    ;note that this is also used if ledge position is
0976E A9 4C                               lda #$4c                ;at the start of level for continuous effect
09770 4C AA 97                            jmp AllUnder            ;now render the part underneath
09773 A9 18                     EndTreeL: lda #$18                ;render end of tree ledge
09775 4C B0 97                            jmp NoUnder
09778                           
09778                           MushroomLedge:
09778 20 AC 9B                            jsr ChkLrgObjLength        ;get shroom dimensions
0977B 84 06                               sty $06                    ;store length here for now
0977D 90 0C                               bcc EndMushL
0977F BD 30 07                            lda AreaObjectLength,x     ;divide length by 2 and store elsewhere
09782 4A                                  lsr
09783 9D 36 07                            sta MushroomLedgeHalfLen,x
09786 A9 19                               lda #$19                   ;render start of mushroom
09788 4C B0 97                            jmp NoUnder
0978B A9 1B                     EndMushL: lda #$1b                   ;if at the end, render end of mushroom
0978D BC 30 07                            ldy AreaObjectLength,x
09790 F0 1E                               beq NoUnder
09792 BD 36 07                            lda MushroomLedgeHalfLen,x ;get divided length and store where length
09795 85 06                               sta $06                    ;was stored originally
09797 A6 07                               ldx $07
09799 A9 1A                               lda #$1a
0979B 9D A1 06                            sta MetatileBuffer,x       ;render middle of mushroom
0979E C4 06                               cpy $06                    ;are we smack dab in the center?
097A0 D0 2C                               bne MushLExit              ;if not, branch to leave
097A2 E8                                  inx
097A3 A9 4F                               lda #$4f
097A5 9D A1 06                            sta MetatileBuffer,x       ;render stem top of mushroom underneath the middle
097A8 A9 50                               lda #$50
097AA E8                        AllUnder: inx
097AB A0 0F                               ldy #$0f                   ;set $0f to render all way down
097AD 4C 7D 9B                            jmp RenderUnderPart       ;now render the stem of mushroom
097B0 A6 07                     NoUnder:  ldx $07                    ;load row of ledge
097B2 A0 00                               ldy #$00                   ;set 0 for no bottom on this part
097B4 4C 7D 9B                            jmp RenderUnderPart
097B7                           
097B7                           ;--------------------------------
097B7                           
097B7                           ;tiles used by pulleys and rope object
097B7                           PulleyRopeMetatiles:
097B7 42 41 43                        .db $42, $41, $43
097BA                           
097BA                           PulleyRopeObject:
097BA 20 AC 9B                             jsr ChkLrgObjLength       ;get length of pulley/rope object
097BD A0 00                                ldy #$00                  ;initialize metatile offset
097BF B0 07                                bcs RenderPul             ;if starting, render left pulley
097C1 C8                                   iny
097C2 BD 30 07                             lda AreaObjectLength,x    ;if not at the end, render rope
097C5 D0 01                                bne RenderPul
097C7 C8                                   iny                       ;otherwise render right pulley
097C8 B9 B7 97                  RenderPul: lda PulleyRopeMetatiles,y
097CB 8D A1 06                             sta MetatileBuffer        ;render at the top of the screen
097CE 60                        MushLExit: rts                       ;and leave
097CF                           
097CF                           ;--------------------------------
097CF                           ;$06 - used to store upper limit of rows for CastleObject
097CF                           
097CF                           CastleMetatiles:
097CF 00 45 45 45 00                  .db $00, $45, $45, $45, $00
097D4 00 48 47 46 00                  .db $00, $48, $47, $46, $00
097D9 45 49 49 49 45                  .db $45, $49, $49, $49, $45
097DE 47 47 4A 47 47                  .db $47, $47, $4a, $47, $47
097E3 47 47 4B 47 47                  .db $47, $47, $4b, $47, $47
097E8 49 49 49 49 49                  .db $49, $49, $49, $49, $49
097ED 47 4A 47 4A 47                  .db $47, $4a, $47, $4a, $47
097F2 47 4B 47 4B 47                  .db $47, $4b, $47, $4b, $47
097F7 47 47 47 47 47                  .db $47, $47, $47, $47, $47
097FC 4A 47 4A 47 4A                  .db $4a, $47, $4a, $47, $4a
09801 4B 47 4B 47 4B                  .db $4b, $47, $4b, $47, $4b
09806                           
09806                           CastleObject:
09806 20 BB 9B                              jsr GetLrgObjAttrib      ;save lower nybble as starting row
09809 84 07                                 sty $07                  ;if starting row is above $0a, game will crash!!!
0980B A0 04                                 ldy #$04
0980D 20 AF 9B                              jsr ChkLrgObjFixedLength ;load length of castle if not already loaded
09810 8A                                    txa                  
09811 48                                    pha                      ;save obj buffer offset to stack
09812 BC 30 07                              ldy AreaObjectLength,x   ;use current length as offset for castle data
09815 A6 07                                 ldx $07                  ;begin at starting row
09817 A9 0B                                 lda #$0b
09819 85 06                                 sta $06                  ;load upper limit of number of rows to print
0981B B9 CF 97                  CRendLoop:  lda CastleMetatiles,y    ;load current byte using offset
0981E 9D A1 06                              sta MetatileBuffer,x
09821 E8                                    inx                      ;store in buffer and increment buffer offset
09822 A5 06                                 lda $06
09824 F0 07                                 beq ChkCFloor            ;have we reached upper limit yet?
09826 C8                                    iny                      ;if not, increment column-wise
09827 C8                                    iny                      ;to byte in next row
09828 C8                                    iny
09829 C8                                    iny
0982A C8                                    iny
0982B C6 06                                 dec $06                  ;move closer to upper limit
0982D E0 0B                     ChkCFloor:  cpx #$0b                 ;have we reached the row just before floor?
0982F D0 EA                                 bne CRendLoop            ;if not, go back and do another row
09831 68                                    pla
09832 AA                                    tax                      ;get obj buffer offset from before
09833 AD 25 07                              lda CurrentPageLoc
09836 F0 36                                 beq ExitCastle           ;if we're at page 0, we do not need to do anything else
09838 BD 30 07                              lda AreaObjectLength,x   ;check length
0983B C9 01                                 cmp #$01                 ;if length almost about to expire, put brick at floor
0983D F0 2A                                 beq PlayerStop
0983F A4 07                                 ldy $07                  ;check starting row for tall castle ($00)
09841 D0 04                                 bne NotTall
09843 C9 03                                 cmp #$03                 ;if found, then check to see if we're at the second column
09845 F0 22                                 beq PlayerStop
09847 C9 02                     NotTall:    cmp #$02                 ;if not tall castle, check to see if we're at the third column
09849 D0 23                                 bne ExitCastle           ;if we aren't and the castle is tall, don't create flag yet
0984B 20 CB 9B                              jsr GetAreaObjXPosition  ;otherwise, obtain and save horizontal pixel coordinate
0984E 48                                    pha
0984F 20 4A 99                              jsr FindEmptyEnemySlot   ;find an empty place on the enemy object buffer
09852 68                                    pla
09853 95 87                                 sta Enemy_X_Position,x   ;then write horizontal coordinate for star flag
09855 AD 25 07                              lda CurrentPageLoc
09858 95 6E                                 sta Enemy_PageLoc,x      ;set page location for star flag
0985A A9 01                                 lda #$01
0985C 95 B6                                 sta Enemy_Y_HighPos,x    ;set vertical high byte
0985E 95 0F                                 sta Enemy_Flag,x         ;set flag for buffer
09860 A9 90                                 lda #$90
09862 95 CF                                 sta Enemy_Y_Position,x   ;set vertical coordinate
09864 A9 31                                 lda #StarFlagObject      ;set star flag value in buffer itself
09866 95 16                                 sta Enemy_ID,x
09868 60                                    rts
09869 A0 52                     PlayerStop: ldy #$52                 ;put brick at floor to stop player at end of level
0986B 8C AB 06                              sty MetatileBuffer+10    ;this is only done if we're on the second column
0986E 60                        ExitCastle: rts
0986F                           
0986F                           ;--------------------------------
0986F                           
0986F                           WaterPipe:
0986F 20 BB 9B                        jsr GetLrgObjAttrib     ;get row and lower nybble
09872 BC 30 07                        ldy AreaObjectLength,x  ;get length (residual code, water pipe is 1 col thick)
09875 A6 07                           ldx $07                 ;get row
09877 A9 6B                           lda #$6b
09879 9D A1 06                        sta MetatileBuffer,x    ;draw something here and below it
0987C A9 6C                           lda #$6c
0987E 9D A2 06                        sta MetatileBuffer+1,x
09881 60                              rts
09882                           
09882                           ;--------------------------------
09882                           ;$05 - used to store length of vertical shaft in RenderSidewaysPipe
09882                           ;$06 - used to store leftover horizontal length in RenderSidewaysPipe
09882                           ; and vertical length in VerticalPipe and GetPipeHeight
09882                           
09882                           IntroPipe:
09882 A0 03                                    ldy #$03                 ;check if length set, if not set, set it
09884 20 AF 9B                                 jsr ChkLrgObjFixedLength
09887 A0 0A                                    ldy #$0a                 ;set fixed value and render the sideways part
09889 20 B3 98                                 jsr RenderSidewaysPipe
0988C B0 10                                    bcs NoBlankP             ;if carry flag set, not time to draw vertical pipe part
0988E A2 06                                    ldx #$06                 ;blank everything above the vertical pipe part
09890 A9 00                     VPipeSectLoop: lda #$00                 ;all the way to the top of the screen
09892 9D A1 06                                 sta MetatileBuffer,x     ;because otherwise it will look like exit pipe
09895 CA                                       dex
09896 10 F8                                    bpl VPipeSectLoop
09898 B9 DD 98                                 lda VerticalPipeData,y   ;draw the end of the vertical pipe part
0989B 8D A8 06                                 sta MetatileBuffer+7
0989E 60                        NoBlankP:      rts
0989F                           
0989F                           SidePipeShaftData:
0989F 15 14                           .db $15, $14  ;used to control whether or not vertical pipe shaft
098A1 00 00                           .db $00, $00  ;is drawn, and if so, controls the metatile number
098A3                           SidePipeTopPart:
098A3 15 1E                           .db $15, $1e  ;top part of sideways part of pipe
098A5 1D 1C                           .db $1d, $1c
098A7                           SidePipeBottomPart: 
098A7 15 21                           .db $15, $21  ;bottom part of sideways part of pipe
098A9 20 1F                           .db $20, $1f
098AB                           
098AB                           ExitPipe:
098AB A0 03                           ldy #$03                 ;check if length set, if not set, set it
098AD 20 AF 9B                        jsr ChkLrgObjFixedLength
098B0 20 BB 9B                        jsr GetLrgObjAttrib      ;get vertical length, then plow on through RenderSidewaysPipe
098B3                           
098B3                           RenderSidewaysPipe:
098B3 88                                      dey                       ;decrement twice to make room for shaft at bottom
098B4 88                                      dey                       ;and store here for now as vertical length
098B5 84 05                                   sty $05
098B7 BC 30 07                                ldy AreaObjectLength,x    ;get length left over and store here
098BA 84 06                                   sty $06
098BC A6 05                                   ldx $05                   ;get vertical length plus one, use as buffer offset
098BE E8                                      inx
098BF B9 9F 98                                lda SidePipeShaftData,y   ;check for value $00 based on horizontal offset
098C2 C9 00                                   cmp #$00
098C4 F0 08                                   beq DrawSidePart          ;if found, do not draw the vertical pipe shaft
098C6 A2 00                                   ldx #$00
098C8 A4 05                                   ldy $05                   ;init buffer offset and get vertical length
098CA 20 7D 9B                                jsr RenderUnderPart       ;and render vertical shaft using tile number in A
098CD 18                                      clc                       ;clear carry flag to be used by IntroPipe
098CE A4 06                     DrawSidePart: ldy $06                   ;render side pipe part at the bottom
098D0 B9 A3 98                                lda SidePipeTopPart,y
098D3 9D A1 06                                sta MetatileBuffer,x      ;note that the pipe parts are stored
098D6 B9 A7 98                                lda SidePipeBottomPart,y  ;backwards horizontally
098D9 9D A2 06                                sta MetatileBuffer+1,x
098DC 60                                      rts
098DD                           
098DD                           VerticalPipeData:
098DD 11 10                           .db $11, $10 ;used by pipes that lead somewhere
098DF 15 14                           .db $15, $14
098E1 13 12                           .db $13, $12 ;used by decoration pipes
098E3 15 14                           .db $15, $14
098E5                           
098E5                           VerticalPipe:
098E5 20 39 99                            jsr GetPipeHeight
098E8 A5 00                               lda $00                  ;check to see if value was nullified earlier
098EA F0 04                               beq WarpPipe             ;(if d3, the usage control bit of second byte, was set)
098EC C8                                  iny
098ED C8                                  iny
098EE C8                                  iny
098EF C8                                  iny                      ;add four if usage control bit was not set
098F0 98                        WarpPipe: tya                      ;save value in stack
098F1 48                                  pha
098F2 AD 60 07                            lda AreaNumber
098F5 0D 5F 07                            ora WorldNumber          ;if at world 1-1, do not add piranha plant ever
098F8 F0 2B                               beq DrawPipe
098FA BC 30 07                            ldy AreaObjectLength,x   ;if on second column of pipe, branch
098FD F0 26                               beq DrawPipe             ;(because we only need to do this once)
098FF 20 4A 99                            jsr FindEmptyEnemySlot   ;check for an empty moving data buffer space
09902 B0 21                               bcs DrawPipe             ;if not found, too many enemies, thus skip
09904 20 CB 9B                            jsr GetAreaObjXPosition  ;get horizontal pixel coordinate
09907 18                                  clc
09908 69 08                               adc #$08                 ;add eight to put the piranha plant in the center
0990A 95 87                               sta Enemy_X_Position,x   ;store as enemy's horizontal coordinate
0990C AD 25 07                            lda CurrentPageLoc       ;add carry to current page number
0990F 69 00                               adc #$00
09911 95 6E                               sta Enemy_PageLoc,x      ;store as enemy's page coordinate
09913 A9 01                               lda #$01
09915 95 B6                               sta Enemy_Y_HighPos,x
09917 95 0F                               sta Enemy_Flag,x         ;activate enemy flag
09919 20 D3 9B                            jsr GetAreaObjYPosition  ;get piranha plant's vertical coordinate and store here
0991C 95 CF                               sta Enemy_Y_Position,x
0991E A9 0D                               lda #PiranhaPlant        ;write piranha plant's value into buffer
09920 95 16                               sta Enemy_ID,x
09922 20 87 C7                            jsr InitPiranhaPlant
09925 68                        DrawPipe: pla                      ;get value saved earlier and use as Y
09926 A8                                  tay
09927 A6 07                               ldx $07                  ;get buffer offset
09929 B9 DD 98                            lda VerticalPipeData,y   ;draw the appropriate pipe with the Y we loaded earlier
0992C 9D A1 06                            sta MetatileBuffer,x     ;render the top of the pipe
0992F E8                                  inx
09930 B9 DF 98                            lda VerticalPipeData+2,y ;render the rest of the pipe
09933 A4 06                               ldy $06                  ;subtract one from length and render the part underneath
09935 88                                  dey
09936 4C 7D 9B                            jmp RenderUnderPart
09939                                 
09939                           GetPipeHeight:
09939 A0 01                           ldy #$01       ;check for length loaded, if not, load
0993B 20 AF 9B                        jsr ChkLrgObjFixedLength ;pipe length of 2 (horizontal)
0993E 20 BB 9B                        jsr GetLrgObjAttrib
09941 98                              tya            ;get saved lower nybble as height
09942 29 07                           and #$07       ;save only the three lower bits as
09944 85 06                           sta $06        ;vertical length, then load Y with
09946 BC 30 07                        ldy AreaObjectLength,x    ;length left over
09949 60                              rts
0994A                           
0994A                           FindEmptyEnemySlot:
0994A A2 00                                   ldx #$00          ;start at first enemy slot
0994C 18                        EmptyChkLoop: clc               ;clear carry flag by default
0994D B5 0F                                   lda Enemy_Flag,x  ;check enemy buffer for nonzero
0994F F0 05                                   beq ExitEmptyChk  ;if zero, leave
09951 E8                                      inx
09952 E0 05                                   cpx #$05          ;if nonzero, check next value
09954 D0 F6                                   bne EmptyChkLoop
09956 60                        ExitEmptyChk: rts               ;if all values nonzero, carry flag is set
09957                           
09957                           ;--------------------------------
09957                           
09957                           Hole_Water:
09957 20 AC 9B                        jsr ChkLrgObjLength   ;get low nybble and save as length
0995A A9 86                           lda #$86              ;render waves
0995C 8D AB 06                        sta MetatileBuffer+10
0995F A2 0B                           ldx #$0b
09961 A0 01                           ldy #$01              ;now render the water underneath
09963 A9 87                           lda #$87
09965 4C 7D 9B                        jmp RenderUnderPart
09968                           
09968                           ;--------------------------------
09968                           
09968                           QuestionBlockRow_High:
09968 A9 03                           lda #$03    ;start on the fourth row
0996A 2C                              .db $2c     ;BIT instruction opcode
0996B                           
0996B                           QuestionBlockRow_Low:
0996B A9 07                           lda #$07             ;start on the eighth row
0996D 48                              pha                  ;save whatever row to the stack for now
0996E 20 AC 9B                        jsr ChkLrgObjLength  ;get low nybble and save as length
09971 68                              pla
09972 AA                              tax                  ;render question boxes with coins
09973 A9 C0                           lda #$c0
09975 9D A1 06                        sta MetatileBuffer,x
09978 60                              rts
09979                           
09979                           ;--------------------------------
09979                           
09979                           Bridge_High:
09979 A9 06                           lda #$06  ;start on the seventh row from top of screen
0997B 2C                              .db $2c   ;BIT instruction opcode
0997C                           
0997C                           Bridge_Middle:
0997C A9 07                           lda #$07  ;start on the eighth row
0997E 2C                              .db $2c   ;BIT instruction opcode
0997F                           
0997F                           Bridge_Low:
0997F A9 09                           lda #$09             ;start on the tenth row
09981 48                              pha                  ;save whatever row to the stack for now
09982 20 AC 9B                        jsr ChkLrgObjLength  ;get low nybble and save as length
09985 68                              pla
09986 AA                              tax                  ;render bridge railing
09987 A9 0B                           lda #$0b
09989 9D A1 06                        sta MetatileBuffer,x
0998C E8                              inx
0998D A0 00                           ldy #$00             ;now render the bridge itself
0998F A9 63                           lda #$63
09991 4C 7D 9B                        jmp RenderUnderPart
09994                           
09994                           ;--------------------------------
09994                           
09994                           FlagBalls_Residual:
09994 20 BB 9B                        jsr GetLrgObjAttrib  ;get low nybble from object byte
09997 A2 02                           ldx #$02             ;render flag balls on third row from top
09999 A9 6D                           lda #$6d             ;of screen downwards based on low nybble
0999B 4C 7D 9B                        jmp RenderUnderPart
0999E                           
0999E                           ;--------------------------------
0999E                           
0999E                           FlagpoleObject:
0999E A9 24                           lda #$24                 ;render flagpole ball on top
099A0 8D A1 06                        sta MetatileBuffer
099A3 A2 01                           ldx #$01                 ;now render the flagpole shaft
099A5 A0 08                           ldy #$08
099A7 A9 25                           lda #$25
099A9 20 7D 9B                        jsr RenderUnderPart
099AC A9 61                           lda #$61                 ;render solid block at the bottom
099AE 8D AB 06                        sta MetatileBuffer+10
099B1 20 CB 9B                        jsr GetAreaObjXPosition
099B4 38                              sec                      ;get pixel coordinate of where the flagpole is,
099B5 E9 08                           sbc #$08                 ;subtract eight pixels and use as horizontal
099B7 85 8C                           sta Enemy_X_Position+5   ;coordinate for the flag
099B9 AD 25 07                        lda CurrentPageLoc
099BC E9 00                           sbc #$00                 ;subtract borrow from page location and use as
099BE 85 73                           sta Enemy_PageLoc+5      ;page location for the flag
099C0 A9 30                           lda #$30
099C2 85 D4                           sta Enemy_Y_Position+5   ;set vertical coordinate for flag
099C4 A9 B0                           lda #$b0
099C6 8D 0D 01                        sta FlagpoleFNum_Y_Pos   ;set initial vertical coordinate for flagpole's floatey number
099C9 A9 30                           lda #FlagpoleFlagObject
099CB 85 1B                           sta Enemy_ID+5           ;set flag identifier, note that identifier and coordinates
099CD E6 14                           inc Enemy_Flag+5         ;use last space in enemy object buffer
099CF 60                              rts
099D0                           
099D0                           ;--------------------------------
099D0                           
099D0                           EndlessRope:
099D0 A2 00                           ldx #$00       ;render rope from the top to the bottom of screen
099D2 A0 0F                           ldy #$0f
099D4 4C E9 99                        jmp DrawRope
099D7                           
099D7                           BalancePlatRope:
099D7 8A                                  txa                 ;save object buffer offset for now
099D8 48                                  pha
099D9 A2 01                               ldx #$01            ;blank out all from second row to the bottom
099DB A0 0F                               ldy #$0f            ;with blank used for balance platform rope
099DD A9 44                               lda #$44
099DF 20 7D 9B                            jsr RenderUnderPart
099E2 68                                  pla                 ;get back object buffer offset
099E3 AA                                  tax
099E4 20 BB 9B                            jsr GetLrgObjAttrib ;get vertical length from lower nybble
099E7 A2 01                               ldx #$01
099E9 A9 40                     DrawRope: lda #$40            ;render the actual rope
099EB 4C 7D 9B                            jmp RenderUnderPart
099EE                           
099EE                           ;--------------------------------
099EE                           
099EE                           CoinMetatileData:
099EE C3 C2 C2 C2                     .db $c3, $c2, $c2, $c2
099F2                           
099F2                           RowOfCoins:
099F2 AC 4E 07                        ldy AreaType            ;get area type
099F5 B9 EE 99                        lda CoinMetatileData,y  ;load appropriate coin metatile
099F8 4C 44 9A                        jmp GetRow
099FB                           
