0823F                           
0823F                           WSelectBufferTemplate:
0823F 04 20 73 01 00 00               .db $04, $20, $73, $01, $00, $00
08245                           
08245                           GameMenuRoutine:
08245 A0 00                                   ldy #$00
08247 AD FC 06                                lda SavedJoypad1Bits        ;check to see if either player pressed
0824A 0D FD 06                                ora SavedJoypad2Bits        ;only the start button (either joypad)
0824D C9 10                                   cmp #Start_Button
0824F F0 04                                   beq StartGame
08251 C9 90                                   cmp #A_Button+Start_Button  ;check to see if A + start was pressed
08253 D0 03                                   bne ChkSelect               ;if not, branch to check select button
08255 4C D8 82                  StartGame:    jmp ChkContinue             ;if either start or A + start, execute here
08258 C9 20                     ChkSelect:    cmp #Select_Button          ;check to see if the select button was pressed
0825A F0 1A                                   beq SelectBLogic            ;if so, branch reset demo timer
0825C AE A2 07                                ldx DemoTimer               ;otherwise check demo timer
0825F D0 0B                                   bne ChkWorldSel             ;if demo timer not expired, branch to check world selection
08261 8D 80 07                                sta SelectTimer             ;set controller bits here if running demo
08264 20 6B 83                                jsr DemoEngine              ;run through the demo actions
08267 B0 60                                   bcs ResetTitle              ;if carry flag set, demo over, thus branch
08269 4C C0 82                                jmp RunDemo                 ;otherwise, run game engine for demo
0826C AE FC 07                  ChkWorldSel:  ldx WorldSelectEnableFlag   ;check to see if world selection has been enabled
0826F F0 4A                                   beq NullJoypad
08271 C9 40                                   cmp #B_Button               ;if so, check to see if the B button was pressed
08273 D0 46                                   bne NullJoypad
08275 C8                                      iny                         ;if so, increment Y and execute same code as select
08276 AD A2 07                  SelectBLogic: lda DemoTimer               ;if select or B pressed, check demo timer one last time
08279 F0 4E                                   beq ResetTitle              ;if demo timer expired, branch to reset title screen mode
0827B A9 18                                   lda #$18                    ;otherwise reset demo timer
0827D 8D A2 07                                sta DemoTimer
08280 AD 80 07                                lda SelectTimer             ;check select/B button timer
08283 D0 36                                   bne NullJoypad              ;if not expired, branch
08285 A9 10                                   lda #$10                    ;otherwise reset select button timer
08287 8D 80 07                                sta SelectTimer
0828A C0 01                                   cpy #$01                    ;was the B button pressed earlier?  if so, branch
0828C F0 0E                                   beq IncWorldSel             ;note this will not be run if world selection is disabled
0828E AD 7A 07                                lda NumberOfPlayers         ;if no, must have been the select button, therefore
08291 49 01                                   eor #%00000001              ;change number of players and draw icon accordingly
08293 8D 7A 07                                sta NumberOfPlayers
08296 20 25 83                                jsr DrawMushroomIcon
08299 4C BB 82                                jmp NullJoypad
0829C AE 6B 07                  IncWorldSel:  ldx WorldSelectNumber       ;increment world select number
0829F E8                                      inx
082A0 8A                                      txa
082A1 29 07                                   and #%00000111              ;mask out higher bits
082A3 8D 6B 07                                sta WorldSelectNumber       ;store as current world select number
082A6 20 0E 83                                jsr GoContinue
082A9 BD 3F 82                  UpdateShroom: lda WSelectBufferTemplate,x ;write template for world select in vram buffer
082AC 9D 00 03                                sta VRAM_Buffer1-1,x        ;do this until all bytes are written
082AF E8                                      inx
082B0 E0 06                                   cpx #$06
082B2 30 F5                                   bmi UpdateShroom
082B4 AC 5F 07                                ldy WorldNumber             ;get world number from variable and increment for
082B7 C8                                      iny                         ;proper display, and put in blank byte before
082B8 8C 04 03                                sty VRAM_Buffer1+3          ;null terminator
082BB A9 00                     NullJoypad:   lda #$00                    ;clear joypad bits for player 1
082BD 8D FC 06                                sta SavedJoypad1Bits
082C0 20 EA AE                  RunDemo:      jsr GameCoreRoutine         ;run game engine
082C3 A5 0E                                   lda GameEngineSubroutine    ;check to see if we're running lose life routine
082C5 C9 06                                   cmp #$06
082C7 D0 44                                   bne ExitMenu                ;if not, do not do all the resetting below
082C9 A9 00                     ResetTitle:   lda #$00                    ;reset game modes, disable
082CB 8D 70 07                                sta OperMode                ;sprite 0 check and disable
082CE 8D 72 07                                sta OperMode_Task           ;screen output
082D1 8D 22 07                                sta Sprite0HitDetectFlag
082D4 EE 74 07                                inc DisableScreenFlag
082D7 60                                      rts
082D8 AC A2 07                  ChkContinue:  ldy DemoTimer               ;if timer for demo has expired, reset modes
082DB F0 EC                                   beq ResetTitle
082DD 0A                                      asl                         ;check to see if A button was also pushed
082DE 90 06                                   bcc StartWorld1             ;if not, don't load continue function's world number
082E0 AD FD 07                                lda ContinueWorld           ;load previously saved world number for secret
082E3 20 0E 83                                jsr GoContinue              ;continue function when pressing A + start
082E6 20 03 9C                  StartWorld1:  jsr LoadAreaPointer
082E9 EE 5D 07                                inc Hidden1UpFlag           ;set 1-up box flag for both players
082EC EE 64 07                                inc OffScr_Hidden1UpFlag
082EF EE 57 07                                inc FetchNewGameTimerFlag   ;set fetch new game timer flag
082F2 EE 70 07                                inc OperMode                ;set next game mode
082F5 AD FC 07                                lda WorldSelectEnableFlag   ;if world select flag is on, then primary
082F8 8D 6A 07                                sta PrimaryHardMode         ;hard mode must be on as well
082FB A9 00                                   lda #$00
082FD 8D 72 07                                sta OperMode_Task           ;set game mode here, and clear demo timer
08300 8D A2 07                                sta DemoTimer
08303 A2 17                                   ldx #$17
08305 A9 00                                   lda #$00
08307 9D DD 07                  InitScores:   sta ScoreAndCoinDisplay,x   ;clear player scores and coin displays
0830A CA                                      dex
0830B 10 FA                                   bpl InitScores
0830D 60                        ExitMenu:     rts
0830E 8D 5F 07                  GoContinue:   sta WorldNumber             ;start both players at the first area
08311 8D 66 07                                sta OffScr_WorldNumber      ;of the previously saved world number
08314 A2 00                                   ldx #$00                    ;note that on power-up using this function
08316 8E 60 07                                stx AreaNumber              ;will make no difference
08319 8E 67 07                                stx OffScr_AreaNumber   
0831C 60                                      rts
