0CAFF                           ProcMoveRedPTroopa:
0CAFF B5 A0                               lda Enemy_Y_Speed,x
0CB01 1D 34 04                            ora Enemy_Y_MoveForce,x     ;check for any vertical force or speed
0CB04 D0 13                               bne MoveRedPTUpOrDown       ;branch if any found
0CB06 9D 17 04                            sta Enemy_YMF_Dummy,x       ;initialize something here
0CB09 B5 CF                               lda Enemy_Y_Position,x      ;check current vs. original vertical coordinate
0CB0B DD 01 04                            cmp RedPTroopaOrigXPos,x
0CB0E B0 09                               bcs MoveRedPTUpOrDown       ;if current => original, skip ahead to more code
0CB10 A5 09                               lda FrameCounter            ;get frame counter
0CB12 29 07                               and #%00000111              ;mask out all but 3 LSB
0CB14 D0 02                               bne NoIncPT                 ;if any bits set, branch to leave
0CB16 F6 CF                               inc Enemy_Y_Position,x      ;otherwise increment red paratroopa's vertical position
0CB18 60                        NoIncPT:  rts                         ;leave
0CB19                           
0CB19                           MoveRedPTUpOrDown:
0CB19 B5 CF                               lda Enemy_Y_Position,x      ;check current vs. central vertical coordinate
0CB1B D5 58                               cmp RedPTroopaCenterYPos,x
0CB1D 90 03                               bcc MovPTDwn                ;if current < central, jump to move downwards
0CB1F 4C 75 BF                            jmp MoveRedPTroopaUp        ;otherwise jump to move upwards
0CB22 4C 70 BF                  MovPTDwn: jmp MoveRedPTroopaDown      ;move downwards
