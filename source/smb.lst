0EFDF 85 00                             sta $00
0EFE1 BD 18 EE                          lda PlayerGraphicsTable+1,x  ;now load right side
0EFE4 20 B2 EB                          jsr DrawOneSpriteRow
0EFE7 C6 07                             dec $07                      ;decrement rows of sprites to draw
0EFE9 D0 F1                             bne DrawPlayerLoop           ;do this until all rows are drawn
0EFEB 60                                rts
