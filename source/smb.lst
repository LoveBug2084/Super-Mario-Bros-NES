0BAF7 B9 1E 00                            lda Enemy_State,y          ;get enemy object state
0BAFA 29 F7                               and #%11110111             ;mask out d3
0BAFC 99 1E 00                            sta Enemy_State,y          ;store new state
0BAFF B6 46                               ldx Enemy_MovingDir,y      ;get enemy's moving direction
0BB01 CA                                  dex                        ;decrement to use as offset
