0E30C B9 AC 04                          lda BoundingBox_UL_XPos,y  ;check left-side edge of bounding box for offscreen
0E30F 10 11                             bpl NoOfs2                 ;coordinates, and branch if still on the screen
0E311 C9 A0                             cmp #$a0                   ;check to see if left-side edge is in the middle of the
0E313 90 0D                             bcc NoOfs2                 ;screen or really offscreen, and branch if still on
0E315 A9 00                             lda #$00
0E317 BE AE 04                          ldx BoundingBox_DR_XPos,y  ;check right-side edge of bounding box for offscreen
0E31A 10 03                             bpl SOLft                  ;coordinates, branch if still onscreen
0E31C 99 AE 04                          sta BoundingBox_DR_XPos,y  ;store offscreen value for right side
0E31F 99 AC 04                  SOLft:  sta BoundingBox_UL_XPos,y  ;store offscreen value for left side
