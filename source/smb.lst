0F0BA C0 0A                              cpy #$0a                     ;check for preset upper extent
0F0BC 90 05                              bcc CSzNext                  ;if not there yet, skip ahead to use
0F0BE A0 00                              ldy #$00                     ;otherwise initialize both grow/shrink flag
0F0C0 8C 0B 07                           sty PlayerChangeSizeFlag     ;and animation frame control
0F0C3 8C 0D 07                  CSzNext: sty PlayerAnimCtrl           ;store proper frame control
0F0C6 AD 54 07                  GorSLog: lda PlayerSize               ;get player's size
0F0C9 D0 0C                              bne ShrinkPlayer             ;if player small, skip ahead to next part
0F0CB B9 9C F0                           lda ChangeSizeOffsetAdder,y  ;get offset adder based on frame control as offset
