09116                           
09116                           PlayerStarting_X_Pos:
09116 28 18                           .db $28, $18
09118 38 28                           .db $38, $28
0911A                           
0911A                           AltYPosOffset:
0911A 08 00                           .db $08, $00
0911C                           
0911C                           PlayerStarting_Y_Pos:
0911C 00 20 B0 50 00 00 B0 B0         .db $00, $20, $b0, $50, $00, $00, $b0, $b0
09124 F0                              .db $f0
09125                           
09125                           PlayerBGPriorityData:
09125 00 20 00 00 00 00 00 00         .db $00, $20, $00, $00, $00, $00, $00, $00
0912D                           
0912D                           GameTimerData:
0912D 20                              .db $20 ;dummy byte, used as part of bg priority data
0912E 04 03 02                        .db $04, $03, $02
09131                           
09131                           Entrance_GameTimerSetup:
09131 AD 1A 07                            lda ScreenLeft_PageLoc      ;set current page for area objects
09134 85 6D                               sta Player_PageLoc          ;as page location for player
09136 A9 28                               lda #$28                    ;store value here
09138 8D 0A 07                            sta VerticalForceDown       ;for fractional movement downwards if necessary
0913B A9 01                               lda #$01                    ;set high byte of player position and
0913D 85 33                               sta PlayerFacingDir         ;set facing direction so that player faces right
0913F 85 B5                               sta Player_Y_HighPos
09141 A9 00                               lda #$00                    ;set player state to on the ground by default
09143 85 1D                               sta Player_State
09145 CE 90 04                            dec Player_CollisionBits    ;initialize player's collision bits
09148 A0 00                               ldy #$00                    ;initialize halfway page
0914A 8C 5B 07                            sty HalfwayPage      
0914D AD 4E 07                            lda AreaType                ;check area type
09150 D0 01                               bne ChkStPos                ;if water type, set swimming flag, otherwise do not set
09152 C8                                  iny
09153 8C 04 07                  ChkStPos: sty SwimmingFlag
09156 AE 10 07                            ldx PlayerEntranceCtrl      ;get starting position loaded from header
09159 AC 52 07                            ldy AltEntranceControl      ;check alternate mode of entry flag for 0 or 1
0915C F0 07                               beq SetStPos
0915E C0 01                               cpy #$01
09160 F0 03                               beq SetStPos
09162 BE 18 91                            ldx AltYPosOffset-2,y       ;if not 0 or 1, override $0710 with new offset in X
09165 B9 16 91                  SetStPos: lda PlayerStarting_X_Pos,y  ;load appropriate horizontal position
09168 85 86                               sta Player_X_Position       ;and vertical positions for the player, using
0916A BD 1C 91                            lda PlayerStarting_Y_Pos,x  ;AltEntranceControl as offset for horizontal and either $0710
0916D 85 CE                               sta Player_Y_Position       ;or value that overwrote $0710 as offset for vertical
0916F BD 25 91                            lda PlayerBGPriorityData,x
09172 8D C4 03                            sta Player_SprAttrib        ;set player sprite attributes using offset in X
09175 20 F1 85                            jsr GetPlayerColors         ;get appropriate player palette
09178 AC 15 07                            ldy GameTimerSetting        ;get timer control value from header
0917B F0 1A                               beq ChkOverR                ;if set to zero, branch (do not use dummy byte for this)
0917D AD 57 07                            lda FetchNewGameTimerFlag   ;do we need to set the game timer? if not, use 
09180 F0 15                               beq ChkOverR                ;old game timer setting
09182 B9 2D 91                            lda GameTimerData,y         ;if game timer is set and game timer flag is also set,
09185 8D F8 07                            sta GameTimerDisplay        ;use value of game timer control for first digit of game timer
09188 A9 01                               lda #$01
0918A 8D FA 07                            sta GameTimerDisplay+2      ;set last digit of game timer to 1
0918D 4A                                  lsr
0918E 8D F9 07                            sta GameTimerDisplay+1      ;set second digit of game timer
09191 8D 57 07                            sta FetchNewGameTimerFlag   ;clear flag for game timer reset
09194 8D 9F 07                            sta StarInvincibleTimer     ;clear star mario timer
09197 AC 58 07                  ChkOverR: ldy JoypadOverride          ;if controller bits not set, branch to skip this part
0919A F0 14                               beq ChkSwimE
0919C A9 03                               lda #$03                    ;set player state to climbing
0919E 85 1D                               sta Player_State
091A0 A2 00                               ldx #$00                    ;set offset for first slot, for block object
091A2 20 84 BD                            jsr InitBlock_XY_Pos
091A5 A9 F0                               lda #$f0                    ;set vertical coordinate for block object
091A7 85 D7                               sta Block_Y_Position
091A9 A2 05                               ldx #$05                    ;set offset in X for last enemy object buffer slot
091AB A0 00                               ldy #$00                    ;set offset in Y for object coordinates used earlier
091AD 20 1E B9                            jsr Setup_Vine              ;do a sub to grow vine
091B0 AC 4E 07                  ChkSwimE: ldy AreaType                ;if level not water-type,
091B3 D0 03                               bne SetPESub                ;skip this subroutine
091B5 20 0B B7                            jsr SetupBubble             ;otherwise, execute sub to set up air bubbles
091B8 A9 07                     SetPESub: lda #$07                    ;set to run player entrance subroutine
091BA 85 0E                               sta GameEngineSubroutine    ;on the next frame of game engine
091BC 60                                  rts
