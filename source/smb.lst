099FB                           
099FB                           C_ObjectRow:
099FB 06 07 08                        .db $06, $07, $08
099FE                           
099FE                           C_ObjectMetatile:
099FE C5 0C 89                        .db $c5, $0c, $89
09A01                           
09A01                           CastleBridgeObj:
09A01 A0 0C                           ldy #$0c                  ;load length of 13 columns
09A03 20 AF 9B                        jsr ChkLrgObjFixedLength
09A06 4C 0E 9A                        jmp ChainObj
09A09                           
09A09                           AxeObj:
09A09 A9 08                           lda #$08                  ;load bowser's palette into sprite portion of palette
09A0B 8D 73 07                        sta VRAM_Buffer_AddrCtrl
09A0E                           
09A0E                           ChainObj:
09A0E A4 00                           ldy $00                   ;get value loaded earlier from decoder
09A10 BE F9 99                        ldx C_ObjectRow-2,y       ;get appropriate row and metatile for object
09A13 B9 FC 99                        lda C_ObjectMetatile-2,y
09A16 4C 20 9A                        jmp ColObj
09A19                           
09A19                           EmptyBlock:
09A19 20 BB 9B                          jsr GetLrgObjAttrib  ;get row location
09A1C A6 07                             ldx $07
09A1E A9 C4                             lda #$c4
09A20 A0 00                     ColObj: ldy #$00             ;column length of 1
09A22 4C 7D 9B                          jmp RenderUnderPart
09A25                           
09A25                           ;--------------------------------
09A25                           
09A25                           SolidBlockMetatiles:
09A25 69 61 61 62                     .db $69, $61, $61, $62
09A29                           
09A29                           BrickMetatiles:
09A29 22 51 52 52                     .db $22, $51, $52, $52
09A2D 88                              .db $88 ;used only by row of bricks object
09A2E                           
09A2E                           RowOfBricks:
09A2E AC 4E 07                              ldy AreaType           ;load area type obtained from area offset pointer
09A31 AD 43 07                              lda CloudTypeOverride  ;check for cloud type override
09A34 F0 02                                 beq DrawBricks
09A36 A0 04                                 ldy #$04               ;if cloud type, override area type
09A38 B9 29 9A                  DrawBricks: lda BrickMetatiles,y   ;get appropriate metatile
09A3B 4C 44 9A                              jmp GetRow             ;and go render it
09A3E                           
09A3E                           RowOfSolidBlocks:
09A3E AC 4E 07                           ldy AreaType               ;load area type obtained from area offset pointer
09A41 B9 25 9A                           lda SolidBlockMetatiles,y  ;get metatile
09A44 48                        GetRow:  pha                        ;store metatile here
09A45 20 AC 9B                           jsr ChkLrgObjLength        ;get row number, load length
09A48 A6 07                     DrawRow: ldx $07
09A4A A0 00                              ldy #$00                   ;set vertical height of 1
09A4C 68                                 pla
09A4D 4C 7D 9B                           jmp RenderUnderPart        ;render object
09A50                           
09A50                           ColumnOfBricks:
09A50 AC 4E 07                        ldy AreaType          ;load area type obtained from area offset
09A53 B9 29 9A                        lda BrickMetatiles,y  ;get metatile (no cloud override as for row)
09A56 4C 5F 9A                        jmp GetRow2
09A59                           
09A59                           ColumnOfSolidBlocks:
09A59 AC 4E 07                           ldy AreaType               ;load area type obtained from area offset
09A5C B9 25 9A                           lda SolidBlockMetatiles,y  ;get metatile
09A5F 48                        GetRow2: pha                        ;save metatile to stack for now
09A60 20 BB 9B                           jsr GetLrgObjAttrib        ;get length and row
09A63 68                                 pla                        ;restore metatile
09A64 A6 07                              ldx $07                    ;get starting row
09A66 4C 7D 9B                           jmp RenderUnderPart        ;now render the column
09A69                           
09A69                           ;--------------------------------
09A69                           
09A69                           BulletBillCannon:
09A69 20 BB 9B                               jsr GetLrgObjAttrib      ;get row and length of bullet bill cannon
09A6C A6 07                                  ldx $07                  ;start at first row
09A6E A9 64                                  lda #$64                 ;render bullet bill cannon
09A70 9D A1 06                               sta MetatileBuffer,x
09A73 E8                                     inx
09A74 88                                     dey                      ;done yet?
09A75 30 0E                                  bmi SetupCannon
09A77 A9 65                                  lda #$65                 ;if not, render middle part
09A79 9D A1 06                               sta MetatileBuffer,x
09A7C E8                                     inx
09A7D 88                                     dey                      ;done yet?
09A7E 30 05                                  bmi SetupCannon
09A80 A9 66                                  lda #$66                 ;if not, render bottom until length expires
09A82 20 7D 9B                               jsr RenderUnderPart
09A85 AE 6A 04                  SetupCannon: ldx Cannon_Offset        ;get offset for data used by cannons and whirlpools
09A88 20 D3 9B                               jsr GetAreaObjYPosition  ;get proper vertical coordinate for cannon
09A8B 9D 77 04                               sta Cannon_Y_Position,x  ;and store it here
09A8E AD 25 07                               lda CurrentPageLoc
09A91 9D 6B 04                               sta Cannon_PageLoc,x     ;store page number for cannon here
09A94 20 CB 9B                               jsr GetAreaObjXPosition  ;get proper horizontal coordinate for cannon
09A97 9D 71 04                               sta Cannon_X_Position,x  ;and store it here
09A9A E8                                     inx
09A9B E0 06                                  cpx #$06                 ;increment and check offset
09A9D 90 02                                  bcc StrCOffset           ;if not yet reached sixth cannon, branch to save offset
09A9F A2 00                                  ldx #$00                 ;otherwise initialize it
09AA1 8E 6A 04                  StrCOffset:  stx Cannon_Offset        ;save new offset and leave
09AA4 60                                     rts
09AA5                           
09AA5                           ;--------------------------------
09AA5                           
09AA5                           StaircaseHeightData:
09AA5 07 07 06 05 04 03 02 01..       .db $07, $07, $06, $05, $04, $03, $02, $01, $00
09AAE                           
09AAE                           StaircaseRowData:
09AAE 03 03 04 05 06 07 08 09..       .db $03, $03, $04, $05, $06, $07, $08, $09, $0a
09AB7                           
09AB7                           StaircaseObject:
09AB7 20 AC 9B                             jsr ChkLrgObjLength       ;check and load length
09ABA 90 05                                bcc NextStair             ;if length already loaded, skip init part
09ABC A9 09                                lda #$09                  ;start past the end for the bottom
09ABE 8D 34 07                             sta StaircaseControl      ;of the staircase
09AC1 CE 34 07                  NextStair: dec StaircaseControl      ;move onto next step (or first if starting)
09AC4 AC 34 07                             ldy StaircaseControl
09AC7 BE AE 9A                             ldx StaircaseRowData,y    ;get starting row and height to render
09ACA B9 A5 9A                             lda StaircaseHeightData,y
09ACD A8                                   tay
09ACE A9 61                                lda #$61                  ;now render solid block staircase
09AD0 4C 7D 9B                             jmp RenderUnderPart
09AD3                           
09AD3                           ;--------------------------------
09AD3                           
09AD3                           Jumpspring:
09AD3 20 BB 9B                        jsr GetLrgObjAttrib
09AD6 20 4A 99                        jsr FindEmptyEnemySlot      ;find empty space in enemy object buffer
09AD9 20 CB 9B                        jsr GetAreaObjXPosition     ;get horizontal coordinate for jumpspring
09ADC 95 87                           sta Enemy_X_Position,x      ;and store
09ADE AD 25 07                        lda CurrentPageLoc          ;store page location of jumpspring
09AE1 95 6E                           sta Enemy_PageLoc,x
09AE3 20 D3 9B                        jsr GetAreaObjYPosition     ;get vertical coordinate for jumpspring
09AE6 95 CF                           sta Enemy_Y_Position,x      ;and store
09AE8 95 58                           sta Jumpspring_FixedYPos,x  ;store as permanent coordinate here
09AEA A9 32                           lda #JumpspringObject
09AEC 95 16                           sta Enemy_ID,x              ;write jumpspring object to enemy object buffer
09AEE A0 01                           ldy #$01
09AF0 94 B6                           sty Enemy_Y_HighPos,x       ;store vertical high byte
09AF2 F6 0F                           inc Enemy_Flag,x            ;set flag for enemy object buffer
09AF4 A6 07                           ldx $07
09AF6 A9 67                           lda #$67                    ;draw metatiles in two rows where jumpspring is
09AF8 9D A1 06                        sta MetatileBuffer,x
09AFB A9 68                           lda #$68
09AFD 9D A2 06                        sta MetatileBuffer+1,x
09B00 60                              rts
09B01                           
09B01                           ;--------------------------------
09B01                           ;$07 - used to save ID of brick object
09B01                           
09B01                           Hidden1UpBlock:
09B01 AD 5D 07                        lda Hidden1UpFlag  ;if flag not set, do not render object
09B04 F0 36                           beq ExitDecBlock
09B06 A9 00                           lda #$00           ;if set, init for the next one
09B08 8D 5D 07                        sta Hidden1UpFlag
09B0B 4C 19 9B                        jmp BrickWithItem  ;jump to code shared with unbreakable bricks
09B0E                           
09B0E                           QuestionBlock:
09B0E 20 36 9B                        jsr GetAreaObjectID ;get value from level decoder routine
09B11 4C 2C 9B                        jmp DrawQBlk        ;go to render it
09B14                           
09B14                           BrickWithCoins:
09B14 A9 00                           lda #$00                 ;initialize multi-coin timer flag
09B16 8D BC 06                        sta BrickCoinTimerFlag
09B19                           
09B19                           BrickWithItem:
09B19 20 36 9B                            jsr GetAreaObjectID         ;save area object ID
09B1C 84 07                               sty $07              
09B1E A9 00                               lda #$00                    ;load default adder for bricks with lines
09B20 AC 4E 07                            ldy AreaType                ;check level type for ground level
09B23 88                                  dey
09B24 F0 02                               beq BWithL                  ;if ground type, do not start with 5
09B26 A9 05                               lda #$05                    ;otherwise use adder for bricks without lines
09B28 18                        BWithL:   clc                         ;add object ID to adder
09B29 65 07                               adc $07
09B2B A8                                  tay                         ;use as offset for metatile
09B2C B9 E8 BD                  DrawQBlk: lda BrickQBlockMetatiles,y  ;get appropriate metatile for brick (question block
09B2F 48                                  pha                         ;if branched to here from question block routine)
09B30 20 BB 9B                            jsr GetLrgObjAttrib         ;get row from location byte
09B33 4C 48 9A                            jmp DrawRow                 ;now render the object
09B36                           
09B36                           GetAreaObjectID:
09B36 A5 00                                   lda $00    ;get value saved from area parser routine
09B38 38                                      sec
09B39 E9 00                                   sbc #$00   ;possibly residual code
09B3B A8                                      tay        ;save to Y
09B3C 60                        ExitDecBlock: rts
09B3D                           
09B3D                           ;--------------------------------
09B3D                           
09B3D                           HoleMetatiles:
09B3D 87 00 00 00                     .db $87, $00, $00, $00
09B41                           
09B41                           Hole_Empty:
09B41 20 AC 9B                              jsr ChkLrgObjLength          ;get lower nybble and save as length
09B44 90 2D                                 bcc NoWhirlP                 ;skip this part if length already loaded
09B46 AD 4E 07                              lda AreaType                 ;check for water type level
09B49 D0 28                                 bne NoWhirlP                 ;if not water type, skip this part
09B4B AE 6A 04                              ldx Whirlpool_Offset         ;get offset for data used by cannons and whirlpools
09B4E 20 CB 9B                              jsr GetAreaObjXPosition      ;get proper vertical coordinate of where we're at
09B51 38                                    sec
09B52 E9 10                                 sbc #$10                     ;subtract 16 pixels
09B54 9D 71 04                              sta Whirlpool_LeftExtent,x   ;store as left extent of whirlpool
09B57 AD 25 07                              lda CurrentPageLoc           ;get page location of where we're at
09B5A E9 00                                 sbc #$00                     ;subtract borrow
09B5C 9D 6B 04                              sta Whirlpool_PageLoc,x      ;save as page location of whirlpool
09B5F C8                                    iny
09B60 C8                                    iny                          ;increment length by 2
09B61 98                                    tya
09B62 0A                                    asl                          ;multiply by 16 to get size of whirlpool
09B63 0A                                    asl                          ;note that whirlpool will always be
09B64 0A                                    asl                          ;two blocks bigger than actual size of hole
09B65 0A                                    asl                          ;and extend one block beyond each edge
09B66 9D 77 04                              sta Whirlpool_Length,x       ;save size of whirlpool here
09B69 E8                                    inx
09B6A E0 05                                 cpx #$05                     ;increment and check offset
09B6C 90 02                                 bcc StrWOffset               ;if not yet reached fifth whirlpool, branch to save offset
09B6E A2 00                                 ldx #$00                     ;otherwise initialize it
09B70 8E 6A 04                  StrWOffset: stx Whirlpool_Offset         ;save new offset here
09B73 AE 4E 07                  NoWhirlP:   ldx AreaType                 ;get appropriate metatile, then
09B76 BD 3D 9B                              lda HoleMetatiles,x          ;render the hole proper
09B79 A2 08                                 ldx #$08
09B7B A0 0F                                 ldy #$0f                     ;start at ninth row and go to bottom, run RenderUnderPart
09B7D                           
09B7D                           ;--------------------------------
09B7D                           
09B7D                           RenderUnderPart:
09B7D 8C 35 07                               sty AreaObjectHeight  ;store vertical length to render
09B80 BC A1 06                               ldy MetatileBuffer,x  ;check current spot to see if there's something
09B83 F0 18                                  beq DrawThisRow       ;we need to keep, if nothing, go ahead
09B85 C0 17                                  cpy #$17
09B87 F0 17                                  beq WaitOneRow        ;if middle part (tree ledge), wait until next row
09B89 C0 1A                                  cpy #$1a
09B8B F0 13                                  beq WaitOneRow        ;if middle part (mushroom ledge), wait until next row
09B8D C0 C0                                  cpy #$c0
09B8F F0 0C                                  beq DrawThisRow       ;if question block w/ coin, overwrite
09B91 C0 C0                                  cpy #$c0
09B93 B0 0B                                  bcs WaitOneRow        ;if any other metatile with palette 3, wait until next row
09B95 C0 54                                  cpy #$54
09B97 D0 04                                  bne DrawThisRow       ;if cracked rock terrain, overwrite
09B99 C9 50                                  cmp #$50
09B9B F0 03                                  beq WaitOneRow        ;if stem top of mushroom, wait until next row
09B9D 9D A1 06                  DrawThisRow: sta MetatileBuffer,x  ;render contents of A from routine that called this
09BA0 E8                        WaitOneRow:  inx
09BA1 E0 0D                                  cpx #$0d              ;stop rendering if we're at the bottom of the screen
09BA3 B0 06                                  bcs ExitUPartR
09BA5 AC 35 07                               ldy AreaObjectHeight  ;decrement, and stop rendering if there is no more length
09BA8 88                                     dey
09BA9 10 D2                                  bpl RenderUnderPart
09BAB 60                        ExitUPartR:  rts
09BAC                           
09BAC                           ;--------------------------------
09BAC                           
09BAC                           ChkLrgObjLength:
09BAC 20 BB 9B                          jsr GetLrgObjAttrib     ;get row location and size (length if branched to from here)
09BAF                           
09BAF                           ChkLrgObjFixedLength:
09BAF BD 30 07                          lda AreaObjectLength,x  ;check for set length counter
09BB2 18                                clc                     ;clear carry flag for not just starting
09BB3 10 05                             bpl LenSet              ;if counter not set, load it, otherwise leave alone
09BB5 98                                tya                     ;save length into length counter
09BB6 9D 30 07                          sta AreaObjectLength,x
09BB9 38                                sec                     ;set carry flag if just starting
09BBA 60                        LenSet: rts
09BBB                           
09BBB                           
09BBB                           GetLrgObjAttrib:
09BBB BC 2D 07                        ldy AreaObjOffsetBuffer,x ;get offset saved from area obj decoding routine
09BBE B1 E7                           lda (AreaData),y          ;get first byte of level object
09BC0 29 0F                           and #%00001111
09BC2 85 07                           sta $07                   ;save row location
09BC4 C8                              iny
09BC5 B1 E7                           lda (AreaData),y          ;get next byte, save lower nybble (length or height)
09BC7 29 0F                           and #%00001111            ;as Y, then leave
09BC9 A8                              tay
09BCA 60                              rts
09BCB                           
09BCB                           ;--------------------------------
09BCB                           
09BCB                           GetAreaObjXPosition:
09BCB AD 26 07                        lda CurrentColumnPos    ;multiply current offset where we're at by 16
09BCE 0A                              asl                     ;to obtain horizontal pixel coordinate
09BCF 0A                              asl
09BD0 0A                              asl
09BD1 0A                              asl
09BD2 60                              rts
09BD3                           
09BD3                           ;--------------------------------
09BD3                           
09BD3                           GetAreaObjYPosition:
09BD3 A5 07                           lda $07  ;multiply value by 16
09BD5 0A                              asl
09BD6 0A                              asl      ;this will give us the proper vertical pixel coordinate
09BD7 0A                              asl
09BD8 0A                              asl
09BD9 18                              clc
09BDA 69 20                           adc #32  ;add 32 pixels for the status bar
09BDC 60                              rts
09BDD                           
09BDD                           ;-------------------------------------------------------------------------------------
09BDD                           ;$06-$07 - used to store block buffer address used as indirect
09BDD                           
09BDD                           BlockBufferAddr:
09BDD 00 D0                           .db <Block_Buffer_1, <Block_Buffer_2
09BDF 05 05                           .db >Block_Buffer_1, >Block_Buffer_2
09BE1                           
09BE1                           GetBlockBufferAddr:
09BE1 48                              pha                      ;take value of A, save
09BE2 4A                              lsr                      ;move high nybble to low
09BE3 4A                              lsr
09BE4 4A                              lsr
09BE5 4A                              lsr
09BE6 A8                              tay                      ;use nybble as pointer to high byte
09BE7 B9 DF 9B                        lda BlockBufferAddr+2,y  ;of indirect here
09BEA 85 07                           sta $07
09BEC 68                              pla
09BED 29 0F                           and #%00001111           ;pull from stack, mask out high nybble
09BEF 18                              clc
09BF0 79 DD 9B                        adc BlockBufferAddr,y    ;add to low byte
09BF3 85 06                           sta $06                  ;store here and leave
09BF5 60                              rts
09BF6                           
09BF6                           ;-------------------------------------------------------------------------------------
09BF6                           
09BF6                           ;unused space
09BF6 FF FF                           .db $ff, $ff
09BF8                           
09BF8                           ;-------------------------------------------------------------------------------------
09BF8                           
09BF8                           AreaDataOfsLoopback:
09BF8 12 36 0E 0E 0E 32 32 32..       .db $12, $36, $0e, $0e, $0e, $32, $32, $32, $0a, $26, $40
09C03                           
09C03                           ;-------------------------------------------------------------------------------------
09C03                           
09C03                           LoadAreaPointer:
09C03 20 13 9C                               jsr FindAreaPointer  ;find it and store it here
09C06 8D 50 07                               sta AreaPointer
09C09 29 60                     GetAreaType: and #%01100000       ;mask out all but d6 and d5
09C0B 0A                                     asl
09C0C 2A                                     rol
09C0D 2A                                     rol
09C0E 2A                                     rol                  ;make %0xx00000 into %000000xx
09C0F 8D 4E 07                               sta AreaType         ;save 2 MSB as area type
09C12 60                                     rts
09C13                           
09C13                           FindAreaPointer:
09C13 AC 5F 07                        ldy WorldNumber        ;load offset from world variable
09C16 B9 B4 9C                        lda WorldAddrOffsets,y
09C19 18                              clc                    ;add area number used to find data
09C1A 6D 60 07                        adc AreaNumber
09C1D A8                              tay
09C1E B9 BC 9C                        lda AreaAddrOffsets,y  ;from there we have our area pointer
09C21 60                              rts
09C22                           
09C22                           
09C22                           GetAreaDataAddrs:
09C22 AD 50 07                              lda AreaPointer          ;use 2 MSB for Y
09C25 20 09 9C                              jsr GetAreaType
09C28 A8                                    tay
09C29 AD 50 07                              lda AreaPointer          ;mask out all but 5 LSB
09C2C 29 1F                                 and #%00011111
09C2E 8D 4F 07                              sta AreaAddrsLOffset     ;save as low offset
09C31 B9 E0 9C                              lda EnemyAddrHOffsets,y  ;load base value with 2 altered MSB,
09C34 18                                    clc                      ;then add base value to 5 LSB, result
09C35 6D 4F 07                              adc AreaAddrsLOffset     ;becomes offset for level data
09C38 A8                                    tay
09C39 B9 E4 9C                              lda EnemyDataAddrLow,y   ;use offset to load pointer
09C3C 85 E9                                 sta EnemyDataLow
09C3E B9 06 9D                              lda EnemyDataAddrHigh,y
09C41 85 EA                                 sta EnemyDataHigh
09C43 AC 4E 07                              ldy AreaType             ;use area type as offset
09C46 B9 28 9D                              lda AreaDataHOffsets,y   ;do the same thing but with different base value
09C49 18                                    clc
09C4A 6D 4F 07                              adc AreaAddrsLOffset        
09C4D A8                                    tay
09C4E B9 2C 9D                              lda AreaDataAddrLow,y    ;use this offset to load another pointer
09C51 85 E7                                 sta AreaDataLow
09C53 B9 4E 9D                              lda AreaDataAddrHigh,y
09C56 85 E8                                 sta AreaDataHigh
09C58 A0 00                                 ldy #$00                 ;load first byte of header
09C5A B1 E7                                 lda (AreaData),y     
09C5C 48                                    pha                      ;save it to the stack for now
09C5D 29 07                                 and #%00000111           ;save 3 LSB for foreground scenery or bg color control
09C5F C9 04                                 cmp #$04
09C61 90 05                                 bcc StoreFore
09C63 8D 44 07                              sta BackgroundColorCtrl  ;if 4 or greater, save value here as bg color control
09C66 A9 00                                 lda #$00
09C68 8D 41 07                  StoreFore:  sta ForegroundScenery    ;if less, save value here as foreground scenery
09C6B 68                                    pla                      ;pull byte from stack and push it back
09C6C 48                                    pha
09C6D 29 38                                 and #%00111000           ;save player entrance control bits
09C6F 4A                                    lsr                      ;shift bits over to LSBs
09C70 4A                                    lsr
09C71 4A                                    lsr
09C72 8D 10 07                              sta PlayerEntranceCtrl       ;save value here as player entrance control
09C75 68                                    pla                      ;pull byte again but do not push it back
09C76 29 C0                                 and #%11000000           ;save 2 MSB for game timer setting
09C78 18                                    clc
09C79 2A                                    rol                      ;rotate bits over to LSBs
09C7A 2A                                    rol
09C7B 2A                                    rol
09C7C 8D 15 07                              sta GameTimerSetting     ;save value here as game timer setting
09C7F C8                                    iny
09C80 B1 E7                                 lda (AreaData),y         ;load second byte of header
09C82 48                                    pha                      ;save to stack
09C83 29 0F                                 and #%00001111           ;mask out all but lower nybble
09C85 8D 27 07                              sta TerrainControl
09C88 68                                    pla                      ;pull and push byte to copy it to A
09C89 48                                    pha
09C8A 29 30                                 and #%00110000           ;save 2 MSB for background scenery type
09C8C 4A                                    lsr
09C8D 4A                                    lsr                      ;shift bits to LSBs
09C8E 4A                                    lsr
09C8F 4A                                    lsr
09C90 8D 42 07                              sta BackgroundScenery    ;save as background scenery
09C93 68                                    pla           
09C94 29 C0                                 and #%11000000
09C96 18                                    clc
09C97 2A                                    rol                      ;rotate bits over to LSBs
09C98 2A                                    rol
09C99 2A                                    rol
09C9A C9 03                                 cmp #%00000011           ;if set to 3, store here
09C9C D0 05                                 bne StoreStyle           ;and nullify other value
09C9E 8D 43 07                              sta CloudTypeOverride    ;otherwise store value in other place
09CA1 A9 00                                 lda #$00
09CA3 8D 33 07                  StoreStyle: sta AreaStyle
09CA6 A5 E7                                 lda AreaDataLow          ;increment area data address by 2 bytes
09CA8 18                                    clc
09CA9 69 02                                 adc #$02
09CAB 85 E7                                 sta AreaDataLow
09CAD A5 E8                                 lda AreaDataHigh
09CAF 69 00                                 adc #$00
