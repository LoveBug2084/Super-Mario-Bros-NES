0EFEC                           ProcessPlayerAction:
0EFEC A5 1D                             lda Player_State      ;get player's state
0EFEE C9 03                             cmp #$03
0EFF0 F0 52                             beq ActionClimbing    ;if climbing, branch here
0EFF2 C9 02                             cmp #$02
0EFF4 F0 3E                             beq ActionFalling     ;if falling, branch here
0EFF6 C9 01                             cmp #$01
0EFF8 D0 11                             bne ProcOnGroundActs  ;if not jumping, branch here
0EFFA AD 04 07                          lda SwimmingFlag
