0F021 A5 45                             lda Player_MovingDir       ;otherwise check to see if moving direction
0F023 25 33                             and PlayerFacingDir        ;and facing direction are the same
0F025 D0 15                             bne ActionWalkRun          ;if moving direction = facing direction, branch, don't skid
0F027 C8                                iny                        ;otherwise increment to skid offset ($03)
