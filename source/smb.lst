0E617 99 00 02                          sta Sprite_Y_Position,y
0E61A 68                        SChk2:  pla                         ;get bits from stack
0E61B 0A                                asl                         ;rotate d6 into carry
0E61C 48                                pha                         ;save to stack
0E61D 90 05                             bcc SChk3
0E61F A9 F8                             lda #$f8                    ;if d6 was set, move second sprite offscreen
0E621 99 04 02                          sta Sprite_Y_Position+4,y
0E624 68                        SChk3:  pla                         ;get bits from stack
0E625 0A                                asl                         ;rotate d5 into carry
0E626 48                                pha                         ;save to stack
0E627 90 05                             bcc SChk4
0E629 A9 F8                             lda #$f8                    ;if d5 was set, move third sprite offscreen
0E62B 99 08 02                          sta Sprite_Y_Position+8,y
0E62E 68                        SChk4:  pla                         ;get bits from stack
0E62F 0A                                asl                         ;rotate d4 into carry
0E630 48                                pha                         ;save to stack
0E631 90 05                             bcc SChk5
0E633 A9 F8                             lda #$f8                    ;if d4 was set, move fourth sprite offscreen
0E635 99 0C 02                          sta Sprite_Y_Position+12,y
0E638 68                        SChk5:  pla                         ;get bits from stack
0E639 0A                                asl                         ;rotate d3 into carry
0E63A 48                                pha                         ;save to stack
0E63B 90 05                             bcc SChk6
0E63D A9 F8                             lda #$f8                    ;if d3 was set, move fifth sprite offscreen
0E63F 99 10 02                          sta Sprite_Y_Position+16,y
0E642 68                        SChk6:  pla                         ;get bits from stack
0E643 0A                                asl                         ;rotate d2 into carry
0E644 90 05                             bcc SLChk                   ;save to stack
0E646 A9 F8                             lda #$f8
0E648 99 14 02                          sta Sprite_Y_Position+20,y  ;if d2 was set, move sixth sprite offscreen
0E64B AD D1 03                  SLChk:  lda Enemy_OffscreenBits     ;check d7 of offscreen bits
0E64E 0A                                asl                         ;and if d7 is not set, skip sub
0E64F 90 03                             bcc ExDLPl
0E651 20 B3 E5                          jsr MoveSixSpritesOffscreen ;otherwise branch to move all sprites offscreen
