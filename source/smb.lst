0EC07 99 05 02                             sta Sprite_Tilenumber+4,y     ;and replace then with lineless brick tiles
0EC0A BD E8 03                  ChkRep:    lda Block_Metatile,x          ;check replacement metatile
0EC0D C9 C4                                cmp #$c4                      ;if not used block metatile, then
0EC0F D0 24                                bne BlkOffscr                 ;branch ahead to use current graphics
