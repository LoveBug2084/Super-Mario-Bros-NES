08340                           DemoActionData:
08340 01 80 02 81 41 80 01            .db $01, $80, $02, $81, $41, $80, $01
08347 42 C2 02 80 41 C1 41 C1         .db $42, $c2, $02, $80, $41, $c1, $41, $c1
0834F 01 C1 01 02 80 00               .db $01, $c1, $01, $02, $80, $00
08355                           
08355                           DemoTimingData:
08355 9B 10 18 05 2C 20 24            .db $9b, $10, $18, $05, $2c, $20, $24
0835C 15 5A 10 20 28 30 20 10         .db $15, $5a, $10, $20, $28, $30, $20, $10
08364 80 20 30 30 01 FF 00            .db $80, $20, $30, $30, $01, $ff, $00
0836B                           
0836B                           DemoEngine:
0836B AE 17 07                            ldx DemoAction         ;load current demo action
0836E AD 18 07                            lda DemoActionTimer    ;load current action timer
08371 D0 0D                               bne DoAction           ;if timer still counting down, skip
08373 E8                                  inx
08374 EE 17 07                            inc DemoAction         ;if expired, increment action, X, and
08377 38                                  sec                    ;set carry by default for demo over
08378 BD 54 83                            lda DemoTimingData-1,x ;get next timer
0837B 8D 18 07                            sta DemoActionTimer    ;store as current timer
0837E F0 0A                               beq DemoOver           ;if timer already at zero, skip
08380 BD 3F 83                  DoAction: lda DemoActionData-1,x ;get and perform action (current or next)
08383 8D FC 06                            sta SavedJoypad1Bits
08386 CE 18 07                            dec DemoActionTimer    ;decrement action timer
08389 18                                  clc                    ;clear carry if demo still going
0838A 60                        DemoOver: rts
0838B                           
0838B                           ;-------------------------------------------------------------------------------------
0838B                           
0838B                           VictoryMode:
0838B 20 A0 83                              jsr VictoryModeSubroutines  ;run victory mode subroutines
0838E AD 72 07                              lda OperMode_Task           ;get current task of victory mode
08391 F0 07                                 beq AutoPlayer              ;if on bridge collapse, skip enemy processing
08393 A2 00                                 ldx #$00
08395 86 08                                 stx ObjectOffset            ;otherwise reset enemy object offset 
08397 20 47 C0                              jsr EnemiesAndLoopsCore     ;and run enemy code
0839A 20 2A F1                  AutoPlayer: jsr RelativePlayerPosition  ;get player's relative coordinates
0839D 4C E9 EE                              jmp PlayerGfxHandler        ;draw the player, then leave
083A0                           
083A0                           VictoryModeSubroutines:
083A0 AD 72 07                        lda OperMode_Task
083A3 20 04 8E                        jsr JumpEngine
083A6                           
083A6 EC CF                           .dw BridgeCollapse
083A8 B0 83                           .dw SetupVictoryMode
083AA BD 83                           .dw PlayerVictoryWalk
083AC F6 83                           .dw PrintVictoryMessages
083AE 61 84                           .dw PlayerEndWorld
083B0                           
083B0                           ;-------------------------------------------------------------------------------------
083B0                           
083B0                           SetupVictoryMode:
083B0 AE 1B 07                        ldx ScreenRight_PageLoc  ;get page location of right side of screen
083B3 E8                              inx                      ;increment to next page
083B4 86 34                           stx DestinationPageLoc   ;store here
083B6 A9 08                           lda #EndOfCastleMusic
083B8 85 FC                           sta EventMusicQueue      ;play win castle music
083BA 4C 4E 87                        jmp IncModeTask_B        ;jump to set next major task in victory mode
083BD                           
083BD                           ;-------------------------------------------------------------------------------------
083BD                           
083BD                           PlayerVictoryWalk:
083BD A0 00                                  ldy #$00                ;set value here to not walk player by default
083BF 84 35                                  sty VictoryWalkControl
083C1 A5 6D                                  lda Player_PageLoc      ;get player's page location
083C3 C5 34                                  cmp DestinationPageLoc  ;compare with destination page location
083C5 D0 06                                  bne PerformWalk         ;if page locations don't match, branch
083C7 A5 86                                  lda Player_X_Position   ;otherwise get player's horizontal position
083C9 C9 60                                  cmp #$60                ;compare with preset horizontal position
083CB B0 03                                  bcs DontWalk            ;if still on other page, branch ahead
083CD E6 35                     PerformWalk: inc VictoryWalkControl  ;otherwise increment value and Y
083CF C8                                     iny                     ;note Y will be used to walk the player
083D0 98                        DontWalk:    tya                     ;put contents of Y in A and
083D1 20 E6 B0                               jsr AutoControlPlayer   ;use A to move player to the right or not
083D4 AD 1A 07                               lda ScreenLeft_PageLoc  ;check page location of left side of screen
083D7 C5 34                                  cmp DestinationPageLoc  ;against set value here
083D9 F0 16                                  beq ExitVWalk           ;branch if equal to change modes if necessary
083DB AD 68 07                               lda ScrollFractional
083DE 18                                     clc                     ;do fixed point math on fractional part of scroll
083DF 69 80                                  adc #$80        
083E1 8D 68 07                               sta ScrollFractional    ;save fractional movement amount
083E4 A9 01                                  lda #$01                ;set 1 pixel per frame
083E6 69 00                                  adc #$00                ;add carry from previous addition
083E8 A8                                     tay                     ;use as scroll amount
083E9 20 C4 AF                               jsr ScrollScreen        ;do sub to scroll the screen
083EC 20 6F AF                               jsr UpdScrollVar        ;do another sub to update screen and scroll variables
083EF E6 35                                  inc VictoryWalkControl  ;increment value to stay in this routine
083F1 A5 35                     ExitVWalk:   lda VictoryWalkControl  ;load value set here
083F3 F0 68                                  beq IncModeTask_A       ;if zero, branch to change modes
083F5 60                                     rts                     ;otherwise leave
083F6                           
083F6                           ;-------------------------------------------------------------------------------------
083F6                           
083F6                           PrintVictoryMessages:
083F6 AD 49 07                                 lda SecondaryMsgCounter   ;load secondary message counter
083F9 D0 48                                    bne IncMsgCounter         ;if set, branch to increment message counters
083FB AD 19 07                                 lda PrimaryMsgCounter     ;otherwise load primary message counter
083FE F0 18                                    beq ThankPlayer           ;if set to zero, branch to print first message
08400 C9 09                                    cmp #$09                  ;if at 9 or above, branch elsewhere (this comparison
08402 B0 3F                                    bcs IncMsgCounter         ;is residual code, counter never reaches 9)
08404 AC 5F 07                                 ldy WorldNumber           ;check world number
08407 C0 07                                    cpy #World8
08409 D0 09                                    bne MRetainerMsg          ;if not at world 8, skip to next part
0840B C9 03                                    cmp #$03                  ;check primary message counter again
0840D 90 34                                    bcc IncMsgCounter         ;if not at 3 yet (world 8 only), branch to increment
0840F E9 01                                    sbc #$01                  ;otherwise subtract one
08411 4C 18 84                                 jmp ThankPlayer           ;and skip to next part
08414 C9 02                     MRetainerMsg:  cmp #$02                  ;check primary message counter
08416 90 2B                                    bcc IncMsgCounter         ;if not at 2 yet (world 1-7 only), branch
08418 A8                        ThankPlayer:   tay                       ;put primary message counter into Y
08419 D0 08                                    bne SecondPartMsg         ;if counter nonzero, skip this part, do not print first message
0841B AD 53 07                                 lda CurrentPlayer         ;otherwise get player currently on the screen
0841E F0 14                                    beq EvalForMusic          ;if mario, branch
08420 C8                                       iny                       ;otherwise increment Y once for luigi and
08421 D0 11                                    bne EvalForMusic          ;do an unconditional branch to the same place
08423 C8                        SecondPartMsg: iny                       ;increment Y to do world 8's message
08424 AD 5F 07                                 lda WorldNumber
08427 C9 07                                    cmp #World8               ;check world number
08429 F0 09                                    beq EvalForMusic          ;if at world 8, branch to next part
0842B 88                                       dey                       ;otherwise decrement Y for world 1-7's message
0842C C0 04                                    cpy #$04                  ;if counter at 4 (world 1-7 only)
0842E B0 26                                    bcs SetEndTimer           ;branch to set victory end timer
08430 C0 03                                    cpy #$03                  ;if counter at 3 (world 1-7 only)
08432 B0 0F                                    bcs IncMsgCounter         ;branch to keep counting
08434 C0 03                     EvalForMusic:  cpy #$03                  ;if counter not yet at 3 (world 8 only), branch
08436 D0 04                                    bne PrintMsg              ;to print message only (note world 1-7 will only
08438 A9 04                                    lda #VictoryMusic         ;reach this code if counter = 0, and will always branch)
0843A 85 FC                                    sta EventMusicQueue       ;otherwise load victory music first (world 8 only)
0843C 98                        PrintMsg:      tya                       ;put primary message counter in A
0843D 18                                       clc                       ;add $0c or 12 to counter thus giving an appropriate value,
0843E 69 0C                                    adc #$0c                  ;($0c-$0d = first), ($0e = world 1-7's), ($0f-$12 = world 8's)
08440 8D 73 07                                 sta VRAM_Buffer_AddrCtrl  ;write message counter to vram address controller
08443 AD 49 07                  IncMsgCounter: lda SecondaryMsgCounter
08446 18                                       clc
08447 69 04                                    adc #$04                      ;add four to secondary message counter
08449 8D 49 07                                 sta SecondaryMsgCounter
0844C AD 19 07                                 lda PrimaryMsgCounter
0844F 69 00                                    adc #$00                      ;add carry to primary message counter
08451 8D 19 07                                 sta PrimaryMsgCounter
08454 C9 07                                    cmp #$07                      ;check primary counter one more time
08456 90 08                     SetEndTimer:   bcc ExitMsgs                  ;if not reached value yet, branch to leave
08458 A9 06                                    lda #$06
0845A 8D A1 07                                 sta WorldEndTimer             ;otherwise set world end timer
0845D EE 72 07                  IncModeTask_A: inc OperMode_Task             ;move onto next task in mode
08460 60                        ExitMsgs:      rts                           ;leave
08461                           
08461                           ;-------------------------------------------------------------------------------------
08461                           
08461                           PlayerEndWorld:
08461 AD A1 07                                 lda WorldEndTimer          ;check to see if world end timer expired
08464 D0 20                                    bne EndExitOne             ;branch to leave if not
08466 AC 5F 07                                 ldy WorldNumber            ;check world number
08469 C0 07                                    cpy #World8                ;if on world 8, player is done with game, 
0846B B0 1A                                    bcs EndChkBButton          ;thus branch to read controller
0846D A9 00                                    lda #$00
0846F 8D 60 07                                 sta AreaNumber             ;otherwise initialize area number used as offset
08472 8D 5C 07                                 sta LevelNumber            ;and level number control to start at area 1
08475 8D 72 07                                 sta OperMode_Task          ;initialize secondary mode of operation
08478 EE 5F 07                                 inc WorldNumber            ;increment world number to move onto the next world
0847B 20 03 9C                                 jsr LoadAreaPointer        ;get area address offset for the next area
0847E EE 57 07                                 inc FetchNewGameTimerFlag  ;set flag to load game timer from header
08481 A9 01                                    lda #GameModeValue
08483 8D 70 07                                 sta OperMode               ;set mode of operation to game mode
08486 60                        EndExitOne:    rts                        ;and leave
08487 AD FC 06                  EndChkBButton: lda SavedJoypad1Bits
0848A 0D FD 06                                 ora SavedJoypad2Bits       ;check to see if B button was pressed on
0848D 29 40                                    and #B_Button              ;either controller
0848F F0 0D                                    beq EndExitTwo             ;branch to leave if not
08491 A9 01                                    lda #$01                   ;otherwise set world selection flag
08493 8D FC 07                                 sta WorldSelectEnableFlag
08496 A9 FF                                    lda #$ff                   ;remove onscreen player's lives
08498 8D 5A 07                                 sta NumberofLives
0849B 20 48 92                                 jsr TerminateGame          ;do sub to continue other player or end game
0849E 60                        EndExitTwo:    rts                        ;leave
0849F                           
