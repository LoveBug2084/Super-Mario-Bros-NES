0EF07 F0 2B                             beq FindPlayerAction        ;branch and do not return
0EF09 20 34 EF                          jsr FindPlayerAction        ;otherwise jump and return
0EF0C A5 09                             lda FrameCounter
0EF0E 29 04                             and #%00000100              ;check frame counter for d2 set (8 frames every
0EF10 D0 21                             bne ExPGH                   ;eighth frame), and branch if set to leave
0EF12 AA                                tax                         ;initialize X to zero
0EF13 AC E4 06                          ldy Player_SprDataOffset    ;get player sprite data offset
0EF16 A5 33                             lda PlayerFacingDir         ;get player's facing direction
0EF18 4A                                lsr
0EF19 B0 04                             bcs SwimKT                  ;if player facing to the right, use current offset
0EF1B C8                                iny
0EF1C C8                                iny                         ;otherwise move to next OAM data
0EF1D C8                                iny
0EF1E C8                                iny
0EF1F AD 54 07                  SwimKT: lda PlayerSize              ;check player's size
0EF22 F0 09                             beq BigKTS                  ;if big, use first tile
0EF24 B9 19 02                          lda Sprite_Tilenumber+24,y  ;check tile number of seventh/eighth sprite
0EF27 CD B5 EE                          cmp SwimTileRepOffset       ;against tile number in player graphics table
0EF2A F0 07                             beq ExPGH                   ;if spr7/spr8 tile number = value, branch to leave
0EF2C E8                                inx                         ;otherwise increment X for second tile
0EF2D BD E7 EE                  BigKTS: lda SwimKickTileNum,x       ;overwrite tile number in sprite 7/8
