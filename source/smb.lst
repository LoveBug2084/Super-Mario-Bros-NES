0B5CC                           ImposeFriction:
0B5CC 2D 90 04                             and Player_CollisionBits  ;perform AND between left/right controller bits and collision flag
0B5CF C9 00                                cmp #$00                  ;then compare to zero (this instruction is redundant)
0B5D1 D0 08                                bne JoypFrict             ;if any bits set, branch to next part
0B5D3 A5 57                                lda Player_X_Speed
0B5D5 F0 49                                beq SetAbsSpd             ;if player has no horizontal speed, branch ahead to last part
0B5D7 10 23                                bpl RghtFrict             ;if player moving to the right, branch to slow
0B5D9 30 03                                bmi LeftFrict             ;otherwise logic dictates player moving left, branch to slow
0B5DB 4A                        JoypFrict: lsr                       ;put right controller bit into carry
0B5DC 90 1E                                bcc RghtFrict             ;if left button pressed, carry = 0, thus branch
0B5DE AD 05 07                  LeftFrict: lda Player_X_MoveForce    ;load value set here
0B5E1 18                                   clc
0B5E2 6D 02 07                             adc FrictionAdderLow      ;add to it another value set here
0B5E5 8D 05 07                             sta Player_X_MoveForce    ;store here
