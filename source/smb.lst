0E325                           ;$06 - second object's offset
0E325                           ;$07 - counter
0E325                           
0E325                           PlayerCollisionCore:
0E325 A2 00                           ldx #$00     ;initialize X to use player's bounding box for comparison
0E327                           
0E327                           SprObjectCollisionCore:
0E327 84 06                           sty $06      ;save contents of Y here
0E329 A9 01                           lda #$01
0E32B 85 07                           sta $07      ;save value 1 here as counter, compare horizontal coordinates first
0E32D                           
0E32D                           CollisionCoreLoop:
0E32D B9 AC 04                        lda BoundingBox_UL_Corner,y  ;compare left/top coordinates
0E330 DD AC 04                        cmp BoundingBox_UL_Corner,x  ;of first and second objects' bounding boxes
0E333 B0 2A                           bcs FirstBoxGreater          ;if first left/top => second, branch
0E335 DD AE 04                        cmp BoundingBox_LR_Corner,x  ;otherwise compare to right/bottom of second
0E338 90 12                           bcc SecondBoxVerticalChk     ;if first left/top < second right/bottom, branch elsewhere
0E33A F0 42                           beq CollisionFound           ;if somehow equal, collision, thus branch
0E33C B9 AE 04                        lda BoundingBox_LR_Corner,y  ;if somehow greater, check to see if bottom of
0E33F D9 AC 04                        cmp BoundingBox_UL_Corner,y  ;first object's bounding box is greater than its top
0E342 90 3A                           bcc CollisionFound           ;if somehow less, vertical wrap collision, thus branch
0E344 DD AC 04                        cmp BoundingBox_UL_Corner,x  ;otherwise compare bottom of first bounding box to the top
0E347 B0 35                           bcs CollisionFound           ;of second box, and if equal or greater, collision, thus branch
0E349 A4 06                           ldy $06                      ;otherwise return with carry clear and Y = $0006
0E34B 60                              rts                          ;note horizontal wrapping never occurs
0E34C                           
0E34C                           SecondBoxVerticalChk:
0E34C BD AE 04                        lda BoundingBox_LR_Corner,x  ;check to see if the vertical bottom of the box
0E34F DD AC 04                        cmp BoundingBox_UL_Corner,x  ;is greater than the vertical top
0E352 90 2A                           bcc CollisionFound           ;if somehow less, vertical wrap collision, thus branch
0E354 B9 AE 04                        lda BoundingBox_LR_Corner,y  ;otherwise compare horizontal right or vertical bottom
0E357 DD AC 04                        cmp BoundingBox_UL_Corner,x  ;of first box with horizontal left or vertical top of second box
0E35A B0 22                           bcs CollisionFound           ;if equal or greater, collision, thus branch
0E35C A4 06                           ldy $06                      ;otherwise return with carry clear and Y = $0006
0E35E 60                              rts
0E35F                           
0E35F                           FirstBoxGreater:
0E35F DD AC 04                        cmp BoundingBox_UL_Corner,x  ;compare first and second box horizontal left/vertical top again
0E362 F0 1A                           beq CollisionFound           ;if first coordinate = second, collision, thus branch
0E364 DD AE 04                        cmp BoundingBox_LR_Corner,x  ;if not, compare with second object right or bottom edge
0E367 90 15                           bcc CollisionFound           ;if left/top of first less than or equal to right/bottom of second
0E369 F0 13                           beq CollisionFound           ;then collision, thus branch
0E36B D9 AE 04                        cmp BoundingBox_LR_Corner,y  ;otherwise check to see if top of first box is greater than bottom
0E36E 90 0A                           bcc NoCollisionFound         ;if less than or equal, no collision, branch to end
0E370 F0 08                           beq NoCollisionFound
0E372 B9 AE 04                        lda BoundingBox_LR_Corner,y  ;otherwise compare bottom of first to top of second
0E375 DD AC 04                        cmp BoundingBox_UL_Corner,x  ;if bottom of first is greater than top of second, vertical wrap
0E378 B0 04                           bcs CollisionFound           ;collision, and branch, otherwise, proceed onwards here
0E37A                           
0E37A                           NoCollisionFound:
0E37A 18                              clc          ;clear carry, then load value set earlier, then leave
0E37B A4 06                           ldy $06      ;like previous ones, if horizontal coordinates do not collide, we do
0E37D 60                              rts          ;not bother checking vertical ones, because what's the point?
0E37E                           
0E37E                           CollisionFound:
0E37E E8                              inx                    ;increment offsets on both objects to check
0E37F C8                              iny                    ;the vertical coordinates
0E380 C6 07                           dec $07                ;decrement counter to reflect this
0E382 10 A9                           bpl CollisionCoreLoop  ;if counter not expired, branch to loop
0E384 38                              sec                    ;otherwise we already did both sets, therefore collision, so set carry
0E385 A4 06                           ldy $06                ;load original value set here earlier, then leave
0E387 60                              rts
