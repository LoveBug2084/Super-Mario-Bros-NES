0F8C6 6A                                ror            ;save LSB from original byte into carry
0F8C7 8A                                txa            ;reload original byte and rotate three times
0F8C8 2A                                rol            ;turning xx00000x into 00000xxx, with the
0F8C9 2A                                rol            ;bit in carry as the MSB here
0F8CA 2A                                rol
