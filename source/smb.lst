08FCF                           
08FCF                           InitializeGame:
08FCF A0 6F                                  ldy #$6f              ;clear all memory as in initialization procedure,
08FD1 20 CC 90                               jsr InitializeMemory  ;but this time, clear only as far as $076f
08FD4 A0 1F                                  ldy #$1f
08FD6 99 B0 07                  ClrSndLoop:  sta SoundMemory,y     ;clear out memory used
08FD9 88                                     dey                   ;by the sound engines
08FDA 10 FA                                  bpl ClrSndLoop
08FDC A9 18                                  lda #$18              ;set demo timer
08FDE 8D A2 07                               sta DemoTimer
08FE1 20 03 9C                               jsr LoadAreaPointer
08FE4                           
08FE4                           InitializeArea:
08FE4 A0 4B                                    ldy #$4b                 ;clear all memory again, only as far as $074b
08FE6 20 CC 90                                 jsr InitializeMemory     ;this is only necessary if branching from
08FE9 A2 21                                    ldx #$21
08FEB A9 00                                    lda #$00
08FED 9D 80 07                  ClrTimersLoop: sta Timers,x             ;clear out memory between
08FF0 CA                                       dex                      ;$0780 and $07a1
08FF1 10 FA                                    bpl ClrTimersLoop
08FF3 AD 5B 07                                 lda HalfwayPage
08FF6 AC 52 07                                 ldy AltEntranceControl   ;if AltEntranceControl not set, use halfway page, if any found
08FF9 F0 03                                    beq StartPage
08FFB AD 51 07                                 lda EntrancePage         ;otherwise use saved entry page number here
08FFE 8D 1A 07                  StartPage:     sta ScreenLeft_PageLoc   ;set as value here
09001 8D 25 07                                 sta CurrentPageLoc       ;also set as current page
09004 8D 28 07                                 sta BackloadingFlag      ;set flag here if halfway page or saved entry page number found
09007 20 38 B0                                 jsr GetScreenPosition    ;get pixel coordinates for screen borders
0900A A0 20                                    ldy #$20                 ;if on odd numbered page, use $2480 as start of rendering
0900C 29 01                                    and #%00000001           ;otherwise use $2080, this address used later as name table
0900E F0 02                                    beq SetInitNTHigh        ;address for rendering of game area
09010 A0 24                                    ldy #$24
09012 8C 20 07                  SetInitNTHigh: sty CurrentNTAddr_High   ;store name table address
09015 A0 80                                    ldy #$80
09017 8C 21 07                                 sty CurrentNTAddr_Low
0901A 0A                                       asl                      ;store LSB of page number in high nybble
0901B 0A                                       asl                      ;of block buffer column position
0901C 0A                                       asl
0901D 0A                                       asl
0901E 8D A0 06                                 sta BlockBufferColumnPos
09021 CE 30 07                                 dec AreaObjectLength     ;set area object lengths for all empty
09024 CE 31 07                                 dec AreaObjectLength+1
09027 CE 32 07                                 dec AreaObjectLength+2
0902A A9 0B                                    lda #$0b                 ;set value for renderer to update 12 column sets
0902C 8D 1E 07                                 sta ColumnSets           ;12 column sets = 24 metatile columns = 1 1/2 screens
0902F 20 22 9C                                 jsr GetAreaDataAddrs     ;get enemy and level addresses and load header
09032 AD 6A 07                                 lda PrimaryHardMode      ;check to see if primary hard mode has been activated
09035 D0 10                                    bne SetSecHard           ;if so, activate the secondary no matter where we're at
09037 AD 5F 07                                 lda WorldNumber          ;otherwise check world number
0903A C9 04                                    cmp #World5              ;if less than 5, do not activate secondary
0903C 90 0C                                    bcc CheckHalfway
0903E D0 07                                    bne SetSecHard           ;if not equal to, then world > 5, thus activate
09040 AD 5C 07                                 lda LevelNumber          ;otherwise, world 5, so check level number
09043 C9 02                                    cmp #Level3              ;if 1 or 2, do not set secondary hard mode flag
09045 90 03                                    bcc CheckHalfway
09047 EE CC 06                  SetSecHard:    inc SecondaryHardMode    ;set secondary hard mode flag for areas 5-3 and beyond
0904A AD 5B 07                  CheckHalfway:  lda HalfwayPage
0904D F0 05                                    beq DoneInitArea
0904F A9 02                                    lda #$02                 ;if halfway page set, overwrite start position from header
09051 8D 10 07                                 sta PlayerEntranceCtrl
09054 A9 80                     DoneInitArea:  lda #Silence             ;silence music
09056 85 FB                                    sta AreaMusicQueue
09058 A9 01                                    lda #$01                 ;disable screen output
0905A 8D 74 07                                 sta DisableScreenFlag
0905D EE 72 07                                 inc OperMode_Task        ;increment one of the modes
09060 60                                       rts
09061                           
09061                           ;-------------------------------------------------------------------------------------
09061                           
09061                           PrimaryGameSetup:
09061 A9 01                           lda #$01
09063 8D 57 07                        sta FetchNewGameTimerFlag   ;set flag to load game timer from header
09066 8D 54 07                        sta PlayerSize              ;set player's size to small
09069 A9 02                           lda #$02
0906B 8D 5A 07                        sta NumberofLives           ;give each player three lives
0906E 8D 61 07                        sta OffScr_NumberofLives
09071                           
09071                           SecondaryGameSetup:
09071 A9 00                                  lda #$00
09073 8D 74 07                               sta DisableScreenFlag     ;enable screen output
09076 A8                                     tay
09077 99 00 03                  ClearVRLoop: sta VRAM_Buffer1-1,y      ;clear buffer at $0300-$03ff
0907A C8                                     iny
0907B D0 FA                                  bne ClearVRLoop
0907D 8D 59 07                               sta GameTimerExpiredFlag  ;clear game timer exp flag
09080 8D 69 07                               sta DisableIntermediate   ;clear skip lives display flag
09083 8D 28 07                               sta BackloadingFlag       ;clear value here
09086 A9 FF                                  lda #$ff
09088 8D A0 03                               sta BalPlatformAlignment  ;initialize balance platform assignment flag
0908B AD 1A 07                               lda ScreenLeft_PageLoc    ;get left side page location
0908E 4E 78 07                               lsr Mirror_PPU_CTRL_REG1  ;shift LSB of ppu register #1 mirror out
09091 29 01                                  and #$01                  ;mask out all but LSB of page location
09093 6A                                     ror                       ;rotate LSB of page location into carry then onto mirror
09094 2E 78 07                               rol Mirror_PPU_CTRL_REG1  ;this is to set the proper PPU name table
09097 20 ED 90                               jsr GetAreaMusic          ;load proper music into queue
0909A A9 38                                  lda #$38                  ;load sprite shuffle amounts to be used later
0909C 8D E3 06                               sta SprShuffleAmt+2
0909F A9 48                                  lda #$48
090A1 8D E2 06                               sta SprShuffleAmt+1
090A4 A9 58                                  lda #$58
090A6 8D E1 06                               sta SprShuffleAmt
090A9 A2 0E                                  ldx #$0e                  ;load default OAM offsets into $06e4-$06f2
090AB BD BC 8F                  ShufAmtLoop: lda DefaultSprOffsets,x
090AE 9D E4 06                               sta SprDataOffset,x
090B1 CA                                     dex                       ;do this until they're all set
090B2 10 F7                                  bpl ShufAmtLoop
090B4 A0 03                                  ldy #$03                  ;set up sprite #0
090B6 B9 CB 8F                  ISpr0Loop:   lda Sprite0Data,y
090B9 99 00 02                               sta Sprite_Data,y
090BC 88                                     dey
090BD 10 F7                                  bpl ISpr0Loop
090BF 20 AF 92                               jsr DoNothing2            ;these jsrs doesn't do anything useful
090C2 20 AA 92                               jsr DoNothing1
090C5 EE 22 07                               inc Sprite0HitDetectFlag  ;set sprite #0 check flag
090C8 EE 72 07                               inc OperMode_Task         ;increment to next task
090CB 60                                     rts
090CC                           
090CC                           ;-------------------------------------------------------------------------------------
090CC                           
090CC                           ;$06 - RAM address low
090CC                           ;$07 - RAM address high
090CC                           
090CC                           InitializeMemory:
090CC A2 07                                   ldx #$07          ;set initial high byte to $0700-$07ff
090CE A9 00                                   lda #$00          ;set initial low byte to start of page (at $00 of page)
090D0 85 06                                   sta $06
090D2 86 07                     InitPageLoop: stx $07
090D4 E0 01                     InitByteLoop: cpx #$01          ;check to see if we're on the stack ($0100-$01ff)
090D6 D0 04                                   bne InitByte      ;if not, go ahead anyway
090D8 C0 60                                   cpy #$60          ;otherwise, check to see if we're at $0160-$01ff
090DA B0 02                                   bcs SkipByte      ;if so, skip write
090DC 91 06                     InitByte:     sta ($06),y       ;otherwise, initialize byte with current low byte in Y
090DE 88                        SkipByte:     dey
090DF C0 FF                                   cpy #$ff          ;do this until all bytes in page have been erased
090E1 D0 F1                                   bne InitByteLoop
090E3 CA                                      dex               ;go onto the next page
090E4 10 EC                                   bpl InitPageLoop  ;do this until all pages of memory have been erased
090E6 60                                      rts
090E7                           
090E7                           ;-------------------------------------------------------------------------------------
090E7                           
090E7                           MusicSelectData:
090E7 02 01 04 08                     .db WaterMusic, GroundMusic, UndergroundMusic, CastleMusic
090EB 10 20                           .db CloudMusic, PipeIntroMusic
090ED                           
090ED                           GetAreaMusic:
090ED AD 70 07                               lda OperMode           ;if in title screen mode, leave
090F0 F0 23                                  beq ExitGetM
090F2 AD 52 07                               lda AltEntranceControl ;check for specific alternate mode of entry
090F5 C9 02                                  cmp #$02               ;if found, branch without checking starting position
090F7 F0 0D                                  beq ChkAreaType        ;from area object data header
090F9 A0 05                                  ldy #$05               ;select music for pipe intro scene by default
090FB AD 10 07                               lda PlayerEntranceCtrl ;check value from level header for certain values
090FE C9 06                                  cmp #$06
09100 F0 0E                                  beq StoreMusic         ;load music for pipe intro scene if header
09102 C9 07                                  cmp #$07               ;start position either value $06 or $07
09104 F0 0A                                  beq StoreMusic
09106 AC 4E 07                  ChkAreaType: ldy AreaType           ;load area type as offset for music bit
09109 AD 43 07                               lda CloudTypeOverride
0910C F0 02                                  beq StoreMusic         ;check for cloud type override
0910E A0 04                                  ldy #$04               ;select music for cloud type level if found
09110 B9 E7 90                  StoreMusic:  lda MusicSelectData,y  ;otherwise select appropriate music for level type
09113 85 FB                                  sta AreaMusicQueue     ;store in queue and leave
09115 60                        ExitGetM:    rts
