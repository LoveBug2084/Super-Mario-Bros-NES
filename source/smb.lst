0849F                           
0849F                           ;data is used as tiles for numbers
0849F                           ;that appear when you defeat enemies
0849F                           FloateyNumTileData:
0849F FF FF                           .db $ff, $ff ;dummy
084A1 F6 FB                           .db $f6, $fb ; "100"
084A3 F7 FB                           .db $f7, $fb ; "200"
084A5 F8 FB                           .db $f8, $fb ; "400"
084A7 F9 FB                           .db $f9, $fb ; "500"
084A9 FA FB                           .db $fa, $fb ; "800"
084AB F6 50                           .db $f6, $50 ; "1000"
084AD F7 50                           .db $f7, $50 ; "2000"
084AF F8 50                           .db $f8, $50 ; "4000"
084B1 F9 50                           .db $f9, $50 ; "5000"
084B3 FA 50                           .db $fa, $50 ; "8000"
084B5 FD FE                           .db $fd, $fe ; "1-UP"
084B7                           
084B7                           ;high nybble is digit number, low nybble is number to
084B7                           ;add to the digit of the player's score
084B7                           ScoreUpdateData:
084B7 FF                              .db $ff ;dummy
084B8 41 42 44 45 48                  .db $41, $42, $44, $45, $48
084BD 31 32 34 35 38 00               .db $31, $32, $34, $35, $38, $00
084C3                           
084C3                           FloateyNumbersRoutine:
084C3 BD 10 01                                lda FloateyNum_Control,x     ;load control for floatey number
084C6 F0 BE                                   beq EndExitOne               ;if zero, branch to leave
084C8 C9 0B                                   cmp #$0b                     ;if less than $0b, branch
084CA 90 05                                   bcc ChkNumTimer
084CC A9 0B                                   lda #$0b                     ;otherwise set to $0b, thus keeping
084CE 9D 10 01                                sta FloateyNum_Control,x     ;it in range
084D1 A8                        ChkNumTimer:  tay                          ;use as Y
084D2 BD 2C 01                                lda FloateyNum_Timer,x       ;check value here
084D5 D0 04                                   bne DecNumTimer              ;if nonzero, branch ahead
084D7 9D 10 01                                sta FloateyNum_Control,x     ;initialize floatey number control and leave
084DA 60                                      rts
084DB DE 2C 01                  DecNumTimer:  dec FloateyNum_Timer,x       ;decrement value here
084DE C9 2B                                   cmp #$2b                     ;if not reached a certain point, branch  
084E0 D0 1E                                   bne ChkTallEnemy
084E2 C0 0B                                   cpy #$0b                     ;check offset for $0b
084E4 D0 07                                   bne LoadNumTiles             ;branch ahead if not found
084E6 EE 5A 07                                inc NumberofLives            ;give player one extra life (1-up)
084E9 A9 40                                   lda #Sfx_ExtraLife
084EB 85 FE                                   sta Square2SoundQueue        ;and play the 1-up sound
084ED B9 B7 84                  LoadNumTiles: lda ScoreUpdateData,y        ;load point value here
084F0 4A                                      lsr                          ;move high nybble to low
084F1 4A                                      lsr
084F2 4A                                      lsr
084F3 4A                                      lsr
084F4 AA                                      tax                          ;use as X offset, essentially the digit
084F5 B9 B7 84                                lda ScoreUpdateData,y        ;load again and this time
084F8 29 0F                                   and #%00001111               ;mask out the high nybble
084FA 9D 34 01                                sta DigitModifier,x          ;store as amount to add to the digit
084FD 20 27 BC                                jsr AddToScore               ;update the score accordingly
08500 BC E5 06                  ChkTallEnemy: ldy Enemy_SprDataOffset,x    ;get OAM data offset for enemy object
08503 B5 16                                   lda Enemy_ID,x               ;get enemy object identifier
08505 C9 12                                   cmp #Spiny
08507 F0 22                                   beq FloateyPart              ;branch if spiny
08509 C9 0D                                   cmp #PiranhaPlant
0850B F0 1E                                   beq FloateyPart              ;branch if piranha plant
0850D C9 05                                   cmp #HammerBro
0850F F0 12                                   beq GetAltOffset             ;branch elsewhere if hammer bro
08511 C9 0A                                   cmp #GreyCheepCheep
08513 F0 16                                   beq FloateyPart              ;branch if cheep-cheep of either color
08515 C9 0B                                   cmp #RedCheepCheep
08517 F0 12                                   beq FloateyPart
08519 C9 09                                   cmp #TallEnemy
0851B B0 06                                   bcs GetAltOffset             ;branch elsewhere if enemy object => $09
0851D B5 1E                                   lda Enemy_State,x
0851F C9 02                                   cmp #$02                     ;if enemy state defeated or otherwise
08521 B0 08                                   bcs FloateyPart              ;$02 or greater, branch beyond this part
08523 AE EE 03                  GetAltOffset: ldx SprDataOffset_Ctrl       ;load some kind of control bit
08526 BC EC 06                                ldy Alt_SprDataOffset,x      ;get alternate OAM data offset
08529 A6 08                                   ldx ObjectOffset             ;get enemy object offset again
0852B BD 1E 01                  FloateyPart:  lda FloateyNum_Y_Pos,x       ;get vertical coordinate for
0852E C9 18                                   cmp #$18                     ;floatey number, if coordinate in the
08530 90 05                                   bcc SetupNumSpr              ;status bar, branch
08532 E9 01                                   sbc #$01
08534 9D 1E 01                                sta FloateyNum_Y_Pos,x       ;otherwise subtract one and store as new
08537 BD 1E 01                  SetupNumSpr:  lda FloateyNum_Y_Pos,x       ;get vertical coordinate
0853A E9 08                                   sbc #$08                     ;subtract eight and dump into the
0853C 20 C1 E5                                jsr DumpTwoSpr               ;left and right sprite's Y coordinates
0853F BD 17 01                                lda FloateyNum_X_Pos,x       ;get horizontal coordinate
08542 99 03 02                                sta Sprite_X_Position,y      ;store into X coordinate of left sprite
08545 18                                      clc
08546 69 08                                   adc #$08                     ;add eight pixels and store into X
08548 99 07 02                                sta Sprite_X_Position+4,y    ;coordinate of right sprite
0854B A9 02                                   lda #$02
0854D 99 02 02                                sta Sprite_Attributes,y      ;set palette control in attribute bytes
08550 99 06 02                                sta Sprite_Attributes+4,y    ;of left and right sprites
08553 BD 10 01                                lda FloateyNum_Control,x
08556 0A                                      asl                          ;multiply our floatey number control by 2
08557 AA                                      tax                          ;and use as offset for look-up table
08558 BD 9F 84                                lda FloateyNumTileData,x
0855B 99 01 02                                sta Sprite_Tilenumber,y      ;display first half of number of points
0855E BD A0 84                                lda FloateyNumTileData+1,x
08561 99 05 02                                sta Sprite_Tilenumber+4,y    ;display the second half
08564 A6 08                                   ldx ObjectOffset             ;get enemy object offset and leave
08566 60                                      rts
