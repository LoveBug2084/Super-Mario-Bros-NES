0F9B8                           
0F9B8                           ;--------------------------------
0F9B8                           
0F9B8                           ;MUSIC DATA
0F9B8                           ;square 2/triangle format
0F9B8                           ;d7 - length byte flag (0-note, 1-length)
0F9B8                           ;if d7 is set to 0 and d6-d0 is nonzero:
0F9B8                           ;d6-d0 - note offset in frequency look-up table (must be even)
0F9B8                           ;if d7 is set to 1:
0F9B8                           ;d6-d3 - unused
0F9B8                           ;d2-d0 - length offset in length look-up table
0F9B8                           ;value of $00 in square 2 data is used as null terminator, affects all sound channels
0F9B8                           ;value of $00 in triangle data causes routine to skip note
0F9B8                           
0F9B8                           ;square 1 format
0F9B8                           ;d7-d6, d0 - length offset in length look-up table (bit order is d0,d7,d6)
0F9B8                           ;d5-d1 - note offset in frequency look-up table
0F9B8                           ;value of $00 in square 1 data is flag alternate control reg data to be loaded
0F9B8                           
0F9B8                           ;noise format
0F9B8                           ;d7-d6, d0 - length offset in length look-up table (bit order is d0,d7,d6)
0F9B8                           ;d5-d4 - beat type (0 - rest, 1 - short, 2 - strong, 3 - long)
0F9B8                           ;d3-d1 - unused
0F9B8                           ;value of $00 in noise data is used as null terminator, affects only noise
0F9B8                           
0F9B8                           ;all music data is organized into sections (unless otherwise stated):
0F9B8                           ;square 2, square 1, triangle, noise
0F9B8                           
0F9B8                           Star_CloudMData:
