0C0F4 C9 00                               cmp #$00                  ;on solid ground (i.e. not jumping or falling)
0C0F6 D0 1D                               bne WrongChk              ;if not, player fails to pass loop, and loopback
0C0F8 AD 5F 07                            lda WorldNumber           ;are we in world 7? (check performed on correct
