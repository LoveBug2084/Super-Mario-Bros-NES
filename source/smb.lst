0BB05 A6 08                               ldx ObjectOffset           ;reobtain hammer's buffer offset
0BB07 95 64                               sta Misc_X_Speed,x         ;set hammer's horizontal speed
0BB09 D6 2A                     SetHPos:  dec Misc_State,x           ;decrement hammer's state
