0E68B C9 02                              cmp #$02                    ;if 2 or greater, 
0E68D B0 C6                              bcs DrawFloateyNumber_Coin  ;branch to draw floatey number
0E68F B5 DB                              lda Misc_Y_Position,x       ;store vertical coordinate as
0E691 99 00 02                           sta Sprite_Y_Position,y     ;Y coordinate for first sprite
0E694 18                                 clc
0E695 69 08                              adc #$08                    ;add eight pixels
0E697 99 04 02                           sta Sprite_Y_Position+4,y   ;store as Y coordinate for second sprite
0E69A AD B3 03                           lda Misc_Rel_XPos           ;get relative horizontal coordinate
0E69D 99 03 02                           sta Sprite_X_Position,y
0E6A0 99 07 02                           sta Sprite_X_Position+4,y   ;store as X coordinate for first and second sprites
0E6A3 A5 09                              lda FrameCounter            ;get frame counter
0E6A5 4A                                 lsr                         ;divide by 2 to alter every other frame
0E6A6 29 03                              and #%00000011              ;mask out d2-d1
0E6A8 AA                                 tax                         ;use as graphical offset
0E6A9 BD 82 E6                           lda JumpingCoinTiles,x      ;load tile number
0E6AC C8                                 iny                         ;increment OAM data offset to write tile numbers
0E6AD 20 C1 E5                           jsr DumpTwoSpr              ;do sub to dump tile number into both sprites
