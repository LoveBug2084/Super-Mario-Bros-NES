0EFFF A0 06                             ldy #$06              ;load offset for crouching
0F001 AD 14 07                          lda CrouchingFlag     ;get crouching flag
0F004 D0 22                             bne NonAnimatedActs   ;if set, branch to get offset for graphics table
0F006 A0 00                             ldy #$00              ;otherwise load offset for jumping
0F008 4C 28 F0                          jmp NonAnimatedActs   ;go to get offset to graphics table
0F00B                           
0F00B                           ProcOnGroundActs:
0F00B A0 06                             ldy #$06                   ;load offset for crouching
0F00D AD 14 07                          lda CrouchingFlag          ;get crouching flag
0F010 D0 16                             bne NonAnimatedActs        ;if set, branch to get offset for graphics table
0F012 A0 02                             ldy #$02                   ;load offset for standing
0F014 A5 57                             lda Player_X_Speed         ;check player's horizontal speed
0F016 05 0C                             ora Left_Right_Buttons     ;and left/right controller bits
0F018 F0 0E                             beq NonAnimatedActs        ;if no speed or buttons pressed, use standing offset
0F01A AD 00 07                          lda Player_XSpeedAbsolute  ;load walking/running speed
0F01D C9 09                             cmp #$09
