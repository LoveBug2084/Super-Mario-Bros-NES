0EF7A                           PlayerOffscreenChk:
0EF7A AD D0 03                             lda Player_OffscreenBits      ;get player's offscreen bits
0EF7D 4A                                   lsr
0EF7E 4A                                   lsr                           ;move vertical bits to low nybble
0EF7F 4A                                   lsr
0EF80 4A                                   lsr
0EF81 85 00                                sta $00                       ;store here
0EF83 A2 03                                ldx #$03                      ;check all four rows of player sprites
0EF85 AD E4 06                             lda Player_SprDataOffset      ;get player's sprite data offset
0EF88 18                                   clc
0EF89 69 18                                adc #$18                      ;add 24 bytes to start at bottom row
0EF8B A8                                   tay                           ;set as offset here
0EF8C A9 F8                     PROfsLoop: lda #$f8                      ;load offscreen Y coordinate just in case
0EF8E 46 00                                lsr $00                       ;shift bit into carry
0EF90 90 03                                bcc NPROffscr                 ;if bit not set, skip, do not move sprites
0EF92 20 C1 E5                             jsr DumpTwoSpr                ;otherwise dump offscreen Y coordinate into sprite data
0EF95 98                        NPROffscr: tya
0EF96 38                                   sec                           ;subtract eight bytes to do
0EF97 E9 08                                sbc #$08                      ;next row up
0EF99 A8                                   tay
0EF9A CA                                   dex                           ;decrement row counter
0EF9B 10 EF                                bpl PROfsLoop                 ;do this until all sprite rows are checked
0EF9D 60                                   rts                           ;then we are done!
