0C9B0                           MovePodoboo:
0C9B0 BD 96 07                        lda EnemyIntervalTimer,x   ;check enemy timer
0C9B3 D0 16                           bne PdbM                   ;branch to move enemy if not expired
0C9B5 20 F7 C2                        jsr InitPodoboo            ;otherwise set up podoboo again
0C9B8 BD A8 07                        lda PseudoRandomBitReg+1,x ;get part of LSFR
0C9BB 09 80                           ora #%10000000             ;set d7
0C9BD 9D 34 04                        sta Enemy_Y_MoveForce,x    ;store as movement force
0C9C0 29 0F                           and #%00001111             ;mask out high nybble
0C9C2 09 06                           ora #$06                   ;set for at least six intervals
0C9C4 9D 96 07                        sta EnemyIntervalTimer,x   ;store as new enemy timer
0C9C7 A9 F9                           lda #$f9
0C9C9 95 A0                           sta Enemy_Y_Speed,x        ;set vertical speed to move podoboo upwards
0C9CB 4C 92 BF                  PdbM: jmp MoveJ_EnemyVertically  ;branch to impose gravity on podoboo
