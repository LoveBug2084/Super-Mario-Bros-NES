0C9D8                           ProcHammerBro:
0C9D8 B5 1E                            lda Enemy_State,x          ;check hammer bro's enemy state for d5 set
0C9DA 29 20                            and #%00100000
0C9DC F0 03                            beq ChkJH                  ;if not set, go ahead with code
0C9DE 4C E5 CA                         jmp MoveDefeatedEnemy      ;otherwise jump to something else
0C9E1 B5 3C                     ChkJH: lda HammerBroJumpTimer,x   ;check jump timer
0C9E3 F0 2D                            beq HammerBroJumpCode      ;if expired, branch to jump
0C9E5 D6 3C                            dec HammerBroJumpTimer,x   ;otherwise decrement jump timer
0C9E7 AD D1 03                         lda Enemy_OffscreenBits
0C9EA 29 0C                            and #%00001100             ;check offscreen bits
0C9EC D0 6A                            bne MoveHammerBroXDir      ;if hammer bro a little offscreen, skip to movement code
0C9EE BD A2 03                         lda HammerThrowingTimer,x  ;check hammer throwing timer
0C9F1 D0 17                            bne DecHT                  ;if not expired, skip ahead, do not throw hammer
0C9F3 AC CC 06                         ldy SecondaryHardMode      ;otherwise get secondary hard mode flag
0C9F6 B9 CE C9                         lda HammerThrowTmrData,y   ;get timer data using flag as offset
0C9F9 9D A2 03                         sta HammerThrowingTimer,x  ;set as new timer
0C9FC 20 94 BA                         jsr SpawnHammerObj         ;do a sub here to spawn hammer object
0C9FF 90 09                            bcc DecHT                  ;if carry clear, hammer not spawned, skip to decrement timer
0CA01 B5 1E                            lda Enemy_State,x
0CA03 09 08                            ora #%00001000             ;set d3 in enemy state for hammer throw
0CA05 95 1E                            sta Enemy_State,x
0CA07 4C 58 CA                         jmp MoveHammerBroXDir      ;jump to move hammer bro
0CA0A DE A2 03                  DecHT: dec HammerThrowingTimer,x  ;decrement timer
0CA0D 4C 58 CA                         jmp MoveHammerBroXDir      ;jump to move hammer bro
0CA10                           
0CA10                           HammerBroJumpLData:
0CA10 20 37                           .db $20, $37
0CA12                           
0CA12                           HammerBroJumpCode:
0CA12 B5 1E                            lda Enemy_State,x           ;get hammer bro's enemy state
0CA14 29 07                            and #%00000111              ;mask out all but 3 LSB
0CA16 C9 01                            cmp #$01                    ;check for d0 set (for jumping)
0CA18 F0 3E                            beq MoveHammerBroXDir       ;if set, branch ahead to moving code
0CA1A A9 00                            lda #$00                    ;load default value here
0CA1C 85 00                            sta $00                     ;save into temp variable for now
0CA1E A0 FA                            ldy #$fa                    ;set default vertical speed
0CA20 B5 CF                            lda Enemy_Y_Position,x      ;check hammer bro's vertical coordinate
0CA22 30 13                            bmi SetHJ                   ;if on the bottom half of the screen, use current speed
0CA24 A0 FD                            ldy #$fd                    ;otherwise set alternate vertical speed
0CA26 C9 70                            cmp #$70                    ;check to see if hammer bro is above the middle of screen
0CA28 E6 00                            inc $00                     ;increment preset value to $01
0CA2A 90 0B                            bcc SetHJ                   ;if above the middle of the screen, use current speed and $01
0CA2C C6 00                            dec $00                     ;otherwise return value to $00
0CA2E BD A8 07                         lda PseudoRandomBitReg+1,x  ;get part of LSFR, mask out all but LSB
0CA31 29 01                            and #$01
0CA33 D0 02                            bne SetHJ                   ;if d0 of LSFR set, branch and use current speed and $00
0CA35 A0 FA                            ldy #$fa                    ;otherwise reset to default vertical speed
0CA37 94 A0                     SetHJ: sty Enemy_Y_Speed,x         ;set vertical speed for jumping
0CA39 B5 1E                            lda Enemy_State,x           ;set d0 in enemy state for jumping
0CA3B 09 01                            ora #$01
0CA3D 95 1E                            sta Enemy_State,x
0CA3F A5 00                            lda $00                     ;load preset value here to use as bitmask
0CA41 3D A9 07                         and PseudoRandomBitReg+2,x  ;and do bit-wise comparison with part of LSFR
0CA44 A8                               tay                         ;then use as offset
0CA45 AD CC 06                         lda SecondaryHardMode       ;check secondary hard mode flag
0CA48 D0 01                            bne HJump
0CA4A A8                               tay                         ;if secondary hard mode flag clear, set offset to 0
0CA4B B9 10 CA                  HJump: lda HammerBroJumpLData,y    ;get jump length timer data using offset from before
0CA4E 9D 8A 07                         sta EnemyFrameTimer,x       ;save in enemy timer
0CA51 BD A8 07                         lda PseudoRandomBitReg+1,x
0CA54 09 C0                            ora #%11000000              ;get contents of part of LSFR, set d7 and d6, then
0CA56 95 3C                            sta HammerBroJumpTimer,x    ;store in jump timer
0CA58                           
0CA58                           MoveHammerBroXDir:
0CA58 A0 FC                              ldy #$fc                  ;move hammer bro a little to the left
0CA5A A5 09                              lda FrameCounter
0CA5C 29 40                              and #%01000000            ;change hammer bro's direction every 64 frames
0CA5E D0 02                              bne Shimmy
0CA60 A0 04                              ldy #$04                  ;if d6 set in counter, move him a little to the right
0CA62 94 58                     Shimmy:  sty Enemy_X_Speed,x       ;store horizontal speed
0CA64 A0 01                              ldy #$01                  ;set to face right by default
0CA66 20 43 E1                           jsr PlayerEnemyDiff       ;get horizontal difference between player and hammer bro
0CA69 30 0A                              bmi SetShim               ;if enemy to the left of player, skip this part
0CA6B C8                                 iny                       ;set to face left
0CA6C BD 96 07                           lda EnemyIntervalTimer,x  ;check walking timer
0CA6F D0 04                              bne SetShim               ;if not yet expired, skip to set moving direction
0CA71 A9 F8                              lda #$f8
0CA73 95 58                              sta Enemy_X_Speed,x       ;otherwise, make the hammer bro walk left towards player
0CA75 94 46                     SetShim: sty Enemy_MovingDir,x     ;set moving direction
0CA77                           
0CA77                           MoveNormalEnemy:
0CA77 A0 00                            ldy #$00                   ;init Y to leave horizontal movement as-is 
0CA79 B5 1E                            lda Enemy_State,x
0CA7B 29 40                            and #%01000000             ;check enemy state for d6 set, if set skip
0CA7D D0 19                            bne FallE                  ;to move enemy vertically, then horizontally if necessary
0CA7F B5 1E                            lda Enemy_State,x
0CA81 0A                               asl                        ;check enemy state for d7 set
0CA82 B0 30                            bcs SteadM                 ;if set, branch to move enemy horizontally
0CA84 B5 1E                            lda Enemy_State,x
0CA86 29 20                            and #%00100000             ;check enemy state for d5 set
0CA88 D0 5B                            bne MoveDefeatedEnemy      ;if set, branch to move defeated enemy object
0CA8A B5 1E                            lda Enemy_State,x
0CA8C 29 07                            and #%00000111             ;check d2-d0 of enemy state for any set bits
0CA8E F0 24                            beq SteadM                 ;if enemy in normal state, branch to move enemy horizontally
0CA90 C9 05                            cmp #$05
0CA92 F0 04                            beq FallE                  ;if enemy in state used by spiny's egg, go ahead here
0CA94 C9 03                            cmp #$03
0CA96 B0 30                            bcs ReviveStunned          ;if enemy in states $03 or $04, skip ahead to yet another part
0CA98 20 63 BF                  FallE: jsr MoveD_EnemyVertically  ;do a sub here to move enemy downwards
0CA9B A0 00                            ldy #$00
0CA9D B5 1E                            lda Enemy_State,x          ;check for enemy state $02
0CA9F C9 02                            cmp #$02
0CAA1 F0 0C                            beq MEHor                  ;if found, branch to move enemy horizontally
0CAA3 29 40                            and #%01000000             ;check for d6 set
0CAA5 F0 0D                            beq SteadM                 ;if not set, branch to something else
0CAA7 B5 16                            lda Enemy_ID,x
0CAA9 C9 2E                            cmp #PowerUpObject         ;check for power-up object
0CAAB F0 07                            beq SteadM
0CAAD D0 03                            bne SlowM                  ;if any other object where d6 set, jump to set Y
0CAAF 4C 02 BF                  MEHor: jmp MoveEnemyHorizontally  ;jump here to move enemy horizontally for <> $2e and d6 set
0CAB2                           
0CAB2 A0 01                     SlowM:  ldy #$01                  ;if branched here, increment Y to slow horizontal movement
0CAB4 B5 58                     SteadM: lda Enemy_X_Speed,x       ;get current horizontal speed
0CAB6 48                                pha                       ;save to stack
0CAB7 10 02                             bpl AddHS                 ;if not moving or moving right, skip, leave Y alone
0CAB9 C8                                iny
0CABA C8                                iny                       ;otherwise increment Y to next data
0CABB 18                        AddHS:  clc
0CABC 79 D0 C9                          adc XSpeedAdderData,y     ;add value here to slow enemy down if necessary
0CABF 95 58                             sta Enemy_X_Speed,x       ;save as horizontal speed temporarily
0CAC1 20 02 BF                          jsr MoveEnemyHorizontally ;then do a sub to move horizontally
0CAC4 68                                pla
0CAC5 95 58                             sta Enemy_X_Speed,x       ;get old horizontal speed from stack and return to
0CAC7 60                                rts                       ;original memory location, then leave
0CAC8                           
0CAC8                           ReviveStunned:
0CAC8 BD 96 07                           lda EnemyIntervalTimer,x  ;if enemy timer not expired yet,
0CACB D0 1E                              bne ChkKillGoomba         ;skip ahead to something else
0CACD 95 1E                              sta Enemy_State,x         ;otherwise initialize enemy state to normal
0CACF A5 09                              lda FrameCounter
0CAD1 29 01                              and #$01                  ;get d0 of frame counter
0CAD3 A8                                 tay                       ;use as Y and increment for movement direction
0CAD4 C8                                 iny
0CAD5 94 46                              sty Enemy_MovingDir,x     ;store as pseudorandom movement direction
0CAD7 88                                 dey                       ;decrement for use as pointer
0CAD8 AD 6A 07                           lda PrimaryHardMode       ;check primary hard mode flag
0CADB F0 02                              beq SetRSpd               ;if not set, use pointer as-is
0CADD C8                                 iny
0CADE C8                                 iny                       ;otherwise increment 2 bytes to next data
0CADF B9 D4 C9                  SetRSpd: lda RevivedXSpeed,y       ;load and store new horizontal speed
0CAE2 95 58                              sta Enemy_X_Speed,x       ;and leave
0CAE4 60                                 rts
0CAE5                           
0CAE5                           MoveDefeatedEnemy:
0CAE5 20 63 BF                        jsr MoveD_EnemyVertically      ;execute sub to move defeated enemy downwards
0CAE8 4C 02 BF                        jmp MoveEnemyHorizontally      ;now move defeated enemy horizontally
0CAEB                           
0CAEB                           ChkKillGoomba:
0CAEB C9 0E                             cmp #$0e              ;check to see if enemy timer has reached
0CAED D0 09                             bne NKGmba            ;a certain point, and branch to leave if not
0CAEF B5 16                             lda Enemy_ID,x
0CAF1 C9 06                             cmp #Goomba           ;check for goomba object
0CAF3 D0 03                             bne NKGmba            ;branch if not found
0CAF5 20 98 C9                          jsr EraseEnemyObject  ;otherwise, kill this goomba object
0CAF8 60                        NKGmba: rts                   ;leave!
