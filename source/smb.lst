0EFC6 85 05                             sta $05                      ;store it here also
0EFC8 AD B8 03                          lda Player_Rel_YPos
0EFCB 85 02                             sta $02                      ;store player's vertical position
0EFCD A5 33                             lda PlayerFacingDir
0EFCF 85 03                             sta $03                      ;store player's facing direction
