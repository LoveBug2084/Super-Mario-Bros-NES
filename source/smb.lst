08E04                           ;-------------------------------------------------------------------------------------
08E04                           ;$04 - address low to jump address
08E04                           ;$05 - address high to jump address
08E04                           ;$06 - jump address low
08E04                           ;$07 - jump address high
08E04                           
08E04                           JumpEngine:
08E04 0A                               asl          ;shift bit from contents of A
08E05 A8                               tay
08E06 68                               pla          ;pull saved return address from stack
08E07 85 04                            sta $04      ;save to indirect
08E09 68                               pla
08E0A 85 05                            sta $05
08E0C C8                               iny
08E0D B1 04                            lda ($04),y  ;load pointer from indirect
08E0F 85 06                            sta $06      ;note that if an RTS is performed in next routine
08E11 C8                               iny          ;it will return to the execution before the sub
08E12 B1 04                            lda ($04),y  ;that called this routine
08E14 85 07                            sta $07
08E16 6C 06 00                         jmp ($06)    ;jump to the address we loaded
08E19                           
08E19                           ;-------------------------------------------------------------------------------------
08E19                           
08E19                           InitializeNameTables:
08E19 AD 02 20                                lda PPU_STATUS            ;reset flip-flop
08E1C AD 78 07                                lda Mirror_PPU_CTRL_REG1  ;load mirror of ppu reg $2000
08E1F 09 10                                   ora #%00010000            ;set sprites for first 4k and background for second 4k
08E21 29 F0                                   and #%11110000            ;clear rest of lower nybble, leave higher alone
08E23 20 ED 8E                                jsr WritePPUReg1
08E26 A9 24                                   lda #$24                  ;set vram address to start of name table 1
08E28 20 2D 8E                                jsr WriteNTAddr
08E2B A9 20                                   lda #$20                  ;and then set it to name table 0
08E2D 8D 06 20                  WriteNTAddr:  sta PPU_ADDRESS
08E30 A9 00                                   lda #$00
08E32 8D 06 20                                sta PPU_ADDRESS
08E35 A2 04                                   ldx #$04                  ;clear name table with blank tile #24
08E37 A0 C0                                   ldy #$c0
08E39 A9 24                                   lda #$24
08E3B 8D 07 20                  InitNTLoop:   sta PPU_DATA              ;count out exactly 768 tiles
08E3E 88                                      dey
08E3F D0 FA                                   bne InitNTLoop
08E41 CA                                      dex
08E42 D0 F7                                   bne InitNTLoop
08E44 A0 40                                   ldy #64                   ;now to clear the attribute table (with zero this time)
08E46 8A                                      txa
08E47 8D 00 03                                sta VRAM_Buffer1_Offset   ;init vram buffer 1 offset
08E4A 8D 01 03                                sta VRAM_Buffer1          ;init vram buffer 1
08E4D 8D 07 20                  InitATLoop:   sta PPU_DATA
08E50 88                                      dey
08E51 D0 FA                                   bne InitATLoop
08E53 8D 3F 07                                sta HorizontalScroll      ;reset scroll variables
08E56 8D 40 07                                sta VerticalScroll
08E59 4C E6 8E                                jmp InitScroll            ;initialize scroll registers to zero
08E5C                           
08E5C                           ;-------------------------------------------------------------------------------------
08E5C                           ;$00 - temp joypad bit
08E5C                           
08E5C                           ReadJoypads: 
08E5C A9 01                                   lda #$01               ;reset and clear strobe of joypad ports
08E5E 8D 16 40                                sta JOYPAD_PORT
08E61 4A                                      lsr
08E62 AA                                      tax                    ;start with joypad 1's port
08E63 8D 16 40                                sta JOYPAD_PORT
08E66 20 6A 8E                                jsr ReadPortBits
08E69 E8                                      inx                    ;increment for joypad 2's port
08E6A A0 08                     ReadPortBits: ldy #$08
08E6C 48                        PortLoop:     pha                    ;push previous bit onto stack
08E6D BD 16 40                                lda JOYPAD_PORT,x      ;read current bit on joypad port
08E70 85 00                                   sta $00                ;check d1 and d0 of port output
08E72 4A                                      lsr                    ;this is necessary on the old
08E73 05 00                                   ora $00                ;famicom systems in japan
08E75 4A                                      lsr
08E76 68                                      pla                    ;read bits from stack
08E77 2A                                      rol                    ;rotate bit from carry flag
08E78 88                                      dey
08E79 D0 F1                                   bne PortLoop           ;count down bits left
08E7B 9D FC 06                                sta SavedJoypadBits,x  ;save controller status here always
08E7E 48                                      pha
08E7F 29 30                                   and #%00110000         ;check for select or start
08E81 3D 4A 07                                and JoypadBitMask,x    ;if neither saved state nor current state
08E84 F0 07                                   beq Save8Bits          ;have any of these two set, branch
08E86 68                                      pla
08E87 29 CF                                   and #%11001111         ;otherwise store without select
08E89 9D FC 06                                sta SavedJoypadBits,x  ;or start bits and leave
08E8C 60                                      rts
08E8D 68                        Save8Bits:    pla
08E8E 9D 4A 07                                sta JoypadBitMask,x    ;save with all bits in another place and leave
08E91 60                                      rts
08E92                           
08E92                           ;-------------------------------------------------------------------------------------
08E92                           ;$00 - vram buffer address table low
08E92                           ;$01 - vram buffer address table high
08E92                           
08E92                           WriteBufferToScreen:
08E92 8D 06 20                                 sta PPU_ADDRESS           ;store high byte of vram address
08E95 C8                                       iny
08E96 B1 00                                    lda ($00),y               ;load next byte (second)
08E98 8D 06 20                                 sta PPU_ADDRESS           ;store low byte of vram address
08E9B C8                                       iny
08E9C B1 00                                    lda ($00),y               ;load next byte (third)
08E9E 0A                                       asl                       ;shift to left and save in stack
08E9F 48                                       pha
08EA0 AD 78 07                                 lda Mirror_PPU_CTRL_REG1  ;load mirror of $2000,
08EA3 09 04                                    ora #%00000100            ;set ppu to increment by 32 by default
08EA5 B0 02                                    bcs SetupWrites           ;if d7 of third byte was clear, ppu will
08EA7 29 FB                                    and #%11111011            ;only increment by 1
08EA9 20 ED 8E                  SetupWrites:   jsr WritePPUReg1          ;write to register
08EAC 68                                       pla                       ;pull from stack and shift to left again
08EAD 0A                                       asl
08EAE 90 03                                    bcc GetLength             ;if d6 of third byte was clear, do not repeat byte
08EB0 09 02                                    ora #%00000010            ;otherwise set d1 and increment Y
08EB2 C8                                       iny
08EB3 4A                        GetLength:     lsr                       ;shift back to the right to get proper length
08EB4 4A                                       lsr                       ;note that d1 will now be in carry
08EB5 AA                                       tax
08EB6 B0 01                     OutputToVRAM:  bcs RepeatByte            ;if carry set, repeat loading the same byte
08EB8 C8                                       iny                       ;otherwise increment Y to load next byte
08EB9 B1 00                     RepeatByte:    lda ($00),y               ;load more data from buffer and write to vram
08EBB 8D 07 20                                 sta PPU_DATA
08EBE CA                                       dex                       ;done writing?
08EBF D0 F5                                    bne OutputToVRAM
08EC1 38                                       sec          
08EC2 98                                       tya
08EC3 65 00                                    adc $00                   ;add end length plus one to the indirect at $00
08EC5 85 00                                    sta $00                   ;to allow this routine to read another set of updates
08EC7 A9 00                                    lda #$00
08EC9 65 01                                    adc $01
08ECB 85 01                                    sta $01
08ECD A9 3F                                    lda #$3f                  ;sets vram address to $3f00
08ECF 8D 06 20                                 sta PPU_ADDRESS
08ED2 A9 00                                    lda #$00
08ED4 8D 06 20                                 sta PPU_ADDRESS
08ED7 8D 06 20                                 sta PPU_ADDRESS           ;then reinitializes it for some reason
08EDA 8D 06 20                                 sta PPU_ADDRESS
08EDD AE 02 20                  UpdateScreen:  ldx PPU_STATUS            ;reset flip-flop
08EE0 A0 00                                    ldy #$00                  ;load first byte from indirect as a pointer
08EE2 B1 00                                    lda ($00),y  
08EE4 D0 AC                                    bne WriteBufferToScreen   ;if byte is zero we have no further updates to make here
08EE6 8D 05 20                  InitScroll:    sta PPU_SCROLL_REG        ;store contents of A into scroll registers
08EE9 8D 05 20                                 sta PPU_SCROLL_REG        ;and end whatever subroutine led us here
08EEC 60                                       rts
08EED                           
08EED                           ;-------------------------------------------------------------------------------------
08EED                           
08EED                           WritePPUReg1:
08EED 8D 00 20                                 sta PPU_CTRL_REG1         ;write contents of A to PPU register 1
08EF0 8D 78 07                                 sta Mirror_PPU_CTRL_REG1  ;and its mirror
08EF3 60                                       rts
08EF4                           
08EF4                           ;-------------------------------------------------------------------------------------
08EF4                           ;$00 - used to store status bar nybbles
08EF4                           ;$02 - used as temp vram offset
08EF4                           ;$03 - used to store length of status bar number
08EF4                           
08EF4                           ;status bar name table offset and length data
08EF4                           StatusBarData:
08EF4 F0 06                           .db $f0, $06 ; top score display on title screen
08EF6 62 06                           .db $62, $06 ; player score
08EF8 62 06                           .db $62, $06
08EFA 6D 02                           .db $6d, $02 ; coin tally
08EFC 6D 02                           .db $6d, $02
08EFE 7A 03                           .db $7a, $03 ; game timer
08F00                           
08F00                           StatusBarOffset:
08F00 06 0C 12 18 1E 24               .db $06, $0c, $12, $18, $1e, $24
08F06                           
08F06                           PrintStatusBarNumbers:
08F06 85 00                           sta $00            ;store player-specific offset
08F08 20 11 8F                        jsr OutputNumbers  ;use first nybble to print the coin display
08F0B A5 00                           lda $00            ;move high nybble to low
08F0D 4A                              lsr                ;and print to score display
08F0E 4A                              lsr
08F0F 4A                              lsr
08F10 4A                              lsr
08F11                           
08F11                           OutputNumbers:
08F11 18                                     clc                      ;add 1 to low nybble
08F12 69 01                                  adc #$01
08F14 29 0F                                  and #%00001111           ;mask out high nybble
08F16 C9 06                                  cmp #$06
08F18 B0 44                                  bcs ExitOutputN
08F1A 48                                     pha                      ;save incremented value to stack for now and
08F1B 0A                                     asl                      ;shift to left and use as offset
08F1C A8                                     tay
08F1D AE 00 03                               ldx VRAM_Buffer1_Offset  ;get current buffer pointer
08F20 A9 20                                  lda #$20                 ;put at top of screen by default
08F22 C0 00                                  cpy #$00                 ;are we writing top score on title screen?
08F24 D0 02                                  bne SetupNums
08F26 A9 22                                  lda #$22                 ;if so, put further down on the screen
08F28 9D 01 03                  SetupNums:   sta VRAM_Buffer1,x
08F2B B9 F4 8E                               lda StatusBarData,y      ;write low vram address and length of thing
08F2E 9D 02 03                               sta VRAM_Buffer1+1,x     ;we're printing to the buffer
08F31 B9 F5 8E                               lda StatusBarData+1,y
08F34 9D 03 03                               sta VRAM_Buffer1+2,x
08F37 85 03                                  sta $03                  ;save length byte in counter
08F39 86 02                                  stx $02                  ;and buffer pointer elsewhere for now
08F3B 68                                     pla                      ;pull original incremented value from stack
08F3C AA                                     tax
08F3D BD 00 8F                               lda StatusBarOffset,x    ;load offset to value we want to write
08F40 38                                     sec
08F41 F9 F5 8E                               sbc StatusBarData+1,y    ;subtract from length byte we read before
08F44 A8                                     tay                      ;use value as offset to display digits
08F45 A6 02                                  ldx $02
08F47 B9 D7 07                  DigitPLoop:  lda DisplayDigits,y      ;write digits to the buffer
08F4A 9D 04 03                               sta VRAM_Buffer1+3,x    
08F4D E8                                     inx
08F4E C8                                     iny
08F4F C6 03                                  dec $03                  ;do this until all the digits are written
08F51 D0 F4                                  bne DigitPLoop
08F53 A9 00                                  lda #$00                 ;put null terminator at end
08F55 9D 04 03                               sta VRAM_Buffer1+3,x
08F58 E8                                     inx                      ;increment buffer pointer by 3
08F59 E8                                     inx
08F5A E8                                     inx
08F5B 8E 00 03                               stx VRAM_Buffer1_Offset  ;store it in case we want to use it again
08F5E 60                        ExitOutputN: rts
08F5F                           
08F5F                           ;-------------------------------------------------------------------------------------
08F5F                           
08F5F                           DigitsMathRoutine:
08F5F AD 70 07                              lda OperMode              ;check mode of operation
08F62 C9 00                                 cmp #TitleScreenModeValue
08F64 F0 16                                 beq EraseDMods            ;if in title screen mode, branch to lock score
08F66 A2 05                                 ldx #$05
08F68 BD 34 01                  AddModLoop: lda DigitModifier,x       ;load digit amount to increment
08F6B 18                                    clc
08F6C 79 D7 07                              adc DisplayDigits,y       ;add to current digit
08F6F 30 16                                 bmi BorrowOne             ;if result is a negative number, branch to subtract
08F71 C9 0A                                 cmp #10
08F73 B0 19                                 bcs CarryOne              ;if digit greater than $09, branch to add
08F75 99 D7 07                  StoreNewD:  sta DisplayDigits,y       ;store as new score or game timer digit
08F78 88                                    dey                       ;move onto next digits in score or game timer
08F79 CA                                    dex                       ;and digit amounts to increment
08F7A 10 EC                                 bpl AddModLoop            ;loop back if we're not done yet
08F7C A9 00                     EraseDMods: lda #$00                  ;store zero here
08F7E A2 06                                 ldx #$06                  ;start with the last digit
08F80 9D 33 01                  EraseMLoop: sta DigitModifier-1,x     ;initialize the digit amounts to increment
08F83 CA                                    dex
08F84 10 FA                                 bpl EraseMLoop            ;do this until they're all reset, then leave
08F86 60                                    rts
08F87 DE 33 01                  BorrowOne:  dec DigitModifier-1,x     ;decrement the previous digit, then put $09 in
08F8A A9 09                                 lda #$09                  ;the game timer digit we're currently on to "borrow
08F8C D0 E7                                 bne StoreNewD             ;the one", then do an unconditional branch back
08F8E 38                        CarryOne:   sec                       ;subtract ten from our digit to make it a
08F8F E9 0A                                 sbc #10                   ;proper BCD number, then increment the digit
08F91 FE 33 01                              inc DigitModifier-1,x     ;preceding current digit to "carry the one" properly
08F94 4C 75 8F                              jmp StoreNewD             ;go back to just after we branched here
08F97                           
08F97                           ;-------------------------------------------------------------------------------------
08F97                           
08F97                           UpdateTopScore:
08F97 A2 05                           ldx #$05          ;start with mario's score
08F99 20 9E 8F                        jsr TopScoreCheck
08F9C A2 0B                           ldx #$0b          ;now do luigi's score
08F9E                           
08F9E                           TopScoreCheck:
08F9E A0 05                                   ldy #$05                 ;start with the lowest digit
08FA0 38                                      sec           
08FA1 BD DD 07                  GetScoreDiff: lda PlayerScoreDisplay,x ;subtract each player digit from each high score digit
08FA4 F9 D7 07                                sbc TopScoreDisplay,y    ;from lowest to highest, if any top score digit exceeds
08FA7 CA                                      dex                      ;any player digit, borrow will be set until a subsequent
08FA8 88                                      dey                      ;subtraction clears it (player digit is higher than top)
08FA9 10 F6                                   bpl GetScoreDiff      
08FAB 90 0E                                   bcc NoTopSc              ;check to see if borrow is still set, if so, no new high score
08FAD E8                                      inx                      ;increment X and Y once to the start of the score
08FAE C8                                      iny
08FAF BD DD 07                  CopyScore:    lda PlayerScoreDisplay,x ;store player's score digits into high score memory area
08FB2 99 D7 07                                sta TopScoreDisplay,y
08FB5 E8                                      inx
08FB6 C8                                      iny
08FB7 C0 06                                   cpy #$06                 ;do this until we have stored them all
08FB9 90 F4                                   bcc CopyScore
08FBB 60                        NoTopSc:      rts
