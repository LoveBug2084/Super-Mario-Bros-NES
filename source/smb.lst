0831D                           MushroomIconData:
0831D 07 22 49 83 CE 24 24 00         .db $07, $22, $49, $83, $ce, $24, $24, $00
08325                           
08325                           DrawMushroomIcon:
08325 A0 07                                   ldy #$07                ;read eight bytes to be read by transfer routine
08327 B9 1D 83                  IconDataRead: lda MushroomIconData,y  ;note that the default position is set for a
0832A 99 00 03                                sta VRAM_Buffer1-1,y    ;1-player game
0832D 88                                      dey
0832E 10 F7                                   bpl IconDataRead
08330 AD 7A 07                                lda NumberOfPlayers     ;check number of players
08333 F0 0A                                   beq ExitIcon            ;if set to 1-player game, we're done
08335 A9 24                                   lda #$24                ;otherwise, load blank tile in 1-player position
08337 8D 04 03                                sta VRAM_Buffer1+3
0833A A9 CE                                   lda #$ce                ;then load shroom icon tile in 2-player position
0833C 8D 06 03                                sta VRAM_Buffer1+5
0833F 60                        ExitIcon:     rts
