096B7 0D 97                           .dw ScrollLockObject
096B9 0D 97                           .dw ScrollLockObject
096BB 2B 97                           .dw AreaFrenzy            ;flying cheep-cheeps 
096BD 2B 97                           .dw AreaFrenzy            ;bullet bills or swimming cheep-cheeps
096BF 2B 97                           .dw AreaFrenzy            ;stop frenzy
096C1 45 96                           .dw LoopCmdE
