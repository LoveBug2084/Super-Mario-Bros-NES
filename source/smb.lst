0C3CF 10 F9                               bpl ChkNoEn             ;branch until all slots are checked
0C3D1 30 10                               bmi RetEOfs             ;if no empty slots were found, branch to leave
0C3D3 A9 00                     CreateL:  lda #$00                ;initialize enemy state
0C3D5 95 1E                               sta Enemy_State,x
