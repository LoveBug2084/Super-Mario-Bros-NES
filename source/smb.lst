092DB                           IncrementColumnPos:
092DB EE 26 07                             inc CurrentColumnPos     ;increment column where we're at
092DE AD 26 07                             lda CurrentColumnPos
092E1 29 0F                                and #%00001111           ;mask out higher nybble
092E3 D0 06                                bne NoColWrap
092E5 8D 26 07                             sta CurrentColumnPos     ;if no bits left set, wrap back to zero (0-f)
092E8 EE 25 07                             inc CurrentPageLoc       ;and increment page number where we're at
092EB EE A0 06                  NoColWrap: inc BlockBufferColumnPos ;increment column offset where we're at
092EE AD A0 06                             lda BlockBufferColumnPos
092F1 29 1F                                and #%00011111           ;mask out all but 5 LSB (0-1f)
092F3 8D A0 06                             sta BlockBufferColumnPos ;and save
092F6 60                                   rts
