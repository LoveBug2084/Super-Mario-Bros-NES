0EEF1 B0 40                             bcs ExPGH                   ;to leave on every other frame (when d0 is set)
0EEF3 A5 0E                     CntPl:  lda GameEngineSubroutine    ;if executing specific game engine routine,
0EEF5 C9 0B                             cmp #$0b                    ;branch ahead to some other part
0EEF7 F0 47                             beq PlayerKilled
