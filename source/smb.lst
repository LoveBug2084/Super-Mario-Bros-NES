091BD                           
091BD                           ;page numbers are in order from -1 to -4
091BD                           HalfwayPageNybbles:
091BD 56 40                           .db $56, $40
091BF 65 70                           .db $65, $70
091C1 66 40                           .db $66, $40
091C3 66 40                           .db $66, $40
091C5 66 40                           .db $66, $40
091C7 66 60                           .db $66, $60
091C9 65 70                           .db $65, $70
091CB 00 00                           .db $00, $00
091CD                           
091CD                           PlayerLoseLife:
091CD EE 74 07                               inc DisableScreenFlag    ;disable screen and sprite 0 check
091D0 A9 00                                  lda #$00
091D2 8D 22 07                               sta Sprite0HitDetectFlag
091D5 A9 80                                  lda #Silence             ;silence music
091D7 85 FC                                  sta EventMusicQueue
091D9 CE 5A 07                               dec NumberofLives        ;take one life from player
091DC 10 0B                                  bpl StillInGame          ;if player still has lives, branch
091DE A9 00                                  lda #$00
091E0 8D 72 07                               sta OperMode_Task        ;initialize mode task,
091E3 A9 03                                  lda #GameOverModeValue   ;switch to game over mode
091E5 8D 70 07                               sta OperMode             ;and leave
091E8 60                                     rts
091E9 AD 5F 07                  StillInGame: lda WorldNumber          ;multiply world number by 2 and use
091EC 0A                                     asl                      ;as offset
091ED AA                                     tax
091EE AD 5C 07                               lda LevelNumber          ;if in area -3 or -4, increment
091F1 29 02                                  and #$02                 ;offset by one byte, otherwise
091F3 F0 01                                  beq GetHalfway           ;leave offset alone
091F5 E8                                     inx
091F6 BC BD 91                  GetHalfway:  ldy HalfwayPageNybbles,x ;get halfway page number with offset
091F9 AD 5C 07                               lda LevelNumber          ;check area number's LSB
091FC 4A                                     lsr
091FD 98                                     tya                      ;if in area -2 or -4, use lower nybble
091FE B0 04                                  bcs MaskHPNyb
09200 4A                                     lsr                      ;move higher nybble to lower if area
09201 4A                                     lsr                      ;number is -1 or -3
09202 4A                                     lsr
09203 4A                                     lsr
09204 29 0F                     MaskHPNyb:   and #%00001111           ;mask out all but lower nybble
09206 CD 1A 07                               cmp ScreenLeft_PageLoc
09209 F0 04                                  beq SetHalfway           ;left side of screen must be at the halfway page,
0920B 90 02                                  bcc SetHalfway           ;otherwise player must start at the
0920D A9 00                                  lda #$00                 ;beginning of the level
0920F 8D 5B 07                  SetHalfway:  sta HalfwayPage          ;store as halfway page for player
09212 20 82 92                               jsr TransposePlayers     ;switch players around if 2-player game
09215 4C 64 92                               jmp ContinueGame         ;continue the game
09218                           
09218                           ;-------------------------------------------------------------------------------------
09218                           
09218                           GameOverMode:
09218 AD 72 07                        lda OperMode_Task
0921B 20 04 8E                        jsr JumpEngine
0921E                                 
0921E 24 92                           .dw SetupGameOver
09220 67 85                           .dw ScreenRoutines
09222 37 92                           .dw RunGameOver
09224                           
09224                           ;-------------------------------------------------------------------------------------
09224                           
09224                           SetupGameOver:
09224 A9 00                           lda #$00                  ;reset screen routine task control for title screen, game,
09226 8D 3C 07                        sta ScreenRoutineTask     ;and game over modes
09229 8D 22 07                        sta Sprite0HitDetectFlag  ;disable sprite 0 check
0922C A9 02                           lda #GameOverMusic
0922E 85 FC                           sta EventMusicQueue       ;put game over music in secondary queue
09230 EE 74 07                        inc DisableScreenFlag     ;disable screen output
09233 EE 72 07                        inc OperMode_Task         ;set secondary mode to 1
09236 60                              rts
09237                           
09237                           ;-------------------------------------------------------------------------------------
09237                           
09237                           RunGameOver:
09237 A9 00                           lda #$00              ;reenable screen
09239 8D 74 07                        sta DisableScreenFlag
0923C AD FC 06                        lda SavedJoypad1Bits  ;check controller for start pressed
0923F 29 10                           and #Start_Button
09241 D0 05                           bne TerminateGame
09243 AD A0 07                        lda ScreenTimer       ;if not pressed, wait for
09246 D0 39                           bne GameIsOn          ;screen timer to expire
09248                           TerminateGame:
09248 A9 80                           lda #Silence          ;silence music
0924A 85 FC                           sta EventMusicQueue
0924C 20 82 92                        jsr TransposePlayers  ;check if other player can keep
0924F 90 13                           bcc ContinueGame      ;going, and do so if possible
09251 AD 5F 07                        lda WorldNumber       ;otherwise put world number of current
09254 8D FD 07                        sta ContinueWorld     ;player into secret continue function variable
09257 A9 00                           lda #$00
09259 0A                              asl                   ;residual ASL instruction
0925A 8D 72 07                        sta OperMode_Task     ;reset all modes to title screen and
0925D 8D A0 07                        sta ScreenTimer       ;leave
09260 8D 70 07                        sta OperMode
09263 60                              rts
09264                           
09264                           ContinueGame:
09264 20 03 9C                             jsr LoadAreaPointer       ;update level pointer with
09267 A9 01                                lda #$01                  ;actual world and area numbers, then
09269 8D 54 07                             sta PlayerSize            ;reset player's size, status, and
0926C EE 57 07                             inc FetchNewGameTimerFlag ;set game timer flag to reload
0926F A9 00                                lda #$00                  ;game timer from header
09271 8D 47 07                             sta TimerControl          ;also set flag for timers to count again
09274 8D 56 07                             sta PlayerStatus
09277 85 0E                                sta GameEngineSubroutine  ;reset task for game core
09279 8D 72 07                             sta OperMode_Task         ;set modes and leave
0927C A9 01                                lda #$01                  ;if in game over mode, switch back to
0927E 8D 70 07                             sta OperMode              ;game mode, because game is still on
09281 60                        GameIsOn:  rts
09282                           
09282                           TransposePlayers:
09282 38                                   sec                       ;set carry flag by default to end game
09283 AD 7A 07                             lda NumberOfPlayers       ;if only a 1 player game, leave
09286 F0 21                                beq ExTrans
09288 AD 61 07                             lda OffScr_NumberofLives  ;does offscreen player have any lives left?
0928B 30 1C                                bmi ExTrans               ;branch if not
0928D AD 53 07                             lda CurrentPlayer         ;invert bit to update
09290 49 01                                eor #%00000001            ;which player is on the screen
09292 8D 53 07                             sta CurrentPlayer
09295 A2 06                                ldx #$06
09297 BD 5A 07                  TransLoop: lda OnscreenPlayerInfo,x    ;transpose the information
0929A 48                                   pha                         ;of the onscreen player
0929B BD 61 07                             lda OffscreenPlayerInfo,x   ;with that of the offscreen player
0929E 9D 5A 07                             sta OnscreenPlayerInfo,x
092A1 68                                   pla
092A2 9D 61 07                             sta OffscreenPlayerInfo,x
092A5 CA                                   dex
092A6 10 EF                                bpl TransLoop
092A8 18                                   clc            ;clear carry flag to get game going
092A9 60                        ExTrans:   rts
