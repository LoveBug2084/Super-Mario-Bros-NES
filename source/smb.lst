0C4D9 A4 57                              ldy Player_X_Speed         ;check player's horizontal speed
0C4DB F0 07                              beq GSeed                  ;if player not moving left or right, skip this part
0C4DD A9 04                              lda #$04
0C4DF C0 19                              cpy #$19                   ;if moving to the right but not very quickly,
0C4E1 90 01                              bcc GSeed                  ;do not change A
0C4E3 0A                                 asl                        ;otherwise, multiply A by 2
0C4E4 48                        GSeed:   pha                        ;save to stack
0C4E5 18                                 clc
0C4E6 65 00                              adc $00                    ;add to last two bits of LSFR we saved earlier
0C4E8 85 00                              sta $00                    ;save it there
0C4EA BD A8 07                           lda PseudoRandomBitReg+1,x
0C4ED 29 03                              and #%00000011             ;if neither of the last two bits of second LSFR set,
0C4EF F0 07                              beq RSeed                  ;skip this part and save contents of $00
0C4F1 BD A9 07                           lda PseudoRandomBitReg+2,x
0C4F4 29 0F                              and #%00001111             ;otherwise overwrite with lower nybble of
0C4F6 85 00                              sta $00                    ;third LSFR part
0C4F8 68                        RSeed:   pla                        ;get value from stack we saved earlier
0C4F9 18                                 clc
0C4FA 65 01                              adc $01                    ;add to last two bits of LSFR we saved in other place
0C4FC A8                                 tay                        ;use as pseudorandom offset here
0C4FD B9 98 C4                           lda FlyCCXSpeedData,y      ;get horizontal speed using pseudorandom offset
