0AEDB                           ;-------------------------------------------------------------------------------------
0AEDB                           
0AEDB                           ;unused space
0AEDB FF                              .db $ff
0AEDC                           
0AEDC                           ;-------------------------------------------------------------------------------------
0AEDC                           
0AEDC                           ;indirect jump routine called when
0AEDC                           ;$0770 is set to 1
0AEDC                           GameMode:
0AEDC AD 72 07                        lda OperMode_Task
0AEDF 20 04 8E                        jsr JumpEngine
0AEE2                           
0AEE2 E4 8F                           .dw InitializeArea
0AEE4 67 85                           .dw ScreenRoutines
0AEE6 71 90                           .dw SecondaryGameSetup
0AEE8 EA AE                           .dw GameCoreRoutine
0AEEA                           
0AEEA                           ;-------------------------------------------------------------------------------------
0AEEA                           
0AEEA                           GameCoreRoutine:
0AEEA AE 53 07                        ldx CurrentPlayer          ;get which player is on the screen
0AEED BD FC 06                        lda SavedJoypadBits,x      ;use appropriate player's controller bits
0AEF0 8D FC 06                        sta SavedJoypadBits        ;as the master controller bits
0AEF3 20 4A B0                        jsr GameRoutines           ;execute one of many possible subs
0AEF6 AD 72 07                        lda OperMode_Task          ;check major task of operating mode
0AEF9 C9 03                           cmp #$03                   ;if we are supposed to be here,
0AEFB B0 01                           bcs GameEngine             ;branch to the game engine itself
0AEFD 60                              rts
0AEFE                           
0AEFE                           GameEngine:
0AEFE 20 24 B6                                jsr ProcFireball_Bubble    ;process fireballs and air bubbles
0AF01 A2 00                                   ldx #$00
0AF03 86 08                     ProcELoop:    stx ObjectOffset           ;put incremented offset in X as enemy object offset
0AF05 20 47 C0                                jsr EnemiesAndLoopsCore    ;process enemy objects
0AF08 20 C3 84                                jsr FloateyNumbersRoutine  ;process floatey numbers
0AF0B E8                                      inx
0AF0C E0 06                                   cpx #$06                   ;do these two subroutines until the whole buffer is done
0AF0E D0 F3                                   bne ProcELoop
0AF10 20 80 F1                                jsr GetPlayerOffscreenBits ;get offscreen bits for player object
0AF13 20 2A F1                                jsr RelativePlayerPosition ;get relative coordinates for player object
0AF16 20 E9 EE                                jsr PlayerGfxHandler       ;draw the player
0AF19 20 D4 BE                                jsr BlockObjMT_Updater     ;replace block objects with metatiles if necessary
0AF1C A2 01                                   ldx #$01
0AF1E 86 08                                   stx ObjectOffset           ;set offset for second
0AF20 20 70 BE                                jsr BlockObjectsCore       ;process second block object
0AF23 CA                                      dex
0AF24 86 08                                   stx ObjectOffset           ;set offset for first
0AF26 20 70 BE                                jsr BlockObjectsCore       ;process first block object
0AF29 20 96 BB                                jsr MiscObjectsCore        ;process misc objects (hammer, jumping coins)
0AF2C 20 BC B9                                jsr ProcessCannons         ;process bullet bill cannons
0AF2F 20 B8 B7                                jsr ProcessWhirlpools      ;process whirlpools
0AF32 20 55 B8                                jsr FlagpoleRoutine        ;process the flagpole
0AF35 20 4F B7                                jsr RunGameTimer           ;count down the game timer
0AF38 20 E1 89                                jsr ColorRotation          ;cycle one of the background colors
0AF3B A5 B5                                   lda Player_Y_HighPos
0AF3D C9 02                                   cmp #$02                   ;if player is below the screen, don't bother with the music
0AF3F 10 11                                   bpl NoChgMus
0AF41 AD 9F 07                                lda StarInvincibleTimer    ;if star mario invincibility timer at zero,
0AF44 F0 1E                                   beq ClrPlrPal              ;skip this part
0AF46 C9 04                                   cmp #$04
0AF48 D0 08                                   bne NoChgMus               ;if not yet at a certain point, continue
0AF4A AD 7F 07                                lda IntervalTimerControl   ;if interval timer not yet expired,
0AF4D D0 03                                   bne NoChgMus               ;branch ahead, don't bother with the music
0AF4F 20 ED 90                                jsr GetAreaMusic           ;to re-attain appropriate level music
0AF52 AC 9F 07                  NoChgMus:     ldy StarInvincibleTimer    ;get invincibility timer
0AF55 A5 09                                   lda FrameCounter           ;get frame counter
0AF57 C0 08                                   cpy #$08                   ;if timer still above certain point,
0AF59 B0 02                                   bcs CycleTwo               ;branch to cycle player's palette quickly
0AF5B 4A                                      lsr                        ;otherwise, divide by 8 to cycle every eighth frame
0AF5C 4A                                      lsr
0AF5D 4A                        CycleTwo:     lsr                        ;if branched here, divide by 2 to cycle every other frame
0AF5E 20 88 B2                                jsr CyclePlayerPalette     ;do sub to cycle the palette (note: shares fire flower code)
0AF61 4C 67 AF                                jmp SaveAB                 ;then skip this sub to finish up the game engine
0AF64 20 9A B2                  ClrPlrPal:    jsr ResetPalStar           ;do sub to clear player's palette bits in attributes
0AF67 A5 0A                     SaveAB:       lda A_B_Buttons            ;save current A and B button
0AF69 85 0D                                   sta PreviousA_B_Buttons    ;into temp variable to be used on next frame
0AF6B A9 00                                   lda #$00
0AF6D 85 0C                                   sta Left_Right_Buttons     ;nullify left and right buttons temp variable
0AF6F AD 73 07                  UpdScrollVar: lda VRAM_Buffer_AddrCtrl
0AF72 C9 06                                   cmp #$06                   ;if vram address controller set to 6 (one of two $0341s)
0AF74 F0 1C                                   beq ExitEng                ;then branch to leave
0AF76 AD 1F 07                                lda AreaParserTaskNum      ;otherwise check number of tasks
0AF79 D0 14                                   bne RunParser
0AF7B AD 3D 07                                lda ScrollThirtyTwo        ;get horizontal scroll in 0-31 or $00-$20 range
0AF7E C9 20                                   cmp #$20                   ;check to see if exceeded $21
0AF80 30 10                                   bmi ExitEng                ;branch to leave if not
0AF82 AD 3D 07                                lda ScrollThirtyTwo
0AF85 E9 20                                   sbc #$20                   ;otherwise subtract $20 to set appropriately
0AF87 8D 3D 07                                sta ScrollThirtyTwo        ;and store
0AF8A A9 00                                   lda #$00                   ;reset vram buffer offset used in conjunction with
0AF8C 8D 40 03                                sta VRAM_Buffer2_Offset    ;level graphics buffer at $0341-$035f
0AF8F 20 B0 92                  RunParser:    jsr AreaParserTaskHandler  ;update the name table with more level graphics
0AF92 60                        ExitEng:      rts                        ;and after all that, we're finally done!
0AF93                           
0AF93                           ;-------------------------------------------------------------------------------------
0AF93                           
0AF93                           ScrollHandler:
0AF93 AD FF 06                              lda Player_X_Scroll       ;load value saved here
0AF96 18                                    clc
0AF97 6D A1 03                              adc Platform_X_Scroll     ;add value used by left/right platforms
0AF9A 8D FF 06                              sta Player_X_Scroll       ;save as new value here to impose force on scroll
0AF9D AD 23 07                              lda ScrollLock            ;check scroll lock flag
0AFA0 D0 59                                 bne InitScrlAmt           ;skip a bunch of code here if set
0AFA2 AD 55 07                              lda Player_Pos_ForScroll
0AFA5 C9 50                                 cmp #$50                  ;check player's horizontal screen position
0AFA7 90 52                                 bcc InitScrlAmt           ;if less than 80 pixels to the right, branch
0AFA9 AD 85 07                              lda SideCollisionTimer    ;if timer related to player's side collision
0AFAC D0 4D                                 bne InitScrlAmt           ;not expired, branch
0AFAE AC FF 06                              ldy Player_X_Scroll       ;get value and decrement by one
0AFB1 88                                    dey                       ;if value originally set to zero or otherwise
0AFB2 30 47                                 bmi InitScrlAmt           ;negative for left movement, branch
0AFB4 C8                                    iny
0AFB5 C0 02                                 cpy #$02                  ;if value $01, branch and do not decrement
0AFB7 90 01                                 bcc ChkNearMid
0AFB9 88                                    dey                       ;otherwise decrement by one
0AFBA AD 55 07                  ChkNearMid: lda Player_Pos_ForScroll
0AFBD C9 70                                 cmp #$70                  ;check player's horizontal screen position
0AFBF 90 03                                 bcc ScrollScreen          ;if less than 112 pixels to the right, branch
0AFC1 AC FF 06                              ldy Player_X_Scroll       ;otherwise get original value undecremented
0AFC4                           
0AFC4                           ScrollScreen:
0AFC4 98                                      tya
0AFC5 8D 75 07                                sta ScrollAmount          ;save value here
0AFC8 18                                      clc
0AFC9 6D 3D 07                                adc ScrollThirtyTwo       ;add to value already set here
0AFCC 8D 3D 07                                sta ScrollThirtyTwo       ;save as new value here
0AFCF 98                                      tya
0AFD0 18                                      clc
0AFD1 6D 1C 07                                adc ScreenLeft_X_Pos      ;add to left side coordinate
0AFD4 8D 1C 07                                sta ScreenLeft_X_Pos      ;save as new left side coordinate
0AFD7 8D 3F 07                                sta HorizontalScroll      ;save here also
0AFDA AD 1A 07                                lda ScreenLeft_PageLoc
0AFDD 69 00                                   adc #$00                  ;add carry to page location for left
0AFDF 8D 1A 07                                sta ScreenLeft_PageLoc    ;side of the screen
0AFE2 29 01                                   and #$01                  ;get LSB of page location
0AFE4 85 00                                   sta $00                   ;save as temp variable for PPU register 1 mirror
0AFE6 AD 78 07                                lda Mirror_PPU_CTRL_REG1  ;get PPU register 1 mirror
0AFE9 29 FE                                   and #%11111110            ;save all bits except d0
0AFEB 05 00                                   ora $00                   ;get saved bit here and save in PPU register 1
