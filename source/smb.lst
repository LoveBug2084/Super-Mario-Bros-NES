0E2F7 B9 AE 04                         lda BoundingBox_DR_XPos,y  ;check right-side edge of bounding box for offscreen
0E2FA 30 0D                            bmi NoOfs                  ;coordinates, branch if still on the screen
0E2FC A9 FF                            lda #$ff                   ;load offscreen value here to use on one or both horizontal sides
0E2FE BE AC 04                         ldx BoundingBox_UL_XPos,y  ;check left-side edge of bounding box for offscreen
