0E6CE                           PowerUpAttributes:
0E6CE 02 01 02 01                     .db $02, $01, $02, $01
0E6D2                           
0E6D2                           DrawPowerUp:
0E6D2 AC EA 06                        ldy Enemy_SprDataOffset+5  ;get power-up's sprite data offset
0E6D5 AD B9 03                        lda Enemy_Rel_YPos         ;get relative vertical coordinate
0E6D8 18                              clc
0E6D9 69 08                           adc #$08                   ;add eight pixels
0E6DB 85 02                           sta $02                    ;store result here
0E6DD AD AE 03                        lda Enemy_Rel_XPos         ;get relative horizontal coordinate
0E6E0 85 05                           sta $05                    ;store here
0E6E2 A6 39                           ldx PowerUpType            ;get power-up type
0E6E4 BD CE E6                        lda PowerUpAttributes,x    ;get attribute data for power-up type
0E6E7 0D CA 03                        ora Enemy_SprAttrib+5      ;add background priority bit if set
0E6EA 85 04                           sta $04                    ;store attributes here
0E6EC 8A                              txa
0E6ED 48                              pha                        ;save power-up type to the stack
0E6EE 0A                              asl
0E6EF 0A                              asl                        ;multiply by four to get proper offset
0E6F0 AA                              tax                        ;use as X
0E6F1 A9 01                           lda #$01
0E6F3 85 07                           sta $07                    ;set counter here to draw two rows of sprite object
0E6F5 85 03                           sta $03                    ;init d1 of flip control
0E6F7                           
0E6F7                           PUpDrawLoop:
0E6F7 BD BE E6                          lda PowerUpGfxTable,x      ;load left tile of power-up object
0E6FA 85 00                             sta $00
0E6FC BD BF E6                          lda PowerUpGfxTable+1,x    ;load right tile
0E6FF 20 B2 EB                          jsr DrawOneSpriteRow       ;branch to draw one row of our power-up object
0E702 C6 07                             dec $07                    ;decrement counter
0E704 10 F1                             bpl PUpDrawLoop            ;branch until two rows are drawn
0E706 AC EA 06                          ldy Enemy_SprDataOffset+5  ;get sprite data offset again
0E709 68                                pla                        ;pull saved power-up type from the stack
0E70A F0 2F                             beq PUpOfs                 ;if regular mushroom, branch, do not change colors or flip
0E70C C9 03                             cmp #$03
0E70E F0 2B                             beq PUpOfs                 ;if 1-up mushroom, branch, do not change colors or flip
0E710 85 00                             sta $00                    ;store power-up type here now
0E712 A5 09                             lda FrameCounter           ;get frame counter
0E714 4A                                lsr                        ;divide by 2 to change colors every two frames
0E715 29 03                             and #%00000011             ;mask out all but d1 and d0 (previously d2 and d1)
0E717 0D CA 03                          ora Enemy_SprAttrib+5      ;add background priority bit if any set
0E71A 99 02 02                          sta Sprite_Attributes,y    ;set as new palette bits for top left and
0E71D 99 06 02                          sta Sprite_Attributes+4,y  ;top right sprites for fire flower and star
0E720 A6 00                             ldx $00
0E722 CA                                dex                        ;check power-up type for fire flower
0E723 F0 06                             beq FlipPUpRightSide       ;if found, skip this part
0E725 99 0A 02                          sta Sprite_Attributes+8,y  ;otherwise set new palette bits  for bottom left
0E728 99 0E 02                          sta Sprite_Attributes+12,y ;and bottom right sprites as well for star only
0E72B                           
0E72B                           FlipPUpRightSide:
0E72B B9 06 02                          lda Sprite_Attributes+4,y
0E72E 09 40                             ora #%01000000             ;set horizontal flip bit for top right sprite
0E730 99 06 02                          sta Sprite_Attributes+4,y
0E733 B9 0E 02                          lda Sprite_Attributes+12,y
0E736 09 40                             ora #%01000000             ;set horizontal flip bit for bottom right sprite
0E738 99 0E 02                          sta Sprite_Attributes+12,y ;note these are only done for fire flower and star power-ups
0E73B 4C 64 EB                  PUpOfs: jmp SprObjectOffscrChk     ;jump to check to see if power-up is offscreen at all, then leave
