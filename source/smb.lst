08567                           
08567                           ScreenRoutines:
08567 AD 3C 07                        lda ScreenRoutineTask        ;run one of the following subroutines
0856A 20 04 8E                        jsr JumpEngine
0856D                               
0856D 8B 85                           .dw InitScreen
0856F 9B 85                           .dw SetupIntermediate
08571 52 86                           .dw WriteTopStatusLine
08573 5A 86                           .dw WriteBottomStatusLine
08575 93 86                           .dw DisplayTimeUp
08577 9D 88                           .dw ResetSpritesAndScreenTimer
08579 A8 86                           .dw DisplayIntermediate
0857B 9D 88                           .dw ResetSpritesAndScreenTimer
0857D E6 86                           .dw AreaParserTaskControl
0857F BF 85                           .dw GetAreaPalette
08581 E3 85                           .dw GetBackgroundColor
08583 43 86                           .dw GetAlternatePalette1
08585 FF 86                           .dw DrawTitleScreen
08587 32 87                           .dw ClearBuffersDrawIcon
08589 49 87                           .dw WriteTopScore
0858B                           
0858B                           ;-------------------------------------------------------------------------------------
0858B                           
0858B                           InitScreen:
0858B 20 20 82                        jsr MoveAllSpritesOffscreen ;initialize all sprites including sprite #0
0858E 20 19 8E                        jsr InitializeNameTables    ;and erase both name and attribute tables
08591 AD 70 07                        lda OperMode
08594 F0 32                           beq NextSubtask             ;if mode still 0, do not load
08596 A2 03                           ldx #$03                    ;into buffer pointer
08598 4C C5 85                        jmp SetVRAMAddr_A
0859B                           
0859B                           ;-------------------------------------------------------------------------------------
0859B                           
0859B                           SetupIntermediate:
0859B AD 44 07                        lda BackgroundColorCtrl  ;save current background color control
0859E 48                              pha                      ;and player status to stack
0859F AD 56 07                        lda PlayerStatus
085A2 48                              pha
085A3 A9 00                           lda #$00                 ;set background color to black
085A5 8D 56 07                        sta PlayerStatus         ;and player status to not fiery
085A8 A9 02                           lda #$02                 ;this is the ONLY time background color control
085AA 8D 44 07                        sta BackgroundColorCtrl  ;is set to less than 4
085AD 20 F1 85                        jsr GetPlayerColors
085B0 68                              pla                      ;we only execute this routine for
085B1 8D 56 07                        sta PlayerStatus         ;the intermediate lives display
085B4 68                              pla                      ;and once we're done, we return bg
085B5 8D 44 07                        sta BackgroundColorCtrl  ;color ctrl and player status from stack
085B8 4C 45 87                        jmp IncSubtask           ;then move onto the next task
085BB                           
085BB                           ;-------------------------------------------------------------------------------------
085BB                           
085BB                           AreaPalette:
085BB 01 02 03 04                     .db $01, $02, $03, $04
085BF                           
085BF                           GetAreaPalette:
085BF AC 4E 07                                 ldy AreaType             ;select appropriate palette to load
085C2 BE BB 85                                 ldx AreaPalette,y        ;based on area type
085C5 8E 73 07                  SetVRAMAddr_A: stx VRAM_Buffer_AddrCtrl ;store offset into buffer control
085C8 4C 45 87                  NextSubtask:   jmp IncSubtask           ;move onto next task
085CB                           
085CB                           ;-------------------------------------------------------------------------------------
085CB                           ;$00 - used as temp counter in GetPlayerColors
085CB                           
085CB                           BGColorCtrl_Addr:
085CB 00 09 0A 04                     .db $00, $09, $0a, $04
085CF                           
085CF                           BackgroundColors:
085CF 22 22 0F 0F                     .db $22, $22, $0f, $0f ;used by area type if bg color ctrl not set
085D3 0F 22 0F 0F                     .db $0f, $22, $0f, $0f ;used by background color control if set
085D7                           
085D7                           PlayerColors:
085D7 22 16 27 18                     .db $22, $16, $27, $18 ;mario's colors
085DB 22 30 27 19                     .db $22, $30, $27, $19 ;luigi's colors
085DF 22 37 27 16                     .db $22, $37, $27, $16 ;fiery (used by both)
085E3                           
085E3                           GetBackgroundColor:
085E3 AC 44 07                             ldy BackgroundColorCtrl   ;check background color control
085E6 F0 06                                beq NoBGColor             ;if not set, increment task and fetch palette
085E8 B9 C7 85                             lda BGColorCtrl_Addr-4,y  ;put appropriate palette into vram
085EB 8D 73 07                             sta VRAM_Buffer_AddrCtrl  ;note that if set to 5-7, $0301 will not be read
085EE EE 3C 07                  NoBGColor: inc ScreenRoutineTask     ;increment to next subtask and plod on through
085F1                                 
085F1                           GetPlayerColors:
085F1 AE 00 03                                 ldx VRAM_Buffer1_Offset  ;get current buffer offset
085F4 A0 00                                    ldy #$00
085F6 AD 53 07                                 lda CurrentPlayer        ;check which player is on the screen
085F9 F0 02                                    beq ChkFiery
085FB A0 04                                    ldy #$04                 ;load offset for luigi
085FD AD 56 07                  ChkFiery:      lda PlayerStatus         ;check player status
08600 C9 02                                    cmp #$02
08602 D0 02                                    bne StartClrGet          ;if fiery, load alternate offset for fiery player
08604 A0 08                                    ldy #$08
08606 A9 03                     StartClrGet:   lda #$03                 ;do four colors
08608 85 00                                    sta $00
0860A B9 D7 85                  ClrGetLoop:    lda PlayerColors,y       ;fetch player colors and store them
0860D 9D 04 03                                 sta VRAM_Buffer1+3,x     ;in the buffer
08610 C8                                       iny
08611 E8                                       inx
08612 C6 00                                    dec $00
08614 10 F4                                    bpl ClrGetLoop
08616 AE 00 03                                 ldx VRAM_Buffer1_Offset  ;load original offset from before
08619 AC 44 07                                 ldy BackgroundColorCtrl  ;if this value is four or greater, it will be set
0861C D0 03                                    bne SetBGColor           ;therefore use it as offset to background color
0861E AC 4E 07                                 ldy AreaType             ;otherwise use area type bits from area offset as offset
08621 B9 CF 85                  SetBGColor:    lda BackgroundColors,y   ;to background color instead
08624 9D 04 03                                 sta VRAM_Buffer1+3,x
08627 A9 3F                                    lda #$3f                 ;set for sprite palette address
08629 9D 01 03                                 sta VRAM_Buffer1,x       ;save to buffer
0862C A9 10                                    lda #$10
0862E 9D 02 03                                 sta VRAM_Buffer1+1,x
08631 A9 04                                    lda #$04                 ;write length byte to buffer
08633 9D 03 03                                 sta VRAM_Buffer1+2,x
08636 A9 00                                    lda #$00                 ;now the null terminator
08638 9D 08 03                                 sta VRAM_Buffer1+7,x
0863B 8A                                       txa                      ;move the buffer pointer ahead 7 bytes
0863C 18                                       clc                      ;in case we want to write anything else later
0863D 69 07                                    adc #$07
0863F 8D 00 03                  SetVRAMOffset: sta VRAM_Buffer1_Offset  ;store as new vram buffer offset
08642 60                                       rts
08643                           
08643                           ;-------------------------------------------------------------------------------------
08643                           
08643                           GetAlternatePalette1:
08643 AD 33 07                                 lda AreaStyle            ;check for mushroom level style
08646 C9 01                                    cmp #$01
08648 D0 05                                    bne NoAltPal
0864A A9 0B                                    lda #$0b                 ;if found, load appropriate palette
0864C 8D 73 07                  SetVRAMAddr_B: sta VRAM_Buffer_AddrCtrl
0864F 4C 45 87                  NoAltPal:      jmp IncSubtask           ;now onto the next task
08652                           
08652                           ;-------------------------------------------------------------------------------------
08652                           
08652                           WriteTopStatusLine:
08652 A9 00                           lda #$00          ;select main status bar
08654 20 08 88                        jsr WriteGameText ;output it
08657 4C 45 87                        jmp IncSubtask    ;onto the next task
0865A                           
0865A                           ;-------------------------------------------------------------------------------------
0865A                           
0865A                           WriteBottomStatusLine:
0865A 20 30 BC                        jsr GetSBNybbles        ;write player's score and coin tally to screen
0865D AE 00 03                        ldx VRAM_Buffer1_Offset
08660 A9 20                           lda #$20                ;write address for world-area number on screen
08662 9D 01 03                        sta VRAM_Buffer1,x
08665 A9 73                           lda #$73
08667 9D 02 03                        sta VRAM_Buffer1+1,x
0866A A9 03                           lda #$03                ;write length for it
0866C 9D 03 03                        sta VRAM_Buffer1+2,x
0866F AC 5F 07                        ldy WorldNumber         ;first the world number
08672 C8                              iny
08673 98                              tya
08674 9D 04 03                        sta VRAM_Buffer1+3,x
08677 A9 28                           lda #$28                ;next the dash
08679 9D 05 03                        sta VRAM_Buffer1+4,x
0867C AC 5C 07                        ldy LevelNumber         ;next the level number
0867F C8                              iny                     ;increment for proper number display
08680 98                              tya
08681 9D 06 03                        sta VRAM_Buffer1+5,x    
08684 A9 00                           lda #$00                ;put null terminator on
08686 9D 07 03                        sta VRAM_Buffer1+6,x
08689 8A                              txa                     ;move the buffer offset up by 6 bytes
0868A 18                              clc
0868B 69 06                           adc #$06
0868D 8D 00 03                        sta VRAM_Buffer1_Offset
08690 4C 45 87                        jmp IncSubtask
08693                           
08693                           ;-------------------------------------------------------------------------------------
08693                           
08693                           DisplayTimeUp:
08693 AD 59 07                            lda GameTimerExpiredFlag  ;if game timer not expired, increment task
08696 F0 0A                               beq NoTimeUp              ;control 2 tasks forward, otherwise, stay here
08698 A9 00                               lda #$00
0869A 8D 59 07                            sta GameTimerExpiredFlag  ;reset timer expiration flag
0869D A9 02                               lda #$02                  ;output time-up screen to buffer
0869F 4C C7 86                            jmp OutputInter
086A2 EE 3C 07                  NoTimeUp: inc ScreenRoutineTask     ;increment control task 2 tasks forward
086A5 4C 45 87                            jmp IncSubtask
086A8                           
086A8                           ;-------------------------------------------------------------------------------------
086A8                           
086A8                           DisplayIntermediate:
086A8 AD 70 07                                 lda OperMode                 ;check primary mode of operation
086AB F0 33                                    beq NoInter                  ;if in title screen mode, skip this
086AD C9 03                                    cmp #GameOverModeValue       ;are we in game over mode?
086AF F0 22                                    beq GameOverInter            ;if so, proceed to display game over screen
086B1 AD 52 07                                 lda AltEntranceControl       ;otherwise check for mode of alternate entry
086B4 D0 2A                                    bne NoInter                  ;and branch if found
086B6 AC 4E 07                                 ldy AreaType                 ;check if we are on castle level
086B9 C0 03                                    cpy #$03                     ;and if so, branch (possibly residual)
086BB F0 05                                    beq PlayerInter
086BD AD 69 07                                 lda DisableIntermediate      ;if this flag is set, skip intermediate lives display
086C0 D0 1E                                    bne NoInter                  ;and jump to specific task, otherwise
086C2 20 A4 EF                  PlayerInter:   jsr DrawPlayer_Intermediate  ;put player in appropriate place for
086C5 A9 01                                    lda #$01                     ;lives display, then output lives display to buffer
086C7 20 08 88                  OutputInter:   jsr WriteGameText
086CA 20 A5 88                                 jsr ResetScreenTimer
086CD A9 00                                    lda #$00
086CF 8D 74 07                                 sta DisableScreenFlag        ;reenable screen output
086D2 60                                       rts
086D3 A9 12                     GameOverInter: lda #$12                     ;set screen timer
086D5 8D A0 07                                 sta ScreenTimer
086D8 A9 03                                    lda #$03                     ;output game over screen to buffer
086DA 20 08 88                                 jsr WriteGameText
086DD 4C 4E 87                                 jmp IncModeTask_B
086E0 A9 08                     NoInter:       lda #$08                     ;set for specific task and leave
086E2 8D 3C 07                                 sta ScreenRoutineTask
086E5 60                                       rts
086E6                           
086E6                           ;-------------------------------------------------------------------------------------
086E6                           
086E6                           AreaParserTaskControl:
086E6 EE 74 07                             inc DisableScreenFlag     ;turn off screen
086E9 20 B0 92                  TaskLoop:  jsr AreaParserTaskHandler ;render column set of current area
086EC AD 1F 07                             lda AreaParserTaskNum     ;check number of tasks
086EF D0 F8                                bne TaskLoop              ;if tasks still not all done, do another one
086F1 CE 1E 07                             dec ColumnSets            ;do we need to render more column sets?
086F4 10 03                                bpl OutputCol
086F6 EE 3C 07                             inc ScreenRoutineTask     ;if not, move on to the next task
086F9 A9 06                     OutputCol: lda #$06                  ;set vram buffer to output rendered column set
086FB 8D 73 07                             sta VRAM_Buffer_AddrCtrl  ;on next NMI
086FE 60                                   rts
086FF                           
086FF                           ;-------------------------------------------------------------------------------------
086FF                           
086FF                           ;$00 - vram buffer address table low
086FF                           ;$01 - vram buffer address table high
086FF                           
086FF                           DrawTitleScreen:
086FF AD 70 07                              lda OperMode                 ;are we in title screen mode?
08702 D0 4A                                 bne IncModeTask_B            ;if not, exit
08704 A9 1E                                 lda #>TitleScreenDataOffset  ;load address $1ec0 into
08706 8D 06 20                              sta PPU_ADDRESS              ;the vram address register
08709 A9 C0                                 lda #<TitleScreenDataOffset
0870B 8D 06 20                              sta PPU_ADDRESS
0870E A9 03                                 lda #$03                     ;put address $0300 into
08710 85 01                                 sta $01                      ;the indirect at $00
08712 A0 00                                 ldy #$00
08714 84 00                                 sty $00
08716 AD 07 20                              lda PPU_DATA                 ;do one garbage read
08719 AD 07 20                  OutputTScr: lda PPU_DATA                 ;get title screen from chr-rom
0871C 91 00                                 sta ($00),y                  ;store 256 bytes into buffer
0871E C8                                    iny
0871F D0 02                                 bne ChkHiByte                ;if not past 256 bytes, do not increment
08721 E6 01                                 inc $01                      ;otherwise increment high byte of indirect
08723 A5 01                     ChkHiByte:  lda $01                      ;check high byte?
08725 C9 04                                 cmp #$04                     ;at $0400?
08727 D0 F0                                 bne OutputTScr               ;if not, loop back and do another
08729 C0 3A                                 cpy #$3a                     ;check if offset points past end of data
0872B 90 EC                                 bcc OutputTScr               ;if not, loop back and do another
0872D A9 05                                 lda #$05                     ;set buffer transfer control to $0300,
0872F 4C 4C 86                              jmp SetVRAMAddr_B            ;increment task and exit
08732                           
08732                           ;-------------------------------------------------------------------------------------
08732                           
08732                           ClearBuffersDrawIcon:
08732 AD 70 07                               lda OperMode               ;check game mode
08735 D0 17                                  bne IncModeTask_B          ;if not title screen mode, leave
08737 A2 00                                  ldx #$00                   ;otherwise, clear buffer space
08739 9D 00 03                  TScrClear:   sta VRAM_Buffer1-1,x
0873C 9D 00 04                               sta VRAM_Buffer1-1+$100,x
0873F CA                                     dex
08740 D0 F7                                  bne TScrClear
08742 20 25 83                               jsr DrawMushroomIcon       ;draw player select icon
08745 EE 3C 07                  IncSubtask:  inc ScreenRoutineTask      ;move onto next task
08748 60                                     rts
08749                           
08749                           ;-------------------------------------------------------------------------------------
08749                           
08749                           WriteTopScore:
08749 A9 FA                                    lda #$fa           ;run display routine to display top score on title
0874B 20 36 BC                                 jsr UpdateNumber
0874E EE 72 07                  IncModeTask_B: inc OperMode_Task  ;move onto next mode
08751 60                                       rts
