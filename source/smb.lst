0E6BE                           ;$00-$01 - used to hold tiles for drawing the power-up, $00 also used to hold power-up type
0E6BE                           ;$02 - used to hold bottom row Y position
0E6BE                           ;$03 - used to hold flip control (not used here)
0E6BE                           ;$04 - used to hold sprite attributes
0E6BE                           ;$05 - used to hold X position
0E6BE                           ;$07 - counter
0E6BE                           
0E6BE                           ;tiles arranged in top left, right, bottom left, right order
0E6BE                           PowerUpGfxTable:
0E6BE 76 77 78 79                     .db $76, $77, $78, $79 ;regular mushroom
0E6C2 D6 D6 D9 D9                     .db $d6, $d6, $d9, $d9 ;fire flower
0E6C6 8D 8D E4 E4                     .db $8d, $8d, $e4, $e4 ;star
0E6CA 76 77 78 79                     .db $76, $77, $78, $79 ;1-up mushroom
