0E5C8                           DrawLargePlatform:
0E5C8 BC E5 06                        ldy Enemy_SprDataOffset,x   ;get OAM data offset
0E5CB 84 02                           sty $02                     ;store here
0E5CD C8                              iny                         ;add 3 to it for offset
0E5CE C8                              iny                         ;to X coordinate
0E5CF C8                              iny
0E5D0 AD AE 03                        lda Enemy_Rel_XPos          ;get horizontal relative coordinate
0E5D3 20 AE E4                        jsr SixSpriteStacker        ;store X coordinates using A as base, stack horizontally
0E5D6 A6 08                           ldx ObjectOffset
0E5D8 B5 CF                           lda Enemy_Y_Position,x      ;get vertical coordinate
0E5DA 20 BB E5                        jsr DumpFourSpr             ;dump into first four sprites as Y coordinate
0E5DD AC 4E 07                        ldy AreaType
0E5E0 C0 03                           cpy #$03                    ;check for castle-type level
0E5E2 F0 05                           beq ShrinkPlatform
0E5E4 AC CC 06                        ldy SecondaryHardMode       ;check for secondary hard mode flag set
0E5E7 F0 02                           beq SetLast2Platform        ;branch if not set elsewhere
0E5E9                           
0E5E9                           ShrinkPlatform:
0E5E9 A9 F8                           lda #$f8                    ;load offscreen coordinate if flag set or castle-type level
0E5EB                           
0E5EB                           SetLast2Platform:
