08000                           
08000                           ;-------------------------------------------------------------------------------------
08000                           
08000                           Start:
08000 78                                     sei                          ;pretty standard 6502 type init here
08001 D8                                     cld
08002 A9 10                                  lda #%00010000               ;init PPU control register 1 
08004 8D 00 20                               sta PPU_CTRL_REG1
08007 A2 FF                                  ldx #$ff                     ;reset stack pointer
08009 9A                                     txs
0800A AD 02 20                  VBlank1:     lda PPU_STATUS               ;wait two frames
0800D 10 FB                                  bpl VBlank1
0800F AD 02 20                  VBlank2:     lda PPU_STATUS
08012 10 FB                                  bpl VBlank2
08014 A0 FE                                  ldy #ColdBootOffset          ;load default cold boot pointer
08016 A2 05                                  ldx #$05                     ;this is where we check for a warm boot
08018 BD D7 07                  WBootCheck:  lda TopScoreDisplay,x        ;check each score digit in the top score
0801B C9 0A                                  cmp #10                      ;to see if we have a valid digit
0801D B0 0C                                  bcs ColdBoot                 ;if not, give up and proceed with cold boot
0801F CA                                     dex                      
08020 10 F6                                  bpl WBootCheck
08022 AD FF 07                               lda WarmBootValidation       ;second checkpoint, check to see if 
08025 C9 A5                                  cmp #$a5                     ;another location has a specific value
08027 D0 02                                  bne ColdBoot   
08029 A0 D6                                  ldy #WarmBootOffset          ;if passed both, load warm boot pointer
0802B 20 CC 90                  ColdBoot:    jsr InitializeMemory         ;clear memory using pointer in Y
0802E 8D 11 40                               sta SND_DELTA_REG+1          ;reset delta counter load register
08031 8D 70 07                               sta OperMode                 ;reset primary mode of operation
08034 A9 A5                                  lda #$a5                     ;set warm boot flag
08036 8D FF 07                               sta WarmBootValidation     
08039 8D A7 07                               sta PseudoRandomBitReg       ;set seed for pseudorandom register
0803C A9 0F                                  lda #%00001111
0803E 8D 15 40                               sta SND_MASTERCTRL_REG       ;enable all sound channels except dmc
08041 A9 06                                  lda #%00000110
08043 8D 01 20                               sta PPU_CTRL_REG2            ;turn off clipping for OAM and background
08046 20 20 82                               jsr MoveAllSpritesOffscreen
08049 20 19 8E                               jsr InitializeNameTables     ;initialize both name tables
0804C EE 74 07                               inc DisableScreenFlag        ;set flag to disable screen output
0804F AD 78 07                               lda Mirror_PPU_CTRL_REG1
08052 09 80                                  ora #%10000000               ;enable NMIs
08054 20 ED 8E                               jsr WritePPUReg1
08057 4C 57 80                  EndlessLoop: jmp EndlessLoop              ;endless loop, need I say more?
0805A                           
0805A                           ;-------------------------------------------------------------------------------------
0805A                           ;$00 - vram buffer address table low, also used for pseudorandom bit
0805A                           ;$01 - vram buffer address table high
0805A                           
0805A                           VRAM_AddrTable_Low:
0805A 01 A4 C8                        .db <VRAM_Buffer1, <WaterPaletteData, <GroundPaletteData
0805D EC 10 00                        .db <UndergroundPaletteData, <CastlePaletteData, <VRAM_Buffer1_Offset
08060 41 41 4C                        .db <VRAM_Buffer2, <VRAM_Buffer2, <BowserPaletteData
08063 34 3C 44                        .db <DaySnowPaletteData, <NightSnowPaletteData, <MushroomPaletteData
08066 54 68 7C                        .db <MarioThanksMessage, <LuigiThanksMessage, <MushroomRetainerSaved
08069 A8 BF DE                        .db <PrincessSaved1, <PrincessSaved2, <WorldSelectMessage1
0806C EF                              .db <WorldSelectMessage2
0806D                           
0806D                           VRAM_AddrTable_High:
0806D 03 8C 8C                        .db >VRAM_Buffer1, >WaterPaletteData, >GroundPaletteData
08070 8C 8D 03                        .db >UndergroundPaletteData, >CastlePaletteData, >VRAM_Buffer1_Offset
08073 03 03 8D                        .db >VRAM_Buffer2, >VRAM_Buffer2, >BowserPaletteData
08076 8D 8D 8D                        .db >DaySnowPaletteData, >NightSnowPaletteData, >MushroomPaletteData
08079 8D 8D 8D                        .db >MarioThanksMessage, >LuigiThanksMessage, >MushroomRetainerSaved
0807C 8D 8D 8D                        .db >PrincessSaved1, >PrincessSaved2, >WorldSelectMessage1
0807F 8D                              .db >WorldSelectMessage2
08080                           
08080                           VRAM_Buffer_Offset:
08080 00 40                           .db <VRAM_Buffer1_Offset, <VRAM_Buffer2_Offset
08082                           
08082                           NonMaskableInterrupt:
08082 AD 78 07                                 lda Mirror_PPU_CTRL_REG1  ;disable NMIs in mirror reg
08085 29 7F                                    and #%01111111            ;save all other bits
08087 8D 78 07                                 sta Mirror_PPU_CTRL_REG1
0808A 29 7E                                    and #%01111110            ;alter name table address to be $2800
0808C 8D 00 20                                 sta PPU_CTRL_REG1         ;(essentially $2000) but save other bits
0808F AD 79 07                                 lda Mirror_PPU_CTRL_REG2  ;disable OAM and background display by default
08092 29 E6                                    and #%11100110
08094 AC 74 07                                 ldy DisableScreenFlag     ;get screen disable flag
08097 D0 05                                    bne ScreenOff             ;if set, used bits as-is
08099 AD 79 07                                 lda Mirror_PPU_CTRL_REG2  ;otherwise reenable bits and save them
0809C 09 1E                                    ora #%00011110
0809E 8D 79 07                  ScreenOff:     sta Mirror_PPU_CTRL_REG2  ;save bits for later but not in register at the moment
080A1 29 E7                                    and #%11100111            ;disable screen for now
080A3 8D 01 20                                 sta PPU_CTRL_REG2
080A6 AE 02 20                                 ldx PPU_STATUS            ;reset flip-flop and reset scroll registers to zero
080A9 A9 00                                    lda #$00
080AB 20 E6 8E                                 jsr InitScroll
080AE 8D 03 20                                 sta PPU_SPR_ADDR          ;reset spr-ram address register
080B1 A9 02                                    lda #$02                  ;perform spr-ram DMA access on $0200-$02ff
080B3 8D 14 40                                 sta SPR_DMA
080B6 AE 73 07                                 ldx VRAM_Buffer_AddrCtrl  ;load control for pointer to buffer contents
080B9 BD 5A 80                                 lda VRAM_AddrTable_Low,x  ;set indirect at $00 to pointer
080BC 85 00                                    sta $00
080BE BD 6D 80                                 lda VRAM_AddrTable_High,x
080C1 85 01                                    sta $01
080C3 20 DD 8E                                 jsr UpdateScreen          ;update screen with buffer contents
080C6 A0 00                                    ldy #$00
080C8 AE 73 07                                 ldx VRAM_Buffer_AddrCtrl  ;check for usage of $0341
080CB E0 06                                    cpx #$06
080CD D0 01                                    bne InitBuffer
080CF C8                                       iny                       ;get offset based on usage
080D0 BE 80 80                  InitBuffer:    ldx VRAM_Buffer_Offset,y
080D3 A9 00                                    lda #$00                  ;clear buffer header at last location
080D5 9D 00 03                                 sta VRAM_Buffer1_Offset,x        
080D8 9D 01 03                                 sta VRAM_Buffer1,x
080DB 8D 73 07                                 sta VRAM_Buffer_AddrCtrl  ;reinit address control to $0301
080DE AD 79 07                                 lda Mirror_PPU_CTRL_REG2  ;copy mirror of $2001 to register
080E1 8D 01 20                                 sta PPU_CTRL_REG2
080E4 20 D0 F2                                 jsr SoundEngine           ;play sound
080E7 20 5C 8E                                 jsr ReadJoypads           ;read joypads
080EA 20 82 81                                 jsr PauseRoutine          ;handle pause
080ED 20 97 8F                                 jsr UpdateTopScore
080F0 AD 76 07                                 lda GamePauseStatus       ;check for pause status
080F3 4A                                       lsr
080F4 B0 25                                    bcs PauseSkip
080F6 AD 47 07                                 lda TimerControl          ;if master timer control not set, decrement
080F9 F0 05                                    beq DecTimers             ;all frame and interval timers
080FB CE 47 07                                 dec TimerControl
080FE D0 19                                    bne NoDecTimers
08100 A2 14                     DecTimers:     ldx #$14                  ;load end offset for end of frame timers
08102 CE 7F 07                                 dec IntervalTimerControl  ;decrement interval timer control,
08105 10 07                                    bpl DecTimersLoop         ;if not expired, only frame timers will decrement
08107 A9 14                                    lda #$14
08109 8D 7F 07                                 sta IntervalTimerControl  ;if control for interval timers expired,
0810C A2 23                                    ldx #$23                  ;interval timers will decrement along with frame timers
0810E BD 80 07                  DecTimersLoop: lda Timers,x              ;check current timer
08111 F0 03                                    beq SkipExpTimer          ;if current timer expired, branch to skip,
08113 DE 80 07                                 dec Timers,x              ;otherwise decrement the current timer
08116 CA                        SkipExpTimer:  dex                       ;move onto next timer
08117 10 F5                                    bpl DecTimersLoop         ;do this until all timers are dealt with
08119 E6 09                     NoDecTimers:   inc FrameCounter          ;increment frame counter
0811B A2 00                     PauseSkip:     ldx #$00
0811D A0 07                                    ldy #$07
0811F AD A7 07                                 lda PseudoRandomBitReg    ;get first memory location of LSFR bytes
08122 29 02                                    and #%00000010            ;mask out all but d1
08124 85 00                                    sta $00                   ;save here
08126 AD A8 07                                 lda PseudoRandomBitReg+1  ;get second memory location
08129 29 02                                    and #%00000010            ;mask out all but d1
0812B 45 00                                    eor $00                   ;perform exclusive-OR on d1 from first and second bytes
0812D 18                                       clc                       ;if neither or both are set, carry will be clear
0812E F0 01                                    beq RotPRandomBit
08130 38                                       sec                       ;if one or the other is set, carry will be set
08131 7E A7 07                  RotPRandomBit: ror PseudoRandomBitReg,x  ;rotate carry into d7, and rotate last bit into carry
08134 E8                                       inx                       ;increment to next byte
08135 88                                       dey                       ;decrement for loop
08136 D0 F9                                    bne RotPRandomBit
08138 AD 22 07                                 lda Sprite0HitDetectFlag  ;check for flag here
0813B F0 1F                                    beq SkipSprite0
0813D AD 02 20                  Sprite0Clr:    lda PPU_STATUS            ;wait for sprite 0 flag to clear, which will
08140 29 40                                    and #%01000000            ;not happen until vblank has ended
08142 D0 F9                                    bne Sprite0Clr
08144 AD 76 07                                 lda GamePauseStatus       ;if in pause mode, do not bother with sprites at all
08147 4A                                       lsr
08148 B0 06                                    bcs Sprite0Hit
0814A 20 23 82                                 jsr MoveSpritesOffscreen
0814D 20 C6 81                                 jsr SpriteShuffler
08150 AD 02 20                  Sprite0Hit:    lda PPU_STATUS            ;do sprite #0 hit detection
08153 29 40                                    and #%01000000
08155 F0 F9                                    beq Sprite0Hit
08157 A0 14                                    ldy #$14                  ;small delay, to wait until we hit horizontal blank time
08159 88                        HBlankDelay:   dey
0815A D0 FD                                    bne HBlankDelay
0815C AD 3F 07                  SkipSprite0:   lda HorizontalScroll      ;set scroll registers from variables
0815F 8D 05 20                                 sta PPU_SCROLL_REG
08162 AD 40 07                                 lda VerticalScroll
08165 8D 05 20                                 sta PPU_SCROLL_REG
08168 AD 78 07                                 lda Mirror_PPU_CTRL_REG1  ;load saved mirror of $2000
0816B 48                                       pha
0816C 8D 00 20                                 sta PPU_CTRL_REG1
0816F AD 76 07                                 lda GamePauseStatus       ;if in pause mode, do not perform operation mode stuff
08172 4A                                       lsr
08173 B0 03                                    bcs SkipMainOper
08175 20 12 82                                 jsr OperModeExecutionTree ;otherwise do one of many, many possible subroutines
08178 AD 02 20                  SkipMainOper:  lda PPU_STATUS            ;reset flip-flop
0817B 68                                       pla
0817C 09 80                                    ora #%10000000            ;reactivate NMIs
0817E 8D 00 20                                 sta PPU_CTRL_REG1
08181 40                                       rti                       ;we are done until the next frame!
08182                           
08182                           ;-------------------------------------------------------------------------------------
08182                           
08182                           PauseRoutine:
08182 AD 70 07                                 lda OperMode           ;are we in victory mode?
08185 C9 02                                    cmp #VictoryModeValue  ;if so, go ahead
08187 F0 0B                                    beq ChkPauseTimer
08189 C9 01                                    cmp #GameModeValue     ;are we in game mode?
0818B D0 38                                    bne ExitPause          ;if not, leave
0818D AD 72 07                                 lda OperMode_Task      ;if we are in game mode, are we running game engine?
08190 C9 03                                    cmp #$03
08192 D0 31                                    bne ExitPause          ;if not, leave
08194 AD 77 07                  ChkPauseTimer: lda GamePauseTimer     ;check if pause timer is still counting down
08197 F0 04                                    beq ChkStart
08199 CE 77 07                                 dec GamePauseTimer     ;if so, decrement and leave
0819C 60                                       rts
0819D AD FC 06                  ChkStart:      lda SavedJoypad1Bits   ;check to see if start is pressed
081A0 29 10                                    and #Start_Button      ;on controller 1
081A2 F0 19                                    beq ClrPauseTimer
081A4 AD 76 07                                 lda GamePauseStatus    ;check to see if timer flag is set
081A7 29 80                                    and #%10000000         ;and if so, do not reset timer (residual,
081A9 D0 1A                                    bne ExitPause          ;joypad reading routine makes this unnecessary)
081AB A9 2B                                    lda #$2b               ;set pause timer
081AD 8D 77 07                                 sta GamePauseTimer
081B0 AD 76 07                                 lda GamePauseStatus
081B3 A8                                       tay
081B4 C8                                       iny                    ;set pause sfx queue for next pause mode
081B5 84 FA                                    sty PauseSoundQueue
081B7 49 01                                    eor #%00000001         ;invert d0 and set d7
081B9 09 80                                    ora #%10000000
081BB D0 05                                    bne SetPause           ;unconditional branch
081BD AD 76 07                  ClrPauseTimer: lda GamePauseStatus    ;clear timer flag if timer is at zero and start button
081C0 29 7F                                    and #%01111111         ;is not pressed
081C2 8D 76 07                  SetPause:      sta GamePauseStatus
081C5 60                        ExitPause:     rts
081C6                           
081C6                           ;-------------------------------------------------------------------------------------
081C6                           ;$00 - used for preset value
081C6                           
081C6                           SpriteShuffler:
081C6 AC 4E 07                                 ldy AreaType                ;load level type, likely residual code
081C9 A9 28                                    lda #$28                    ;load preset value which will put it at
081CB 85 00                                    sta $00                     ;sprite #10
081CD A2 0E                                    ldx #$0e                    ;start at the end of OAM data offsets
081CF BD E4 06                  ShuffleLoop:   lda SprDataOffset,x         ;check for offset value against
081D2 C5 00                                    cmp $00                     ;the preset value
081D4 90 0F                                    bcc NextSprOffset           ;if less, skip this part
081D6 AC E0 06                                 ldy SprShuffleAmtOffset     ;get current offset to preset value we want to add
081D9 18                                       clc
081DA 79 E1 06                                 adc SprShuffleAmt,y         ;get shuffle amount, add to current sprite offset
081DD 90 03                                    bcc StrSprOffset            ;if not exceeded $ff, skip second add
081DF 18                                       clc
081E0 65 00                                    adc $00                     ;otherwise add preset value $28 to offset
081E2 9D E4 06                  StrSprOffset:  sta SprDataOffset,x         ;store new offset here or old one if branched to here
081E5 CA                        NextSprOffset: dex                         ;move backwards to next one
081E6 10 E7                                    bpl ShuffleLoop
081E8 AE E0 06                                 ldx SprShuffleAmtOffset     ;load offset
081EB E8                                       inx
081EC E0 03                                    cpx #$03                    ;check if offset + 1 goes to 3
081EE D0 02                                    bne SetAmtOffset            ;if offset + 1 not 3, store
081F0 A2 00                                    ldx #$00                    ;otherwise, init to 0
081F2 8E E0 06                  SetAmtOffset:  stx SprShuffleAmtOffset
081F5 A2 08                                    ldx #$08                    ;load offsets for values and storage
081F7 A0 02                                    ldy #$02
081F9 B9 E9 06                  SetMiscOffset: lda SprDataOffset+5,y       ;load one of three OAM data offsets
081FC 9D F1 06                                 sta Misc_SprDataOffset-2,x  ;store first one unmodified, but
081FF 18                                       clc                         ;add eight to the second and eight
08200 69 08                                    adc #$08                    ;more to the third one
08202 9D F2 06                                 sta Misc_SprDataOffset-1,x  ;note that due to the way X is set up,
08205 18                                       clc                         ;this code loads into the misc sprite offsets
08206 69 08                                    adc #$08
08208 9D F3 06                                 sta Misc_SprDataOffset,x        
0820B CA                                       dex
0820C CA                                       dex
0820D CA                                       dex
0820E 88                                       dey
0820F 10 E8                                    bpl SetMiscOffset           ;do this until all misc spr offsets are loaded
08211 60                                       rts
08212                           
08212                           ;-------------------------------------------------------------------------------------
08212                           
08212                           OperModeExecutionTree:
08212 AD 70 07                        lda OperMode     ;this is the heart of the entire program,
08215 20 04 8E                        jsr JumpEngine   ;most of what goes on starts here
08218                           
08218 31 82                           .dw TitleScreenMode
0821A DC AE                           .dw GameMode
0821C 8B 83                           .dw VictoryMode
0821E 18 92                           .dw GameOverMode
08220                           
08220                           ;-------------------------------------------------------------------------------------
08220                           
08220                           MoveAllSpritesOffscreen:
08220 A0 00                                   ldy #$00                ;this routine moves all sprites off the screen
08222 2C                                      .db $2c                 ;BIT instruction opcode
08223                           
08223                           MoveSpritesOffscreen:
08223 A0 04                                   ldy #$04                ;this routine moves all but sprite 0
08225 A9 F8                                   lda #$f8                ;off the screen
08227 99 00 02                  SprInitLoop:  sta Sprite_Y_Position,y ;write 248 into OAM data's Y coordinate
0822A C8                                      iny                     ;which will move it off the screen
0822B C8                                      iny
0822C C8                                      iny
0822D C8                                      iny
0822E D0 F7                                   bne SprInitLoop
08230 60                                      rts
